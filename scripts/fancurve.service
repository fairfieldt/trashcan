[Unit]
Description=Mac Pro main fan: full speed while the GPUs work, slower when idle and cool
# The fan files are in this directory before Linux 7.3 and under its hwmon/ from 7.3 (fancurve.sh handles both).
ConditionPathExists=/sys/devices/platform/applesmc.768

[Service]
ExecStart=/usr/local/sbin/fancurve.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
