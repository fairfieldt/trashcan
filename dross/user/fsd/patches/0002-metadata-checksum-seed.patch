+uint32_t ext4_sb_metadata_csum_seed(struct ext4_sblock *s)
+{
+	if (ext4_get32(s, features_incompatible) & EXT4_FINCOM_CSUM_SEED)
+		return ext4_get32(s, checksum_seed);
+	return ext4_crc32c(EXT4_CRC32_INIT, s->uuid, sizeof(s->uuid));
+}
