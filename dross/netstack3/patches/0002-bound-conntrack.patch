     #[ip_test(I)]
+    fn table_size_limit_mixed_self_and_normal<I: IpExt + TestIpExt>() {
+        let mut bindings_ctx = FakeBindingsCtx::<I>::new();
+        let table = Table::<I, (), _>::new::<IntoCoreTimerCtx>(&mut bindings_ctx);
+        for i in 0..MAXIMUM_ENTRIES {
+            let port = u16::try_from(i + 1).unwrap();
+            let packet = PacketMetadata::<I>::new(
+                I::SRC_IP, I::SRC_IP,
+                TransportPacketData::Udp { src_port: port, dst_port: port },
+            );
+            let (connection, _) = table
+                .get_connection_for_packet_and_update(&bindings_ctx, packet)
+                .unwrap().unwrap();
+            table.finalize_connection(&mut bindings_ctx, connection).unwrap();
+        }
+        assert_eq!(table.inner.lock().table.len(), MAXIMUM_ENTRIES);
+        bindings_ctx.sleep(CONNECTION_EXPIRY_TIME_UDP);
+        for i in 0..u32::try_from(MAXIMUM_ENTRIES).unwrap() {
+            let (packet, _) = make_test_udp_packets::<I>(i);
+            let (connection, _) = table
+                .get_connection_for_packet_and_update(&bindings_ctx, packet.conntrack_packet().unwrap())
+                .unwrap().unwrap();
+            table.finalize_connection(&mut bindings_ctx, connection).unwrap();
+            let entries = table.inner.lock().table.len();
+            assert!(entries <= MAXIMUM_ENTRIES, "mixed flow table grew to {entries}");
+        }
+    }
+
