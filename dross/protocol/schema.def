# Oscar draft public service schema. IDs are fixed; incompatible changes bump major.
PROTOCOL BOOTSTRAP 0x3254424f 2
PROTOCOL DIRECTORY 0x5249444f 1
PROTOCOL PROVIDER 0x5652504f 1
PROTOCOL ECHO 0x4f484345 1
KIND REQUEST 1
KIND REPLY 2
KIND EVENT 3
ORDINAL BOOTSTRAP START 1
ORDINAL DIRECTORY DESCRIBE 0
ORDINAL DIRECTORY CONNECT 1
ORDINAL DIRECTORY DELEGATE 2
ORDINAL DIRECTORY LIST 3
ORDINAL DIRECTORY REGISTER 4
ORDINAL PROVIDER OFFER 1
ORDINAL ECHO ECHO 1
STATUS OK 0
STATUS UNSUPPORTED -1
STATUS DENIED -2
STATUS UNAVAILABLE -3
STATUS LIMIT -4
STATUS MALFORMED -5
STATUS CANCELED -6
STATUS BAD_STATE -7
STATUS TIMED_OUT -8
LIMIT HEADER_BYTES 32
LIMIT MESSAGE_BYTES 65536
LIMIT HANDLES 64
LIMIT NAME_BYTES 64
LIMIT VALUE_BYTES 1024
LIMIT BOOTSTRAP_ENTRIES 32
LIMIT VIEW_NAMES 16
LIMIT VIEWS 32
LIMIT PROVIDERS 8
LIMIT CLIENT_PENDING 8
LIMIT PENDING_SETUPS 32
LIMIT PENDING_REPLIES 8
LIMIT ECHO_BYTES 256
# Native TCP capability protocols; all bodies use monotonic absolute deadlines.
PROTOCOL NETWORK 0x4b57544e 1
PROTOCOL TCP_STREAM 0x53504354 1
PROTOCOL TCP_LISTENER 0x4c504354 1
PROTOCOL NETWORK_OBSERVER 0x53424f4e 1
ORDINAL NETWORK DESCRIBE 0
ORDINAL NETWORK CONNECT 1
ORDINAL NETWORK LISTEN 2
ORDINAL TCP_STREAM READ 1
ORDINAL TCP_STREAM WRITE 2
ORDINAL TCP_STREAM SHUTDOWN_SEND 3
ORDINAL TCP_STREAM INFO 4
ORDINAL TCP_STREAM OBSERVE 5
ORDINAL TCP_STREAM REARM 6
ORDINAL TCP_STREAM CANCEL 7
ORDINAL TCP_STREAM SHUTDOWN_RECEIVE 8
ORDINAL TCP_STREAM ABORT 9
ORDINAL TCP_LISTENER ACCEPT 1
ORDINAL TCP_LISTENER INFO 4
ORDINAL TCP_LISTENER OBSERVE 5
ORDINAL TCP_LISTENER REARM 6
ORDINAL TCP_LISTENER CANCEL 7
ORDINAL NETWORK_OBSERVER READY 1
STATUS WOULD_BLOCK -9
STATUS REFUSED -10
STATUS RESET -11
STATUS CLOSED -12
STATUS NOT_CONNECTED -13
STATUS ADDRESS_IN_USE -14
STATUS UNREACHABLE -15
LIMIT NETWORK_BYTES 16384
LIMIT NETWORK_ENDPOINT_BYTES 24
