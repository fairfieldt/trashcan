+static void applesmc_release_port_lights(void)
+{
+	unsigned int i;
+	u8 off = 0;
+
+	if (!smcreg.port_light_count)
+		return;
+	for (i = 0; port_lights && i < smcreg.port_light_count &&
+		    port_lights[i].cdev.name; i++) {
+		led_classdev_unregister(&port_lights[i].cdev);
+		kfree(port_lights[i].cdev.name);
+	}
+	kfree(port_lights);
+	port_lights = NULL;
+	applesmc_destroy_nodes(port_lights_group);
+	/* hand the lights back to the SMC */
+	applesmc_write_key(PORT_LIGHT_MANUAL_KEY, &off, 1);
+}
+
+static int applesmc_create_port_lights(void)
+{
+	bool named = smcreg.port_light_count == ARRAY_SIZE(macpro61_port_light_names) &&
+		     dmi_match(DMI_PRODUCT_NAME, "MacPro6,1");
+	unsigned int i;
+	int ret;
+
+	if (!smcreg.port_light_count)
+		return 0;
+
+	ret = applesmc_create_nodes(port_lights_group, 1);
+	if (ret)
+		return ret;
+
+	port_lights = kzalloc_objs(*port_lights, smcreg.port_light_count);
+	if (!port_lights) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	for (i = 0; i < smcreg.port_light_count; i++) {
+		struct applesmc_port_light *light = &port_lights[i];
+
+		light->index = i;
+		light->cdev.name = named ?
+			kasprintf(GFP_KERNEL, "smc::%s", macpro61_port_light_names[i]) :
+			kasprintf(GFP_KERNEL, "smc::port-light-%u", i);
+		if (!light->cdev.name) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		light->cdev.max_brightness = LED_FULL;
+		light->cdev.brightness_set_blocking = applesmc_port_light_set;
+		/* unregistering leaves the lights to the SMC instead of turning them off */
+		light->cdev.flags = LED_RETAIN_AT_SHUTDOWN;
+		ret = led_classdev_register(&pdev->dev, &light->cdev);
+		if (ret) {
+			kfree(light->cdev.name);
+			light->cdev.name = NULL;
+			goto out;
+		}
+	}
+	return 0;
+
+out:
+	applesmc_release_port_lights();
+	return ret;
+}
