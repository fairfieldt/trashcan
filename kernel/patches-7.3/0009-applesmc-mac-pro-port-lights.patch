+/*
+ * Port lights. In automatic mode the SMC animates them; setting any LED's
+ * brightness switches to manual mode, where every LED shows its last set level.
+ */
+struct applesmc_port_light {
+	struct led_classdev cdev;
+	u8 index;
+};
+
+static struct applesmc_port_light *port_lights;
+static u16 port_light_levels[PORT_LIGHT_MAX];
+static DEFINE_MUTEX(port_lights_lock);
+
+/* The Mac Pro 6,1's lights in SMC order */
+static const char *const macpro61_port_light_names[] = {
+	"line-out", "headphone", "usb", "thunderbolt", "ethernet", "hdmi",
+	"usb-box-right", "usb-box-left",
+	"thunderbolt-box-right", "thunderbolt-box-left",
+	"ethernet-box-right", "ethernet-box-left",
+	"usb-box-top", "usb-box-bottom",
+	"thunderbolt-box-top", "thunderbolt-box-bottom",
+	"ethernet-box-top", "ethernet-box-bottom",
+	"power", "power-2",
+};
+
+static int applesmc_port_light_send(unsigned int index)
+{
+	u8 buffer[3] = {
+		port_light_levels[index] >> 8, port_light_levels[index] & 0xff, index
+	};
+
+	return applesmc_write_key(PORT_LIGHT_LEVEL_KEY, buffer, 3);
+}
+
+/* Caller holds port_lights_lock. */
+static int applesmc_port_lights_manual(bool *manual)
+{
+	u8 value = 0;
+	int ret;
+
+	ret = applesmc_read_key(PORT_LIGHT_MANUAL_KEY, &value, 1);
+	*manual = value;
+	return ret;
+}
+
+/*
+ * Manual mode as last seen, rechecked at most once a second: an SMC read costs
+ * about 0.4 ms, as much as setting an LED.
+ */
+static bool port_lights_manual_seen;
+static unsigned long port_lights_checked;
+
+/* Send every level, then show them. Caller holds port_lights_lock. */
+static int applesmc_port_lights_enter_manual(void)
+{
+	u8 on = 1;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < smcreg.port_light_count; i++) {
+		ret = applesmc_port_light_send(i);
+		if (ret)
+			return ret;
+	}
+	ret = applesmc_write_key(PORT_LIGHT_MANUAL_KEY, &on, 1);
+	port_lights_manual_seen = !ret;
+	port_lights_checked = jiffies;
+	return ret;
+}
+
+/*
+ * Make sure the SMC shows the manual levels. Returns 1 if it sent them all,
+ * 0 if the caller still has to send its changes. Caller holds port_lights_lock.
+ */
+static int applesmc_port_lights_ensure_manual(void)
+{
+	bool manual;
+	int ret;
+
+	if (port_lights_manual_seen && time_before(jiffies, port_lights_checked + HZ))
+		return 0;
+	ret = applesmc_port_lights_manual(&manual);
+	if (ret)
+		return ret;
+	if (manual) {
+		port_lights_manual_seen = true;
+		port_lights_checked = jiffies;
+		return 0;
+	}
+	ret = applesmc_port_lights_enter_manual();
+	return ret ? ret : 1;
+}
+
+static int applesmc_port_light_set(struct led_classdev *cdev,
+				   enum led_brightness value)
+{
+	struct applesmc_port_light *light =
+		container_of(cdev, struct applesmc_port_light, cdev);
+	int ret;
+
+	mutex_lock(&port_lights_lock);
+	port_light_levels[light->index] = value * 0xffff / PORT_LIGHT_BRIGHTNESS;
+	ret = applesmc_port_lights_ensure_manual();
+	if (!ret)
+		ret = applesmc_port_light_send(light->index);
+	mutex_unlock(&port_lights_lock);
+	return ret < 0 ? ret : 0;
+}
+
+static ssize_t applesmc_port_lights_show(struct device *dev,
+					 struct device_attribute *attr, char *buf)
+{
+	bool manual;
+	int ret;
+
+	mutex_lock(&port_lights_lock);
+	ret = applesmc_port_lights_manual(&manual);
+	mutex_unlock(&port_lights_lock);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "%s\n", manual ? "manual" : "auto");
+}
+
+static ssize_t applesmc_port_lights_store(struct device *dev,
+					  struct device_attribute *attr,
+					  const char *buf, size_t count)
+{
+	u8 off = 0;
+	int ret;
+
+	mutex_lock(&port_lights_lock);
+	if (sysfs_streq(buf, "auto")) {
+		ret = applesmc_write_key(PORT_LIGHT_MANUAL_KEY, &off, 1);
+		port_lights_manual_seen = false;
+	} else if (sysfs_streq(buf, "manual")) {
+		ret = applesmc_port_lights_enter_manual();
+	} else {
+		ret = -EINVAL;
+	}
+	mutex_unlock(&port_lights_lock);
+	return ret ? ret : count;
+}
+
+static ssize_t applesmc_port_lights_motion_show(struct device *dev,
+						struct device_attribute *attr,
+						char *buf)
+{
+	u8 value;
+	int ret;
+
+	ret = applesmc_read_key(PORT_LIGHT_MOTION_KEY, &value, 1);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "%d\n", !!value);
+}
+
+static ssize_t applesmc_port_lights_motion_store(struct device *dev,
+						 struct device_attribute *attr,
+						 const char *buf, size_t count)
+{
+	bool enable;
+	u8 value;
+	int ret;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+	value = enable;
+	/* not during the Hello switch, which restores the setting it found */
+	mutex_lock(&port_lights_lock);
+	ret = applesmc_write_key(PORT_LIGHT_MOTION_KEY, &value, 1);
+	mutex_unlock(&port_lights_lock);
+	return ret ? ret : count;
+}
+
+static ssize_t applesmc_port_lights_hold_ms_show(struct device *dev,
+						 struct device_attribute *attr,
+						 char *buf)
+{
+	u8 buffer[2];
+	int ret;
+
+	ret = applesmc_read_key(PORT_LIGHT_HOLD_KEY, buffer, 2);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "%u\n", (buffer[0] << 8 | buffer[1]) * 10);
+}
+
+static ssize_t applesmc_port_lights_hold_ms_store(struct device *dev,
+						  struct device_attribute *attr,
+						  const char *buf, size_t count)
+{
+	unsigned int ms;
+	u8 buffer[2];
+	int ret;
+
+	ret = kstrtouint(buf, 0, &ms);
+	if (ret)
+		return ret;
+	if (ms / 10 > 0xffff)
+		return -EINVAL;
+	buffer[0] = (ms / 10) >> 8;
+	buffer[1] = (ms / 10) & 0xff;
+	mutex_lock(&port_lights_lock);
+	ret = applesmc_write_key(PORT_LIGHT_HOLD_KEY, buffer, 2);
+	mutex_unlock(&port_lights_lock);
+	return ret ? ret : count;
+}
+
+/* LIGO commands */
+#define PORT_LIGHTS_GO		1
+#define PORT_LIGHTS_HELLO	8	/* the lights sweep on from the bottom, off from the top */
+#define PORT_LIGHTS_YOU_AGAIN	9	/* all at once */
+
+/*
+ * Back to the Hello animation after a You Again. Selecting an animation also
+ * lights up; with motion lighting off for a moment the SMC drops that.
+ */
+static void applesmc_port_lights_hello(struct work_struct *work)
+{
+	u8 motion, off = 0, hello = PORT_LIGHTS_HELLO;
+
+	mutex_lock(&port_lights_lock);
+	if (!applesmc_read_key(PORT_LIGHT_MOTION_KEY, &motion, 1) &&
+	    !applesmc_write_key(PORT_LIGHT_MOTION_KEY, &off, 1)) {
+		applesmc_write_key(PORT_LIGHT_SHOW_KEY, &hello, 1);
+		msleep(200);
+		applesmc_write_key(PORT_LIGHT_MOTION_KEY, &motion, 1);
+	}
+	mutex_unlock(&port_lights_lock);
+}
+
+static DECLARE_DELAYED_WORK(port_lights_hello_work, applesmc_port_lights_hello);
+
+/*
+ * Light up as on motion (automatic mode only): "1" or "hello" with the Hello
+ * animation, "you-again" with You Again; motion shows Hello again afterwards.
+ */
+static ssize_t applesmc_port_lights_show_store(struct device *dev,
+					       struct device_attribute *attr,
+					       const char *buf, size_t count)
+{
+	unsigned int ms = 15000;
+	u8 value, hold[2];
+	bool show;
+	int ret;
+
+	if (sysfs_streq(buf, "hello")) {
+		value = PORT_LIGHTS_HELLO;
+	} else if (sysfs_streq(buf, "you-again")) {
+		value = PORT_LIGHTS_YOU_AGAIN;
+	} else {
+		ret = kstrtobool(buf, &show);
+		if (ret)
+			return ret;
+		if (!show)
+			return count;
+		value = PORT_LIGHTS_GO;
+	}
+
+	mutex_lock(&port_lights_lock);
+	ret = applesmc_write_key(PORT_LIGHT_SHOW_KEY, &value, 1);
+	mutex_unlock(&port_lights_lock);
+	if (ret)
+		return ret;
+	if (value == PORT_LIGHTS_HELLO) {
+		cancel_delayed_work(&port_lights_hello_work);
+	} else if (value == PORT_LIGHTS_YOU_AGAIN) {
+		/* switch back once the lights have faded: the hold time and 3 s */
+		if (!applesmc_read_key(PORT_LIGHT_HOLD_KEY, hold, 2))
+			ms = (hold[0] << 8 | hold[1]) * 10;
+		mod_delayed_work(system_wq, &port_lights_hello_work,
+				 msecs_to_jiffies(ms + 3000));
+	}
+	return count;
+}
+
+/* The power light's mode while the port lights are automatic (the SMC's names: Lms...) */
+static const char *const power_light_modes[] = { "off", "on", "breathe", "bright" };
+static int power_light_mode = 1;
+
+static ssize_t applesmc_power_light_show(struct device *dev,
+					 struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%s\n", power_light_modes[power_light_mode]);
+}
+
+static ssize_t applesmc_power_light_store(struct device *dev,
+					  struct device_attribute *attr,
+					  const char *buf, size_t count)
+{
+	int mode = sysfs_match_string(power_light_modes, buf);
+	u8 buffer[2] = { mode, 0 };
+	int ret;
+
+	if (mode < 0)
+		return mode;
+	mutex_lock(&port_lights_lock);
+	ret = applesmc_write_key(POWER_LIGHT_MODE_KEY, buffer, 2);
+	if (!ret)
+		power_light_mode = mode;
+	mutex_unlock(&port_lights_lock);
+	return ret ? ret : count;
+}
