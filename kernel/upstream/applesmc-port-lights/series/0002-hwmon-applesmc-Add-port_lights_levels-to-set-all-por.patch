From 8a9c8f5d1bb060d7c136fad1ba2ad8d1c3af356c Mon Sep 17 00:00:00 2001
From: Tom Fairfield <tom@fairfieldt.com>
Date: Mon, 19 Oct 2026 11:11:46 -0700
Subject: [PATCH 2/2] hwmon: (applesmc) Add port_lights_levels to set all port
 lights at once

Programs that animate the Mac Pro 6,1 port lights, such as a music
visualizer or activity lights, set all 20 LEDs dozens of times a second.
Through the LED class that is 20 writes per frame. Each is queued on its
own in the LED core and is an SMC write even when the level didn't
change, and nothing keeps the LEDs of one frame together.

Add port_lights_levels, which takes every LED's brightness in one write,
in the order documented for port_lights, and sends only the LEDs whose
level the SMC doesn't already have. The SMC has no command for several
LEDs, so each changed LED is still a write of about 0.4 ms and the
update isn't simultaneous; on a Mac Pro 6,1 a frame in which all 20 LEDs
change takes 8.1 ms, one in which 5 change 2.2 ms, and an unchanged one
no SMC access.

A write behaves like writing each LED's brightness in order, as one
operation:

- single-LED updates still queued in the LED core are applied first, so
  they can't land after it;
- LEDs with a trigger keep following it and ignore their value;
- an LED counts as sent only once its SMC write succeeds, so after an
  error the same write can be repeated to send the rest.

Reads give each LED's brightness as its LED class device reports it.

Tested on a Mac Pro 6,1: the timings above, and 30 rounds of a
single-LED write of 255 immediately followed by a bulk write of 64 for
that LED, all of which ended at 64 (read back through the controller's
status key).
---
 .../testing/sysfs-devices-platform-applesmc   | 18 ++++
 drivers/hwmon/applesmc.c                      | 84 ++++++++++++++++++-
 2 files changed, 101 insertions(+), 1 deletion(-)

diff --git a/Documentation/ABI/testing/sysfs-devices-platform-applesmc b/Documentation/ABI/testing/sysfs-devices-platform-applesmc
index 20d46860a6b4..413be7690076 100644
--- a/Documentation/ABI/testing/sysfs-devices-platform-applesmc
+++ b/Documentation/ABI/testing/sysfs-devices-platform-applesmc
@@ -60,3 +60,21 @@ Description:
 		manual mode the power light is the LEDs smc::power and
 		smc::power-2 instead. Reads give the mode last written ("on"
 		until then); unloading the driver sets "on" again.
+
+What:		/sys/devices/platform/applesmc.768/port_lights_levels
+Date:		October 2026
+KernelVersion:	7.5
+Contact:	Tom Fairfield <tom@fairfieldt.com>
+Description:
+		(RW) Every port light's brightness at once: one value 0-255
+		per LED in the SMC order given for port_lights, separated by
+		spaces. Writing it is the same as writing each LED's
+		brightness in that order, as one operation: changes still
+		queued for single LEDs are applied first, the panel switches
+		to manual mode, and LEDs with a trigger keep following it and
+		ignore their value. Each LED is still a separate SMC write
+		(about 0.4 ms); LEDs the SMC already has at that level are not
+		written again. If a write fails, the error is returned and the
+		same write can be repeated: it sends the LEDs that did not get
+		through. Reads give each LED's brightness as its LED class
+		device reports it.
diff --git a/drivers/hwmon/applesmc.c b/drivers/hwmon/applesmc.c
index 14c6841da1d2..7743ca2b6963 100644
--- a/drivers/hwmon/applesmc.c
+++ b/drivers/hwmon/applesmc.c
@@ -32,6 +32,7 @@
 #include <linux/hwmon.h>
 #include <linux/workqueue.h>
 #include <linux/err.h>
+#include <linux/ctype.h>
 #include <linux/bits.h>
 #include <asm/barrier.h>
 
@@ -1014,13 +1015,20 @@ static const char *const macpro61_port_light_names[] = {
 	"power", "power-2",
 };
 
+/* LEDs whose level the SMC may not have: set until a write succeeds */
+static DECLARE_BITMAP(port_light_unsent, PORT_LIGHT_MAX);
+
 static int applesmc_port_light_send(unsigned int index)
 {
 	u8 buffer[3] = {
 		port_light_levels[index] >> 8, port_light_levels[index] & 0xff, index
 	};
+	int ret;
 
-	return applesmc_write_key(PORT_LIGHT_LEVEL_KEY, buffer, 3);
+	ret = applesmc_write_key(PORT_LIGHT_LEVEL_KEY, buffer, 3);
+	if (!ret)
+		clear_bit(index, port_light_unsent);
+	return ret;
 }
 
 /* Caller holds port_lights_lock. */
@@ -1091,6 +1099,7 @@ static int applesmc_port_light_set(struct led_classdev *cdev,
 
 	mutex_lock(&port_lights_lock);
 	port_light_levels[light->index] = value * 0xffff / PORT_LIGHT_BRIGHTNESS;
+	set_bit(light->index, port_light_unsent);
 	ret = applesmc_port_lights_ensure_manual();
 	if (!ret)
 		ret = applesmc_port_light_send(light->index);
@@ -1132,6 +1141,77 @@ static ssize_t applesmc_port_lights_store(struct device *dev,
 	return ret ? ret : count;
 }
 
+/*
+ * Every LED at once: brightness 0-255 in SMC order (macpro61_port_light_names),
+ * separated by spaces. Only LEDs whose level the SMC may not have are sent, so
+ * after an error the same write sends what didn't get through. LEDs with a
+ * trigger keep following it and ignore their value. Reads give each LED's
+ * brightness as the LED class reports it.
+ */
+static ssize_t applesmc_port_lights_levels_show(struct device *dev,
+						struct device_attribute *attr,
+						char *buf)
+{
+	unsigned int i;
+	int len = 0;
+
+	for (i = 0; i < smcreg.port_light_count; i++)
+		len += sysfs_emit_at(buf, len, "%u%c", port_lights[i].cdev.brightness,
+				     i + 1 < smcreg.port_light_count ? ' ' : '\n');
+	return len;
+}
+
+static ssize_t applesmc_port_lights_levels_store(struct device *dev,
+						 struct device_attribute *attr,
+						 const char *buf, size_t count)
+{
+	bool triggered[PORT_LIGHT_MAX];
+	u8 values[PORT_LIGHT_MAX];
+	unsigned int i, value;
+	const char *p = buf;
+	int n, ret;
+
+	for (i = 0; i < smcreg.port_light_count; i++) {
+		if (sscanf(p, " %u%n", &value, &n) != 1 || value > PORT_LIGHT_BRIGHTNESS)
+			return -EINVAL;
+		values[i] = value;
+		p += n;
+	}
+	while (isspace(*p))
+		p++;
+	if (*p)
+		return -EINVAL;
+
+	for (i = 0; i < smcreg.port_light_count; i++) {
+		struct led_classdev *cdev = &port_lights[i].cdev;
+
+		/* single-LED changes still queued in the LED core land before this one */
+		flush_work(&cdev->set_brightness_work);
+		down_read(&cdev->trigger_lock);
+		triggered[i] = cdev->trigger;
+		up_read(&cdev->trigger_lock);
+	}
+
+	mutex_lock(&port_lights_lock);
+	for (i = 0; i < smcreg.port_light_count; i++) {
+		u16 level = values[i] * 0xffff / PORT_LIGHT_BRIGHTNESS;
+
+		if (triggered[i])
+			continue;
+		if (level != port_light_levels[i]) {
+			port_light_levels[i] = level;
+			set_bit(i, port_light_unsent);
+		}
+		port_lights[i].cdev.brightness = values[i];
+	}
+	ret = applesmc_port_lights_ensure_manual();
+	for (i = 0; !ret && i < smcreg.port_light_count; i++)
+		if (test_bit(i, port_light_unsent))
+			ret = applesmc_port_light_send(i);
+	mutex_unlock(&port_lights_lock);
+	return ret < 0 ? ret : count;
+}
+
 static ssize_t applesmc_port_lights_motion_show(struct device *dev,
 						struct device_attribute *attr,
 						char *buf)
@@ -1318,6 +1398,8 @@ static struct applesmc_node_group light_sensor_group[] = {
 
 static struct applesmc_node_group port_lights_group[] = {
 	{ "port_lights", applesmc_port_lights_show, applesmc_port_lights_store },
+	{ "port_lights_levels", applesmc_port_lights_levels_show,
+	  applesmc_port_lights_levels_store },
 	{ "port_lights_motion", applesmc_port_lights_motion_show,
 	  applesmc_port_lights_motion_store },
 	{ "port_lights_hold_ms", applesmc_port_lights_hold_ms_show,
