From 89817176177a3bf24ed101f3c82472acdf38107e Mon Sep 17 00:00:00 2001
From: Tom Fairfield <tom@fairfieldt.com>
Date: Mon, 5 Oct 2026 21:16:29 -0700
Subject: [PATCH 2/2] drm/radeon: Prefer exact bus match when picking a VFCT
 image

Since commit 4059e2f02c8a ("drm/radeon: Fix VFCT bus number matching with
soft filter") the VFCT lookup takes the first image whose vendor, device,
slot and function match, whatever its bus number.  On a system with
several identical GPUs the VFCT has one image per GPU and the entries
differ only in the bus number, so every GPU gets the first GPU's image.

The Mac Pro 6,1 has two FirePro D700s, which radeon drives by default,
and this VFCT:

  02:00.0 1002:6798 113-C3861XA-028
  06:00.0 1002:6798 113-C3861XB-028

and the GPU at 06:00.0 now loads the 113-C3861XA-028 image and logs a
bus number mismatch even though its own entry is in the table.

Scan the whole table and use an image with an exact bus match when there
is one.  Only fall back to the first image with a matching device
identity when no bus number matches, which keeps the pci=realloc case
the soft filter was added for working.

Fixes: 4059e2f02c8a ("drm/radeon: Fix VFCT bus number matching with soft filter")
Cc: stable@vger.kernel.org
---
 drivers/gpu/drm/radeon/radeon_bios.c | 89 +++++++++++++++-------------
 1 file changed, 47 insertions(+), 42 deletions(-)

diff --git a/drivers/gpu/drm/radeon/radeon_bios.c b/drivers/gpu/drm/radeon/radeon_bios.c
index 1da6bf1c17ff..ace0231527b8 100644
--- a/drivers/gpu/drm/radeon/radeon_bios.c
+++ b/drivers/gpu/drm/radeon/radeon_bios.c
@@ -610,39 +610,28 @@ static bool radeon_read_disabled_bios(struct radeon_device *rdev)
  * On systems where the kernel renumbers PCI buses (e.g. pci=realloc or
  * resource conflicts), the runtime bus number may differ from the POST
  * value.  Match by device identity (vendor + device + function) and use
- * the bus number as a preference: exact bus match is preferred, but when
- * the bus numbers disagree we accept the entry if the device identity
- * matches.
+ * the bus number as a preference: the caller takes an entry whose bus
+ * number also matches, and falls back to an entry with only a matching
+ * device identity.  Systems with several identical GPUs (e.g. Mac Pro 6,1)
+ * have one entry per GPU that differ only in the bus number, so an exact
+ * bus match must win even when it is not the first identity match.
  *
- * Returns: 0 on match, -ENODEV on no match
+ * Returns: true if the device identity matches
  */
-static int radeon_acpi_vfct_match(struct radeon_device *rdev,
-				  VFCT_IMAGE_HEADER *vhdr)
+static bool radeon_acpi_vfct_match(struct radeon_device *rdev,
+				   VFCT_IMAGE_HEADER *vhdr)
 {
-	/* Vendor and device IDs must always match */
-	if (vhdr->VendorID != rdev->pdev->vendor ||
-	    vhdr->DeviceID != rdev->pdev->device)
-		return -ENODEV;
-
-	if (vhdr->PCIDevice != PCI_SLOT(rdev->pdev->devfn) ||
-	    vhdr->PCIFunction != PCI_FUNC(rdev->pdev->devfn))
-		return -ENODEV;
-
-	/* Exact bus number match - preferred */
-	if (vhdr->PCIBus == rdev->pdev->bus->number)
-		return 0;
-
-	/* Bus mismatch but device identity matches (PCI renumbering case) */
-	dev_notice(&rdev->pdev->dev,
-		   "VFCT bus number mismatch: table %u != runtime %u, matching by device identity (vendor 0x%04x device 0x%04x)\n",
-		   vhdr->PCIBus, rdev->pdev->bus->number,
-		   rdev->pdev->vendor, rdev->pdev->device);
-	return 0;
+	return vhdr->VendorID == rdev->pdev->vendor &&
+	       vhdr->DeviceID == rdev->pdev->device &&
+	       vhdr->PCIDevice == PCI_SLOT(rdev->pdev->devfn) &&
+	       vhdr->PCIFunction == PCI_FUNC(rdev->pdev->devfn);
 }
 
 static bool radeon_acpi_vfct_bios(struct radeon_device *rdev)
 {
+	GOP_VBIOS_CONTENT *vbios, *match = NULL;
 	struct acpi_table_header *hdr;
+	VFCT_IMAGE_HEADER *vhdr;
 	acpi_size tbl_size;
 	UEFI_ACPI_VFCT *vfct;
 	unsigned int offset;
@@ -660,8 +649,8 @@ static bool radeon_acpi_vfct_bios(struct radeon_device *rdev)
 	offset = vfct->VBIOSImageOffset;
 
 	while (offset < tbl_size) {
-		GOP_VBIOS_CONTENT *vbios = (GOP_VBIOS_CONTENT *)((char *)hdr + offset);
-		VFCT_IMAGE_HEADER *vhdr = &vbios->VbiosHeader;
+		vbios = (GOP_VBIOS_CONTENT *)((char *)hdr + offset);
+		vhdr = &vbios->VbiosHeader;
 
 		offset += sizeof(VFCT_IMAGE_HEADER);
 		if (offset > tbl_size) {
@@ -675,24 +664,40 @@ static bool radeon_acpi_vfct_bios(struct radeon_device *rdev)
 			goto out;
 		}
 
-		if (vhdr->ImageLength &&
-		    !radeon_acpi_vfct_match(rdev, vhdr)) {
-			rdev->bios = kmemdup(&vbios->VbiosContent,
-					     vhdr->ImageLength,
-					     GFP_KERNEL);
-
-			if (!rdev->bios ||
-			    rdev->bios[0] != 0x55 || rdev->bios[1] != 0xaa) {
-				kfree(rdev->bios);
-				rdev->bios = NULL;
-				goto out;
-			}
-			r = true;
-			goto out;
+		if (!vhdr->ImageLength || !radeon_acpi_vfct_match(rdev, vhdr))
+			continue;
+
+		/* Exact bus number match - preferred */
+		if (vhdr->PCIBus == rdev->pdev->bus->number) {
+			match = vbios;
+			break;
 		}
+
+		/* Bus mismatch: keep the first one unless an exact match follows */
+		if (!match)
+			match = vbios;
 	}
 
-	dev_warn(&rdev->pdev->dev, "ACPI VFCT table present but broken (too short #2),skipping\n");
+	if (!match) {
+		dev_warn(&rdev->pdev->dev, "ACPI VFCT table present but broken (too short #2),skipping\n");
+		goto out;
+	}
+
+	vhdr = &match->VbiosHeader;
+	if (vhdr->PCIBus != rdev->pdev->bus->number)
+		dev_notice(&rdev->pdev->dev,
+			   "VFCT bus number mismatch: table %u != runtime %u, matching by device identity (vendor 0x%04x device 0x%04x)\n",
+			   vhdr->PCIBus, rdev->pdev->bus->number,
+			   rdev->pdev->vendor, rdev->pdev->device);
+
+	rdev->bios = kmemdup(&match->VbiosContent, vhdr->ImageLength, GFP_KERNEL);
+	if (!rdev->bios ||
+	    rdev->bios[0] != 0x55 || rdev->bios[1] != 0xaa) {
+		kfree(rdev->bios);
+		rdev->bios = NULL;
+		goto out;
+	}
+	r = true;
 
 out:
 	acpi_put_table(hdr);
-- 
2.47.3

