#!/bin/bash
# Bring up Thunderbolt links between trashcan nodes and keep them healthy. See nodes/macpro/README.md.
#
# Every XDomain peer is looked up in /etc/tblink/nodes.tsv by the UUID of its Thunderbolt controller, so both ends
# of a cable agree on a /30 without talking to each other: for nodes a < b using Apple buses da and db,
#   10.99.(16*a + b).(4*(3*da + db) + 1) on node a and .. + 2 on node b,
# with "<peer>.tb<local bus>" in /etc/hosts. A link that still shows the Mac firmware's peer (vendor 0xa27), or has
# no working interface, for GRACE seconds is reported once in the log and by `tblink status`. It is not reset
# automatically: unbinding one controller's driver triggered a thunderbolt bug (duplicate XDomain device) and
# coincided with the peer Mac resetting. `tblink reload` reloads the Thunderbolt modules on this node; run it on the
# stuck node's neighbour first, then on the node.
#
# A node missing from the table (or a missing or empty table) does nothing: no addresses, no streams.
#
# Every working link also gets a USB4STREAM, `trashcan`, under its XDomain's stream service (configfs), with input
# and output HopID 15 at both ends (thunderbolt_net takes the lowest free HopIDs from 8), so neither end needs the
# other's: the engine's links find it from the TCP connection's interface and move their data to it (engine/src/
# link). The stream is created again whenever it is missing (module reload, controller reset, reconnect) or sits
# under a service name that is no longer the stream service (the .0/.1 index follows discovery order).
#
# usage: tblink run      (tblink.service)
#        tblink status   (for people)
#        tblink links    (for programs: tab-separated, header line, one line per link)
#        tblink reload
set -u
NODES=/etc/tblink/nodes.tsv
STATE=/run/tblink
DEVS=/sys/bus/thunderbolt/devices
CFG=/sys/kernel/config/thunderbolt/stream
STREAM=trashcan HOPID=15
INTERVAL=5 GRACE=90
APPLE_FIRMWARE=0xa27

bus_of_nhi() {
    case $1 in 0000:16:00.0) echo 0 ;; 0000:5d:00.0) echo 1 ;; 0000:a4:00.0) echo 2 ;; esac
}
# UUID -> "index hostname bus"
lookup() { awk -v u="$1" '!/^#/ && NF >= 5 { for (i = 3; i <= 5; i++) if ($i == u) { print $1, $2, i - 3; exit } }' "$NODES" 2>/dev/null; }
log() { echo "$*"; }

# Print one line per XDomain link: "xd nhi lbus rindex rhost rbus iface vendor"
links() {
    local d xd dom nhi ruuid iface vendor rest
    for d in "$DEVS"/[0-9]*-[0-9]*; do
        xd=$(basename "$d")
        [[ $xd == *.* || $xd == *-0 ]] && continue
        [ -r "$d/unique_id" ] || continue
        dom=${xd%%-*}
        nhi=$(basename "$(dirname "$(readlink -f "$DEVS/domain$dom")")")
        ruuid=$(cat "$d/unique_id")
        vendor=$(cat "$d/vendor" 2>/dev/null)
        # Service numbers follow discovery order; stream can be .0 and net .1.
        iface=$(for service in "$d/$xd".*; do
            [ -d "$service/net" ] && ls "$service/net" 2>/dev/null
        done | head -1)
        rest=$(lookup "$ruuid")
        echo "$xd $nhi $(bus_of_nhi "$nhi") ${rest:-0 ? ?} ${iface:--} $vendor"
    done
}

# The XDomain's stream service (the peer advertises it once its thunderbolt_stream is loaded), e.g. 0-3.1.
stream_service() {
    local s
    for s in "$DEVS/$1/$1".*; do
        [ "$(cat "$s/key" 2>/dev/null)" = stream ] && { basename "$s"; return 0; }
    done
    return 1
}

# The link's stream device, if its stream exists under the current stream service.
stream_device() {
    local svc
    svc=$(stream_service "$1") || { echo -; return; }
    if [ -r "$CFG/$svc/$STREAM/index" ]; then echo "/dev/tbstream$(cat "$CFG/$svc/$STREAM/index")"; else echo -; fi
}

# Create the link's stream if it is missing; prints its configfs group (messages go to stderr). A new stream may
# already have the peer's HopIDs (the driver copies them from the peer's XDomain properties), and writing a HopID it
# holds fails, so only values that differ are written.
ensure_stream() {
    local xd=$1 svc g d max a new=0
    svc=$(stream_service "$xd") || return 1
    g=$CFG/$svc d=$CFG/$svc/$STREAM
    if [ ! -d "$d" ]; then
        max=$(cat "$DEVS/$xd/maxhopid" 2>/dev/null || echo 0)
        if (( max < HOPID )); then
            log "$xd: peer's highest HopID is $max; no stream" >&2
            return 1
        fi
        mkdir -p "$d" 2>/dev/null || { log "$xd: cannot create $d" >&2; return 1; }
        new=1
    fi
    for a in in_hopid out_hopid; do
        [ "$(cat "$d/$a" 2>/dev/null)" = "$HOPID" ] && continue
        if ! echo "$HOPID" > "$d/$a" 2>/dev/null; then
            log "$xd: cannot set $a $HOPID for $svc (now $(cat "$d/$a" 2>/dev/null))$( [ "$new" = 1 ] && echo '; no stream')" >&2
            [ "$new" = 1 ] && rmdir "$d" "$g" 2>/dev/null
            return 1
        fi
    done
    [ "$new" = 1 ] && log "$xd: stream $svc/$STREAM, /dev/tbstream$(cat "$d/index"), HopIDs $HOPID/$HOPID" >&2
    echo "$svc"
}

# Remove stream groups that are not a working link's current stream service (they cannot carry anything), and empty
# groups. Other streams in a group (set up by hand) are left alone.
prune_streams() { # wanted groups, space separated
    local g name
    for g in "$CFG"/*; do
        [ -d "$g" ] || continue
        name=$(basename "$g")
        [[ " $1 " == *" $name "* ]] && continue
        [ -d "$g/$STREAM" ] && rmdir "$g/$STREAM" 2>/dev/null && log "$name: removed stale stream"
        rmdir "$g" 2>/dev/null
    done
}

# Addresses for a link: prints "local/30 peer"
addresses() { # me lbus peer rbus
    local a=$1 da=$2 b=$3 db=$4 net host lo hi
    if (( a < b )); then lo=$a hi=$b host=$(( 4 * (3 * da + db) )); else lo=$b hi=$a host=$(( 4 * (3 * db + da) )); fi
    net=10.99.$(( 16 * lo + hi ))
    if (( a < b )); then echo "$net.$(( host + 1 ))/30 $net.$(( host + 2 ))"; else echo "$net.$(( host + 2 ))/30 $net.$(( host + 1 ))"; fi
}

update_hosts() { # block
    local block=$1 cur
    cur=$(sed -n '/^# BEGIN tblink$/,/^# END tblink$/p' /etc/hosts)
    [ "$cur" = "$block" ] && return
    { sed '/^# BEGIN tblink$/,/^# END tblink$/d' /etc/hosts; [ -n "$block" ] && echo "$block"; } > /etc/hosts.tblink
    cat /etc/hosts.tblink > /etc/hosts && rm -f /etc/hosts.tblink
}

once() {
    local me xd nhi lbus rindex rhost rbus iface vendor addr peer bad first now svc hosts="" groups=""
    me=$(awk -v h="$(hostname)" '!/^#/ && $2 == h { print $1 }' "$NODES" 2>/dev/null)
    [ -n "$me" ] || return
    now=$(date +%s)
    if [ ! -d /sys/module/thunderbolt_stream ] && [ -d /sys/module/thunderbolt ]; then
        modprobe thunderbolt_stream && log "loaded thunderbolt_stream"
    fi
    while read -r xd nhi lbus rindex rhost rbus iface vendor; do
        bad=""
        if [ "$vendor" = "$APPLE_FIRMWARE" ]; then
            bad="peer is the Mac firmware"
        elif [ "$rindex" = 0 ] || [ "$rindex" = "$me" ]; then
            continue    # a host we don't know, or a cable looping this node's own controllers
        elif [ "$iface" = - ]; then
            bad="no network interface"
        else
            read -r addr peer < <(addresses "$me" "$lbus" "$rindex" "$rbus")
            if ! ip -4 -o addr show dev "$iface" | grep -q " ${addr} "; then
                ip addr flush dev "$iface"
                ip addr add "$addr" dev "$iface" && log "$xd ($iface): $addr to $rhost bus $rbus"
            fi
            ip link set "$iface" up
            hosts+="$peer $rhost.tb$lbus"$'\n'
            [ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" = 1 ] || bad="no carrier"
            [ -z "$bad" ] && [ -d "$CFG" ] && svc=$(ensure_stream "$xd") && groups+="$svc "
        fi
        if [ -n "$bad" ]; then
            first=$(cat "$STATE/bad-$xd" 2>/dev/null || { echo "$now" > "$STATE/bad-$xd"; echo "$now"; })
            if (( now - first >= GRACE )) && [ ! -e "$STATE/reported-$xd" ]; then
                touch "$STATE/reported-$xd"
                log "$xd ($nhi): $bad for $(( now - first )) s; run 'tblink reload' on the peer, then here"
            fi
        else
            rm -f "$STATE/bad-$xd" "$STATE/reported-$xd"
        fi
    done < <(links)
    [ -d "$CFG" ] && prune_streams "$groups"
    update_hosts "$( [ -n "$hosts" ] && printf '# BEGIN tblink\n%s# END tblink' "$hosts")"
}

case ${1:-} in
    run)
        mkdir -p "$STATE"
        # One pass at a time with `tblink reload` (and tb-reset.sh, which stops this service).
        while :; do
            { flock 9; once; } 9> "$STATE/lock"
            sleep "$INTERVAL"
        done
        ;;
    status)
        me=$(awk -v h="$(hostname)" '!/^#/ && $2 == h { print $1 }' "$NODES" 2>/dev/null)
        echo "node $(hostname) index ${me:-unknown} ($NODES)"
        [ -n "$me" ] || echo "$(hostname) is not in $NODES: add it with nodes/macpro/provision.sh HOST tblink"
        links | while read -r xd nhi lbus rindex rhost rbus iface vendor; do
            lanes=$(cat "$DEVS/$xd/rx_lanes" 2>/dev/null)
            echo "$xd bus $lbus -> $rhost bus $rbus, ${lanes:-?} lane(s), $iface $(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{print $4}') carrier $(cat "/sys/class/net/$iface/carrier" 2>/dev/null || echo -), stream $(stream_device "$xd")$( [ "$vendor" = "$APPLE_FIRMWARE" ] && echo ', Mac firmware')"
        done
        sed -n '/^# BEGIN tblink$/,/^# END tblink$/p' /etc/hosts | grep -v '^#' || true  # no links yet
        ;;
    links)
        me=$(awk -v h="$(hostname)" '!/^#/ && $2 == h { print $1 }' "$NODES" 2>/dev/null)
        printf 'xdomain\tpeer\tlocal_bus\tpeer_bus\tlanes\tstate\tiface\taddress\tpeer_address\tstream\n'
        links | while read -r xd nhi lbus rindex rhost rbus iface vendor; do
            lanes=$(cat "$DEVS/$xd/rx_lanes" 2>/dev/null || echo 0)
            addr=- peer=- stream=-
            if [ "$vendor" = "$APPLE_FIRMWARE" ]; then
                state=firmware
            elif [ "$rindex" = 0 ] || [ -z "$me" ]; then
                state=unknown
            elif [ "$rindex" = "$me" ]; then
                state=loop
            else
                read -r addr peer < <(addresses "$me" "$lbus" "$rindex" "$rbus")
                addr=${addr%/*}
                if [ "$iface" = - ]; then state=no_interface
                elif [ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" = 1 ]; then state=up; stream=$(stream_device "$xd")
                else state=no_carrier; fi
            fi
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$xd" "$rhost" "$lbus" "$rbus" "$lanes" "$state" "$iface" "$addr" "$peer" "$stream"
        done
        ;;
    reload)
        mkdir -p "$STATE"
        exec 9> "$STATE/lock"
        flock 9
        # Configfs groups hold thunderbolt_stream; an open stream device holds it too (the engine falls back to TCP
        # once its stream is gone, but the process must close the device before the module can go).
        for g in "$CFG"/*; do
            [ -d "$g" ] || continue
            [ -d "$g/$STREAM" ] && rmdir "$g/$STREAM" 2>/dev/null
            rmdir "$g" 2>/dev/null
        done
        if ! modprobe -r thunderbolt_stream thunderbolt_net; then
            echo "a Thunderbolt stream or interface is still in use: $(fuser /dev/tbstream* 2>&1 | tr -s ' ')" >&2
            exit 1
        fi
        modprobe -r thunderbolt && modprobe thunderbolt_net && modprobe thunderbolt_stream && echo "Thunderbolt modules reloaded"
        ;;
    *) echo "usage: tblink run|status|links|reload" >&2; exit 2 ;;
esac
