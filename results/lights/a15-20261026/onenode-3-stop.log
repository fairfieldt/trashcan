== blinken idle mode: force manual via a conductor-less blinken? (skip)
== stop
  port_lights=auto power_light=on node=inactive
== start
  port_lights=auto power_light=breathe node=active
== SIGKILL (failure)
  port_lights=auto power_light=on node=activating
  after RestartSec:
  port_lights=auto power_light=breathe node=active
== SIGTERM during blinkenlights
  while blinken: manual
  port_lights=auto power_light=on node=inactive
  port_lights=auto power_light=breathe node=active
