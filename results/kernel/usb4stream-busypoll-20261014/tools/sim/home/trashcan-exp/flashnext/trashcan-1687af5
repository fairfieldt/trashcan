#!/bin/bash
# Stub of the churn build on a simulated Mac: `link-test serve` runs until it is killed; `link-test churn` prints its
# sessions and summary; `link-test run` prints an up line and a result.
case "${1:-} ${2:-}" in
    "link-test serve")
        echo "link-test: serving on ${4:-?}" >&2
        trap 'exit 0' TERM
        while :; do sleep 0.2; done
        ;;
    "link-test churn")
        n=$(echo "$*" | sed -n 's/.*--sessions \([0-9]*\).*/\1/p')
        for ((i = 0; i < n; i++)); do
            sleep 0.1
            echo "{\"session\": $i, \"kind\": \"n\", \"up_ms\": 5.0, \"pass\": true, \"failed_epochs\": 0, \"rc\": 0, \"ms\": 600, \"lane\": null, \"error\": null, \"stream_lines\": []}"
        done
        echo "{\"churn\": \"sim\", \"sessions\": $n, \"passed\": $n, \"on_stream\": $n, \"failed_epochs\": 0, \"pass\": true}"
        ;;
    "link-test run")
        echo '{"label": "sim", "up_ms": 5.0}'
        echo '{"label": "sim", "result": {"lanes": [{"path": "stream", "stats": {}}]}}'
        ;;
    *) echo "stub: $*" >&2; exit 2 ;;
esac
