#!/usr/bin/env python3
"""Stub of tblink on a simulated Mac ($SIMHOST): `links` prints the ring links incite -> inflight -> alight -> indite
-> invite -> enlight -> incite, up on two lanes with a stream at each end."""
import os, sys

RING = ['incite', 'inflight', 'alight', 'indite', 'invite', 'enlight']
host = os.environ['SIMHOST']
i = RING.index(host)
if sys.argv[1:] == ['links']:
    print('xdomain\tpeer\tlocal_bus\tpeer_bus\tlanes\tstate\tiface\taddress\tpeer_address\tstream')
    for bus, peer in ((0, RING[(i + 1) % 6]), (1, RING[i - 1])):
        print(f'{bus}-3\t{peer}\t{bus}\t{1 - bus}\t2\tup\tthunderbolt{bus}\t10.0.{i}.{bus + 1}\t10.0.{i}.{bus + 2}\t/dev/tbstream{bus}')
