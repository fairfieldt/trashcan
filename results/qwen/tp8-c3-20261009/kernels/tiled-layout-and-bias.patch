index 0950420..800ea04 100644
--- a/engine/src/quant.rs
+++ b/engine/src/quant.rs
@@ -28,6 +28,34 @@ pub fn repack_q4(
     out
 }
 
+/// `repack_q4` in the tiled order: each group of four rows is contiguous (its scales, then from word `stride`
+/// its nibbles) and within a group the blocks come in tiles of 16 per row, [tile][row of the group][block of the
+/// tile][word], so a wave reading 16 blocks of four rows streams one 256-byte run of scales and one 1 KB run of
+/// nibbles instead of eight pieces a row apart. The last tile of a group holds the remaining blocks (w = min(16,
+/// blocks - 16 tile) per row). Rows must be a multiple of 4; the words of block b of row r are at
+/// `q4t_scale`/`q4t_qs` of common.glsl.
+pub fn repack_q4_tiled(src: &[u8], k: usize, n: usize, row: usize, rows: usize, col: usize, cols: usize) -> Vec<u8> {
+    assert!(
+        row + rows <= n && col + cols <= k && col.is_multiple_of(32) && cols.is_multiple_of(32) && rows.is_multiple_of(4)
+    );
+    let blocks = cols / 32;
+    let count = rows * blocks;
+    let mut out = vec![0u8; count * 20];
+    for r in 0..rows {
+        for b in 0..blocks {
+            let at = ((row + r) * k / 32 + col / 32 + b) * 18;
+            let d = f16::from_le_bytes(src[at..at + 2].try_into().unwrap()).to_f32();
+            let (bg, w) = (b / 16, (blocks - b / 16 * 16).min(16));
+            let tile = (r / 4) * blocks + bg * 16;
+            let scale = tile * 4 + (r % 4) * w + b % 16;
+            let qs = tile * 16 + (r % 4) * w * 4 + (b % 16) * 4;
+            out[scale * 4..scale * 4 + 4].copy_from_slice(&d.to_le_bytes());
+            out[count * 4 + qs * 4..count * 4 + qs * 4 + 16].copy_from_slice(&src[at + 2..at + 18]);
+        }
+    }
+    out
+}
