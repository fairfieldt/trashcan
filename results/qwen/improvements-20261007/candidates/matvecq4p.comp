#version 460
#include "common.glsl"
// One Q4 block loaded ahead, preserving matvecq4's block order and arithmetic.
layout(local_size_x=256) in;
void main() {
    uint lane=gl_SubgroupInvocationID;
    uint first=gl_WorkGroupID.x*16+gl_SubgroupID*4,part=lane%4,blocks=p.k/32;
    uint b0=lane/4;
    vec4 x0=vec4(0),x1=vec4(0),scales=vec4(0);
    if(b0<blocks){x0=b_v4.v[b0*8+part];x1=b_v4.v[b0*8+part+4];}
    uvec4 packed=uvec4(0);
    if(b0<blocks)[[unroll]]for(uint r=0;r<4;r++){
        uint block=(first+r)*blocks+b0;
        scales[r]=uintBitsToFloat(ww.words[block]);packed[r]=ww.words[p.stride+block*4+part];
    }
    vec4 sums=vec4(0);
    for(uint b=b0;b<blocks;b+=16){
        vec4 a=x0,c=x1,s=scales;uvec4 q=packed;
        if(b+16<blocks){
            x0=b_v4.v[(b+16)*8+part];x1=b_v4.v[(b+16)*8+part+4];
            [[unroll]]for(uint r=0;r<4;r++){
                uint block=(first+r)*blocks+b+16;
                scales[r]=uintBitsToFloat(ww.words[block]);packed[r]=ww.words[p.stride+block*4+part];
            }
        }
        float bias=8.0*dot(a+c,vec4(1));
        [[unroll]]for(uint r=0;r<4;r++){
            vec4 lo=unpackUnorm4x8(q[r]&0x0f0f0f0fu)*255.0;
            vec4 hi=unpackUnorm4x8((q[r]>>4)&0x0f0f0f0fu)*255.0;
            sums[r]=fma(dot(lo,a)+dot(hi,c)-bias,s[r],sums[r]);
        }
    }
    sums=subgroupAdd(sums);
    if(lane==0)[[unroll]]for(uint r=0;r<4;r++)if(first+r<p.n)c_f.v[first+r]=sums[r];
}
