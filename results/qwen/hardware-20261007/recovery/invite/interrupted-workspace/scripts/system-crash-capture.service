[Unit]
Description=Preserve Mac Pro system telemetry and GPU crash dumps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/netconsole-target
ExecStart=/usr/bin/python3 /usr/local/sbin/system-crash-capture.py --target ${NETCONSOLE_TARGET}
Restart=always
RestartSec=3
UMask=0077
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
