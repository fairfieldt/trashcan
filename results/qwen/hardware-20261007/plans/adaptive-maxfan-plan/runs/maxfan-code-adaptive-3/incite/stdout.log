  and reject inconsistent row lengths.\n    \n    Args:\n        text: The CSV text to parse.\n        \n    Returns:\n        A list of rows, where each row is a list of string fields.\n        \n    Raises:\n        ValueError: If rows have inconsistent lengths.\n    \"\"\"\n    if not text or not text.strip():\n        return []\n    \n    reader = csv.reader(io.StringIO(text))\n    rows = []\n    for row in reader:\n        rows.append(row)\n    \n    if not rows:\n        return []\n    \n    # Check for inconsistent row lengths\n    first_length = len(rows[0])\n    for i, row in enumerate(rows):\n        if len(row) != first_length:\n            raise ValueError(\n                f\"Inconsistent row length: row {i} has {len(row)} fields, \"\n                f\"expected {first_length}\"\n            )\n    \n    return rows\n\n\n# Tests\ndef test_parse_csv_basic():\n   ","tg":256,"tg_seconds":5.573986486,"tg_tok_s":45.92763198170409,"tg_tp_ms":{"add":1.4487716562500046,"allreduces":12888,"exchange":2.3636262226562472,"submit":0.023809511718750002,"sum":0.4688314687500004,"total":0.9799401875000009,"wait":17.602911414062532},"tg_window_unix":[1791409670.3077042,1791409675.881691],"token_ids":[71093,12305,198,464,12765,198,464,6198,198,1445,18904,1120,1697,11,11906,1358,727,4563,13617,7008,25,592,8,1411,1697,50246,16793,4891,25,198,262,4071,198,262,14347,26555,1414,440,22513,73982,11,20480,4147,4881,11,198,262,321,7602,37844,2713,27396,13,198,1031,262,17167,25,198,285,1414,25,561,26555,1414,310,4563,13,198,1726,262,5019,25,198,285,357,1103,314,6761,11,1332,1754,2713,369,264,1103,314,886,4881,13,198,1726,262,58276,25,198,285,14953,25,1368,6761,599,37844,27396,13,198,262,4071,198,262,413,524,1414,466,524,1414,16674,4406,198,285,460,2958,198,1031,262,6396,283,12765,33611,36025,6229,3682,7008,578,198,262,6761,283,2958,198,262,364,2713,303,6396,25,198,285,6761,1989,7587,8,198,1031,262,413,524,6761,25,198,285,460,2958,198,1031,262,653,4109,364,37844,2713,27396,198,262,