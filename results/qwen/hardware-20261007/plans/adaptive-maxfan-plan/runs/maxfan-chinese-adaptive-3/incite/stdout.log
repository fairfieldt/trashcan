SQL、Oracle |\n| REPEATABLE READ | ❌ 不可能 | ❌ 不可能 | ✅ 可能 | MySQL (InnoDB) |\n| SERIALIZABLE | ❌ 不可能 | ❌ 不可能 | ❌ 不可能 | — |\n\n> **注意**：MySQL InnoDB 默认是 `REPEATABLE READ`，但通过 MVCC + Next-Key Lock 机制，**实际上避免了幻读**（在大多数常见场景下）。\n\n---\n\n## 二、三种并发异常解释\n\n### 1. 脏","tg":256,"tg_seconds":8.368058735,"tg_tok_s":30.592519496697822,"tg_tp_ms":{"add":1.9155358828124962,"allreduces":22626,"exchange":3.6156742187499633,"submit":0.03899755859374989,"sum":0.6326047382812504,"total":1.2829311445312483,"wait":26.344918496093985},"tg_window_unix":[1791410014.2682843,1791410022.6363432],"token_ids":[2,220,101756,100026,101962,104001,110570,271,550,220,95744,5205,108829,100026,101962,104001,10992,271,95772,104942,111779,3709,98895,100026,97423,99978,101756,95865,3709,121363,96902,117042,98625,1710,6478,220,97427,144124,2972,19,220,96099,101962,104001,332,3709,98618,103751,332,104942,99454,332,95793,332,96902,128523,221794,271,101962,104001,96200,96369,135885,146410,4960,271,91,220,101962,104001,735,220,98362,96451,735,220,97196,108695,96451,735,220,97313,96451,735,220,100095,101756,101908,735,198,91,22031,91,16077,91,17549,91,16077,91,40698,91,198,91,18104,6434,8431,93640,735,189551,220,96539,735,189551,220,96539,735,189551,220,96539,735,1892,735,198,91,18104,80358,32360,735,49684,234,220,108793,735,189551,220,96539,735,189551,220,96539,735,71100,5205,47040,735,198,91,3476,45448,3380,18104,735,49684,234,220,108793,735,49684,234,220,108793,735,189551,220,96539,735,25498,318,623,79400,8,735,198,91,13582,31524,3380,735,49684,234,220,108793,735,49684,234,220,108793,735,49684,234,220,108793,735,1892,735,271,29,2972,97120,332,4960,57221,733,79400,220,101908,95761,1510,762,45448,3380,18104,63,3709,96342,96580,40868,3580,478,9019,91066,15240,220,98853,3709,332,101876,117274,97313,96451,332,9616,95772,101749,99166,100653,95849,71748,271,4277,271,550,220,96053,5205,102218,104942,100016,98682,271,13962,220,16,13,220,98362]}
