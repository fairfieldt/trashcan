#version 460
#include "common.glsl"
layout(local_size_x=256) in;
shared float candidates[1024],vals[256];shared uint ids[256];
void main(){
uint l=gl_LocalInvocationID.x,t=gl_WorkGroupID.y,chunk=gl_WorkGroupID.x;if(t>=batch())return;
uint start=chunk*1024;
for(uint j=l;j<1024;j+=256){float v=start+j<p.n?a_f.v[t*p.n+start+j]:-1e30;uint id=start+j+p.offset;candidates[j]=((p.flags&2)!=0&&(id==p.r0||id==p.r1))?-1e30:((p.flags&1)!=0?30*tanh(v/30):v);}barrier();
for(uint r=0;r<p.k;r++){
    float best=-1e30;uint id=0;
    for(uint j=l;j<1024;j+=256){float v=candidates[j];if(v>best||(v==best&&j<id)){best=v;id=j;}}
    vals[l]=best;ids[l]=id;barrier();
    for(uint step=128;step>0;step/=2){if(l<step && (vals[l+step]>vals[l] || (vals[l+step]==vals[l] && ids[l+step]<ids[l]))){vals[l]=vals[l+step];ids[l]=ids[l+step];}barrier();}
    if(l==0){c_f.v[(t*p.m+chunk*p.k+r)*2]=vals[0];c_u.v[(t*p.m+chunk*p.k+r)*2+1]=start+ids[0]+p.offset;candidates[ids[0]]=-1e30;}barrier();
}}
