#version 460
#define PARTIAL
#include "common.glsl"
layout(local_size_x=64) in;
layout(constant_id=0) const uint parts=32;
void main(){
#ifdef PARTIAL
uint chunk=gl_WorkGroupID.x%parts,head=gl_WorkGroupID.x/parts;
#else
uint head=gl_WorkGroupID.x;
#endif
uint t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x;
if(t>=batch())return;
uint pos=position()+t,start=p.window>0 && pos+1>p.window ? pos+1-p.window:0;
uint end=params_u.v[2]!=0 ? min(pos,params_u.v[2]-1):pos;
#ifdef PARTIAL
uint step=(end-start+parts)/parts;uint lo=start+chunk*step;end=min(end,lo+step-1);start=lo;
#endif
uint kh=head/(p.heads/p.kvheads),qbase=t*p.heads*p.dim+head*p.dim;
// Each lane owns adjacent feature pairs, allowing one packed fp16 load per pair.
float acc[8],q[8];
[[unroll]]for(uint j=0;j<4;j++){
    uint feature=j*128+2*l;
    acc[2*j]=0;acc[2*j+1]=0;
    q[2*j]=feature<p.dim?a_f.v[qbase+feature]:0;
    q[2*j+1]=feature+1<p.dim?a_f.v[qbase+feature+1]:0;
}
float maxs=-1e30,den=0;
for(uint key=start;key<=end;key++){
    uint kb=(key%p.cap)*p.kvheads*p.dim+kh*p.dim;
    float dot=0;
    [[unroll]]for(uint j=0;j<p.dim/128;j++){
        vec2 k=unpackHalf2x16(b_u.v[(kb+j*128+2*l)/2]);
        dot=fma(q[2*j],k.x,dot);
        dot=fma(q[2*j+1],k.y,dot);
    }
    float score=subgroupAdd(dot),nm=max(maxs,score),rescale=exp(maxs-nm),w=exp(score-nm);
    den=den*rescale+w;
    [[unroll]]for(uint j=0;j<p.dim/128;j++){
        vec2 v=unpackHalf2x16(c_u.v[(kb+j*128+2*l)/2]);
        acc[2*j]=fma(w,v.x,acc[2*j]*rescale);
        acc[2*j+1]=fma(w,v.y,acc[2*j+1]*rescale);
    }
    maxs=nm;
}
#ifdef PARTIAL
uint base=((t*p.heads+head)*parts+chunk)*(p.dim+2);
[[unroll]]for(uint j=0;j<p.dim/128;j++){
    e_f.v[base+2+j*128+2*l]=acc[2*j];
    e_f.v[base+2+j*128+2*l+1]=acc[2*j+1];
}
if(l==0){e_f.v[base]=maxs;e_f.v[base+1]=den;}
#else
[[unroll]]for(uint j=0;j<p.dim/128;j++){
    d_f.v[qbase+j*128+2*l]=acc[2*j]/den;
    d_f.v[qbase+j*128+2*l+1]=acc[2*j+1]/den;
}
#endif
}
