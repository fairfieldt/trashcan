#version 460
#include "common.glsl"
layout(binding=0,std430) readonly restrict buffer WeightVectors { uvec4 words4[]; } w4;
// Each lane owns all 32 weights in one block; vector weight load and one scale load.
// Host geometry remains sixteen rows per 256-thread group.
layout(local_size_x=256) in;
void main() {
    uint lane=gl_SubgroupInvocationID;
    uint first=gl_WorkGroupID.x*16+gl_SubgroupID*4, blocks=p.k/32;
    vec4 sums=vec4(0);
    for(uint b=lane;b<blocks;b+=64) {
        uvec4 qs[4]; vec4 scales;
        [[unroll]] for(uint r=0;r<4;r++) {
            uint block=(first+r)*blocks+b;
            scales[r]=uintBitsToFloat(ww.words[block]);
            qs[r]=w4.words4[p.stride/4+block];
        }
        vec4 dots=vec4(0);
        [[unroll]] for(uint part=0;part<4;part++) {
            vec4 x0=b_v4.v[b*8+part],x1=b_v4.v[b*8+part+4];
            [[unroll]] for(uint r=0;r<4;r++)
                dots[r]+=dot(q4_lo(qs[r][part]),x0)+dot(q4_hi(qs[r][part]),x1);
        }
        sums=fma(dots,scales,sums);
    }
    sums=subgroupAdd(sums);
    if(lane==0) [[unroll]] for(uint r=0;r<4;r++)
        if(first+r<p.n)c_f.v[first+r]=sums[r];
}
