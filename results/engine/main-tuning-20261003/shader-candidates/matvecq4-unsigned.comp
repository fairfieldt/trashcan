#version 460
#include "common.glsl"
// Decode unsigned bytes, then share the q4 zero-point correction across rows.
// unpackUnorm4x8 exposes byte-convert operations to the GCN shader compiler.
layout(local_size_x=256) in;
void main() {
    uint lane=gl_SubgroupInvocationID;
    uint first=gl_WorkGroupID.x*16+gl_SubgroupID*4, part=lane%4, blocks=p.k/32;
    vec4 sums=vec4(0);
    for(uint b=lane/4;b<blocks;b+=16) {
        vec4 x0=b_v4.v[b*8+part],x1=b_v4.v[b*8+part+4];
        float bias=8.0*dot(x0+x1,vec4(1));
        [[unroll]] for(uint r=0;r<4;r++) {
            uint block=(first+r)*blocks+b;
            float scale=uintBitsToFloat(ww.words[block]);
            uint qs=ww.words[p.stride+block*4+part];
            vec4 lo=unpackUnorm4x8(qs&0x0f0f0f0fu)*255.0;
            vec4 hi=unpackUnorm4x8((qs>>4)&0x0f0f0f0fu)*255.0;
            sums[r]=fma(dot(lo,x0)+dot(hi,x1)-bias,scale,sums[r]);
        }
    }
    sums=subgroupAdd(sums);
    if(lane==0) [[unroll]] for(uint r=0;r<4;r++)
        if(first+r<p.n)c_f.v[first+r]=sums[r];
}
