--- a/engine/src/model.rs
+++ b/engine/src/model.rs
@@ -1150,6 +1150,38 @@
     }
     pub fn set_top_k(&mut self, k: usize) -> Result<()> {
         ensure!((1..=64).contains(&k), "top-k must be in 1..64");
+        if k != self.top_k
+            && std::env::var("TRASHCAN_CLEAR_GRAPHS_ON_TOP_K_SWITCH").as_deref() == Ok("1")
+        {
+            let started = std::time::Instant::now();
+            let keys = self.graphs.len();
+            let commands: usize = self
+                .graphs
+                .values()
+                .flat_map(|graphs| graphs.iter())
+                .map(|graph| graph.cmds.len())
+                .sum();
+            // Diagnostic only: keep all model buffers and timeline values intact.
+            // Graph has no Drop, so explicitly free commands before dropping captures.
+            for c in &self.cards {
+                unsafe {
+                    c.gpu.dev.device_wait_idle()?;
+                }
+            }
+            for (g, c) in self.cards.iter().enumerate() {
+                for graphs in self.graphs.values() {
+                    unsafe {
+                        c.gpu.dev.free_command_buffers(c.gpu.pool, &graphs[g].cmds);
+                    }
+                }
+            }
+            self.graphs.clear();
+            eprintln!(
+                "diagnostic cache clear: top_k {} -> {}, graph_keys {}, command_buffers {}, remaining_keys {}, elapsed_ms {:.3}",
+                self.top_k, k, keys, commands, self.graphs.len(),
+                started.elapsed().as_secs_f64() * 1e3
+            );
+        }
         self.top_k = k;
         Ok(())
     }
