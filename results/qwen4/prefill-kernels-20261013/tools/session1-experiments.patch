diff --git a/engine/shaders/qwen4_q8_gemm_s.comp b/engine/shaders/qwen4_q8_gemm_s.comp
new file mode 100644
index 0000000..aa0bca3
--- /dev/null
+++ b/engine/shaders/qwen4_q8_gemm_s.comp
@@ -0,0 +1,70 @@
+#version 460
+#include "common.glsl"
+// Q8_0 matrix times a batch for prefill chunks, lanes own rows: a 64-lane workgroup owns 64 R rows (lane l: rows
+// 64 r + l) and T tokens. Each lane walks its rows along K, decoding every weight once for the T tokens, whose inputs
+// are the same for every lane (scalar loads, SGPR operands of the multiply-adds), so neither weights nor inputs pass
+// through LDS. Each lane loads whole 64-byte lines (two blocks) of its rows (with PF, one step ahead). The products
+// (q * d, exact) and their order (k ascending per output) are qwen4_q8_gemm's. With p.m > 0 the K range is split in
+// p.m parts (multiples of 64): workgroup y covers row block y % blocks of part y / blocks and writes its partial sums
+// to c [part][t][n].
+// b: x [t][k], c: y [t][n]. p.n rows, p.k columns (a multiple of 64), p.stride = word offset of the quants
+// (quant::repack_q8h). Specialization constant: T | R << 8 | PF << 12; gl_WorkGroupID.x is the token tile.
+layout(constant_id=0) const uint CFG=16|1<<8|1<<12;
+const uint T=CFG&255u,R=(CFG>>8)&15u,PF=(CFG>>12)&1u,ROWFIRST=(CFG>>13)&1u,DIAG=(CFG>>14)&1u,MIX=(CFG>>15)&1u;
+layout(local_size_x=64) in;
+layout(binding=0,std430) readonly restrict buffer WeightQuads { uvec4 q[]; } wq;
+layout(binding=0,std430) readonly restrict buffer WeightScales { uint s[]; } ws;
+// Arrays sized for the largest configuration; the unrolled loops leave the rest unused.
+float acc[4][32];
+uint xs[32];
+void main(){
+    // MIX (qwen4_q8_gemm_mix's up projection, R = 4): lane l's rows are the 4 streams' rows of element i, 64 r
+    // apart in the row block become p.n / 4 apart.
+    uint nb=batch(),lane=gl_LocalInvocationID.x,dd=p.n/4,rblocks=MIX==1?dd/64:(p.n+64*R-1)/(64*R);
+    uvec2 wg=ROWFIRST==1?gl_WorkGroupID.yx:gl_WorkGroupID.xy;
+    uint part=wg.y/rblocks,row0=(wg.y%rblocks)*64*(MIX==1?1:R)+lane,tok0=wg.x*T,rs=MIX==1?dd:64;
+    uint blocks=p.k/32,kc=(p.m==0?p.k:p.k/p.m)/32,b0=part*kc,b1=b0+kc;
+    [[unroll]]for(uint t=0;t<T;t++){xs[t]=DIAG==1?t*16:min(tok0+t,nb-1)*(p.k/4);[[unroll]]for(uint r=0;r<R;r++)acc[r][t]=0;}
+    // Each row's quants as uvec4 (two per block) and its f16 scales as pairs (blocks is even).
+    uint qa[4],sa[4];
+    [[unroll]]for(uint r=0;r<R;r++){uint rr=min(row0+rs*r,p.n-1);qa[r]=p.stride/4+rr*blocks*2;sa[r]=rr*blocks/2;}
+    uvec4 nq[4][4];uint ns[4];
+    if(PF==1)[[unroll]]for(uint r=0;r<R;r++){[[unroll]]for(uint j=0;j<4;j++)nq[r][j]=wq.q[qa[r]+2*b0+j];ns[r]=ws.s[sa[r]+b0/2];}
+    for(uint b=b0;b<b1;b+=2){
+        uvec4 q[4][4];vec2 d[4];
+        if(PF==1){
+            [[unroll]]for(uint r=0;r<R;r++){[[unroll]]for(uint j=0;j<4;j++)q[r][j]=nq[r][j];d[r]=unpackHalf2x16(ns[r]);}
+            // The next line, loaded unconditionally (the last step reloads its own).
+            uint nx=min(b+2,b1-2);
+            [[unroll]]for(uint r=0;r<R;r++){[[unroll]]for(uint j=0;j<4;j++)nq[r][j]=wq.q[qa[r]+2*nx+j];ns[r]=ws.s[sa[r]+nx/2];}
+        }else{
+            [[unroll]]for(uint r=0;r<R;r++){[[unroll]]for(uint j=0;j<4;j++)q[r][j]=wq.q[qa[r]+2*b+j];d[r]=unpackHalf2x16(ws.s[sa[r]+b/2]);}
+        }
+        // 16 groups of 4 k: block b words 0-7, then block b + 1 words 0-7.
+        [[unroll]]for(uint g=0;g<16;g++){
+            precise vec4 f[4];
+            [[unroll]]for(uint r=0;r<R;r++){
+                float dd=g<8?d[r].x:d[r].y;
+                // (q + 128) as an unsigned byte (one conversion); fma(q + 128, d, -128 d) = q d exactly.
+                uint u=q[r][g/4][g%4]^0x80808080u;
+                f[r]=fma(vec4(u&255u,(u>>8)&255u,(u>>16)&255u,u>>24),vec4(dd),vec4(-128.0*dd));
+            }
+            [[unroll]]for(uint t=0;t<T;t++){
+                vec4 x=b_v4.v[xs[t]+(DIAG==1?g:b*8+g)];
+                [[unroll]]for(uint r=0;r<R;r++){
+                    acc[r][t]=fma(f[r].x,x.x,acc[r][t]);acc[r][t]=fma(f[r].y,x.y,acc[r][t]);
+                    acc[r][t]=fma(f[r].z,x.z,acc[r][t]);acc[r][t]=fma(f[r].w,x.w,acc[r][t]);
+                }
+            }
+        }
+    }
+    if(MIX==1){
+        // u = mean_s xn_s sigmoid(g_s) (qwen4_hc_mix); d: xn [t][4][dd], c: u [t][dd].
+        [[unroll]]for(uint t=0;t<T;t++)if(tok0+t<nb){uint base=(tok0+t)*p.n+row0;float u=0;
+            [[unroll]]for(uint r=0;r<4;r++)u=fma(d_f.v[base+r*dd],1.0/(1.0+exp(-acc[r][t])),u);
+            c_f.v[(tok0+t)*dd+row0]=u/4.0;}
+        return;
+    }
+    [[unroll]]for(uint r=0;r<R;r++)if(row0+64*r<p.n)[[unroll]]for(uint t=0;t<T;t++)
+        if(tok0+t<nb)c_f.v[(part*nb+tok0+t)*p.n+row0+64*r]=acc[r][t];
+}
diff --git a/engine/shaders/qwen4_q8_gemm_t.comp b/engine/shaders/qwen4_q8_gemm_t.comp
new file mode 100644
index 0000000..74c916d
--- /dev/null
+++ b/engine/shaders/qwen4_q8_gemm_t.comp
@@ -0,0 +1,55 @@
+#version 460
+#include "common.glsl"
+// Q8_0 matrix times a batch for prefill chunks of 64 or more tokens, register-blocked: each of the 256 threads
+// accumulates RT rows x TT tokens (rows tr + TR i, tokens tc + TC j), so every operand read from LDS feeds RT or TT
+// multiply-adds (qwen4_q8_gemm's 4 x 4 per thread reads one operand per 2 multiply-adds, which saturates the LDS).
+// A workgroup covers TR RT rows and TC TT tokens (TR TC = 256) in K chunks of KC: the threads decode the chunk's
+// weights (q d, exact) and copy the inputs into LDS, then each reads its operands two k at a time. Products and
+// their order (k ascending per output) are qwen4_q8_gemm's, so the results are the same bits. With p.m > 0 the K
+// range is split in p.m parts (multiples of KC): workgroup x covers row tile x % tiles of part x / tiles and writes
+// its partial sums to c [part][t][n].
+// b: x [t][k], c: y [t][n]. p.n rows, p.k columns, p.stride = word offset of the quants (quant::repack_q8h).
+// Specialization constant: RT | TT << 4 | TR << 8 | KC << 16.
+layout(constant_id=0) const uint CFG=8|4<<4|16<<8|32<<16;
+const uint RT=CFG&15u,TT=(CFG>>4)&15u,TR=(CFG>>8)&255u,TC=256u/TR,KC=CFG>>16,WR=TR*RT,WT=TC*TT,KV=KC/4;
+layout(local_size_x=256) in;
+layout(binding=0,std430) readonly restrict buffer WeightPairs { uvec2 q[]; } wq;
+// Rows and tokens of the chunk as vec4 (4 k), padded by one vec4 against bank conflicts.
+shared vec4 lw[WR][KV+1],lx[WT][KV+1];
+float acc[8][8];
+void main(){
+    uint nb=batch(),l=gl_LocalInvocationID.x,tr=l/TC,tc=l%TC;
+    uint tiles=(p.n+WR-1)/WR,part=gl_WorkGroupID.x/tiles,row0=(gl_WorkGroupID.x%tiles)*WR,tok0=gl_WorkGroupID.y*WT;
+    uint kc=p.m==0?p.k:p.k/p.m,k0=part*kc,blocks=p.k/32;
+    [[unroll]]for(uint i=0;i<RT;i++)[[unroll]]for(uint j=0;j<TT;j++)acc[i][j]=0;
+    // Staging: each thread decodes WP pairs of words (8 weights each) and copies XV input vec4 per chunk.
+    const uint WP=WR*KC/8/256,XV=WT*KV/256;
+    for(uint k=k0;k<k0+kc;k+=KC){
+        uvec2 w[4];float d[4];vec4 xv[4];
+        [[unroll]]for(uint s=0;s<WP;s++){
+            uint e=s*256+l,row=min(row0+e/(KC/8),p.n-1),kk=k+(e%(KC/8))*8,blk=row*blocks+kk/32;
+            w[s]=wq.q[p.stride/2+blk*4+(kk%32)/8];d[s]=unpackHalf2x16(uint(wh.halves[blk])).x;
+        }
+        [[unroll]]for(uint s=0;s<XV;s++){uint e=s*256+l;xv[s]=b_v4.v[min(tok0+e/KV,nb-1)*(p.k/4)+k/4+e%KV];}
+        barrier();
+        [[unroll]]for(uint s=0;s<WP;s++){
+            uint e=s*256+l,rr=e/(KC/8),c=(e%(KC/8))*2;
+            // (q + 128) as an unsigned byte; fma(q + 128, d, -128 d) = q d exactly.
+            uint u0=w[s].x^0x80808080u,u1=w[s].y^0x80808080u;
+            precise vec4 f0=fma(vec4(u0&255u,(u0>>8)&255u,(u0>>16)&255u,u0>>24),vec4(d[s]),vec4(-128.0*d[s]));
+            precise vec4 f1=fma(vec4(u1&255u,(u1>>8)&255u,(u1>>16)&255u,u1>>24),vec4(d[s]),vec4(-128.0*d[s]));
+            lw[rr][c]=f0;lw[rr][c+1]=f1;
+        }
+        [[unroll]]for(uint s=0;s<XV;s++){uint e=s*256+l;lx[e/KV][e%KV]=xv[s];}
+        barrier();
+        [[unroll]]for(uint g=0;g<KV;g++)[[unroll]]for(uint h=0;h<2;h++){
+            vec2 a[8],x[8];
+            [[unroll]]for(uint i=0;i<RT;i++)a[i]=h==0?lw[tr+TR*i][g].xy:lw[tr+TR*i][g].zw;
+            [[unroll]]for(uint j=0;j<TT;j++)x[j]=h==0?lx[tc+TC*j][g].xy:lx[tc+TC*j][g].zw;
+            [[unroll]]for(uint v=0;v<2;v++)[[unroll]]for(uint i=0;i<RT;i++)[[unroll]]for(uint j=0;j<TT;j++)
+                acc[i][j]=fma(a[i][v],x[j][v],acc[i][j]);
+        }
+    }
+    [[unroll]]for(uint j=0;j<TT;j++){uint t=tok0+tc+TC*j;if(t<nb)[[unroll]]for(uint i=0;i<RT;i++){
+        uint row=row0+tr+TR*i;if(row<p.n)c_f.v[(part*nb+t)*p.n+row]=acc[i][j];}}
+}
diff --git a/engine/shaders/qwen4_sum_parts.comp b/engine/shaders/qwen4_sum_parts.comp
new file mode 100644
index 0000000..544e2a0
--- /dev/null
+++ b/engine/shaders/qwen4_sum_parts.comp
@@ -0,0 +1,7 @@
+#version 460
+#include "common.glsl"
+// Sum the K-split partial products of a prefill GEMM in part order: c[t][i] = sum_p a[p][t][i].
+// a: partials [p.k][t][p.n], c: y [t][p.n]. p.n rows, p.k parts.
+layout(local_size_x=256) in;
+void main(){uint i=gl_GlobalInvocationID.x,t=gl_WorkGroupID.y,nb=batch();if(i>=p.n||t>=nb)return;
+float s=a_f.v[t*p.n+i];for(uint q=1;q<p.k;q++)s+=a_f.v[(q*nb+t)*p.n+i];c_f.v[t*p.n+i]=s;}
diff --git a/engine/src/micro.rs b/engine/src/micro.rs
index 637ab76..28cd1a0 100644
--- a/engine/src/micro.rs
+++ b/engine/src/micro.rs
@@ -776,6 +776,30 @@ pub fn selection(iterations: u32, batch: usize) -> Result<()> {
 /// Q4_0 GEMM kernels (`gemm` and its variants) at (rows, k) shapes for `n` tokens on GPU `gpu`, random weights
 /// and activations: milliseconds and TFLOP/s per call, and every variant's output checked bit for bit against
 /// `gemm`. One JSON line per shape and kernel.
+/// Workgroups of a GEMM kernel: the 64 x 64 tiled kernels, or `qwen4_q8_gemm_sTrR[p]` (64 R rows by T tokens, the
+/// token tile first), each times `parts` K splits.
+fn gemm_groups(kernel: &str, rows: usize, n: usize, parts: usize) -> (usize, usize) {
+    let parts = parts.max(1);
+    let tr = kernel.strip_prefix("qwen4_q8_gemm_s").and_then(|c| {
+        let (t, r) = c.trim_end_matches(['p', 'o', 'd', 'm']).split_once('r')?;
+        Some((t.parse::<usize>().ok()?, r.parse::<usize>().ok()?, c.contains('o')))
+    });
+    // qwen4_q8_gemm_tRxT_...: R rows by T tokens per workgroup.
+    let tiled = kernel.strip_prefix("qwen4_q8_gemm_t").and_then(|c| {
+        let (r, rest) = c.split_once('x')?;
+        Some((r.parse::<usize>().ok()?, rest.split_once('_')?.0.parse::<usize>().ok()?))
+    });
+    if let Some((r, t)) = tiled {
+        return (rows.div_ceil(r) * parts, n.div_ceil(t));
+    }
+    match tr {
+        Some((t, r, false)) => (n.div_ceil(t), rows.div_ceil(64 * r) * parts),
+        Some((t, r, true)) => (rows.div_ceil(64 * r) * parts, n.div_ceil(t)),
+        None => (rows.div_ceil(64) * parts, n.div_ceil(64)),
+    }
+}
+
+/// Kernels named `qwen4_q8_*` read random Q8_0 weights (`quant::repack_q8h`), the others Q4_0; `KERNEL:PARTS` splits K.
 pub fn gemm(shapes: &[(usize, usize)], n: usize, kernels: &[String], iterations: u32, gpu: usize, warmup_ms: u64) -> Result<()> {
     ensure!(iterations > 0 && n > 0, "positive iterations and tokens");
