+            if(C<=4){
+                g0=ng0;g1=ng1;g2=ng2;g3=ng3;u0=nu0;u1=nu1;u2=nu2;u3=nu3;
+                uint nx=min(b+4,blocks-4),a=p.stride/4+rg+nx,c=p.stride/4+ru+nx;
+                ng0=wq.q[a];ng1=wq.q[a+1];ng2=wq.q[a+2];ng3=wq.q[a+3];nu0=wq.q[c];nu1=wq.q[c+1];nu2=wq.q[c+2];nu3=wq.q[c+3];
+            }else{
+                uint a=p.stride/4+rg+b,c=p.stride/4+ru+b;
+                g0=wq.q[a];g1=wq.q[a+1];g2=wq.q[a+2];g3=wq.q[a+3];u0=wq.q[c];u1=wq.q[c+1];u2=wq.q[c+2];u3=wq.q[c+3];
+            }
             if(FMT!=2){hg=wp.h[(rg+b)>>2];hu=wp.h[(ru+b)>>2];}
         }
         if(FMT==2&&(b&7u)==0){hg=wp.h[(rg+b)>>3];hu=wp.h[(ru+b)>>3];}
diff --git a/engine/shaders/qwen4_moe_gu_tiles_vx.comp b/engine/shaders/qwen4_moe_gu_tiles_vx.comp
new file mode 100644
index 0000000..5075724
--- /dev/null
+++ b/engine/shaders/qwen4_moe_gu_tiles_vx.comp
@@ -0,0 +1,83 @@
+#version 460
+#include "common.glsl"
+#include "qwen4_expert.glsl"
+// Gate and up projections with SwiGLU for prefill, grouped by expert: one workgroup per 128 rows of one tile (up to
+// TILE slots routed to one expert, from qwen4_moe_tiles). Each lane owns gate row i and up row i of the expert and
+// walks them whole, so every weight is decoded once for all of the tile's slots; the slots' inputs are the same for
+// every lane (scalar loads) and no sums cross lanes. A lane loads 4 blocks (a 64-byte line) of a row at once: rows
+// are 1280 bytes apart, and loading block by block fetched each line up to four times. One copy of the walk per slot
+// count keeps the slot loop free of branches. Weights as in qwen4_moe_gu; p.k a multiple of 256.
+// b: u [t][k], c: act [t * slots][ff], d: tiles, e: list (qwen4_moe_tiles).
+// p.n = ff, p.k = d, p.stride = word offset of the blocks.
+#define TILE 8
+layout(local_size_x=128) in;
+layout(binding=0,std430) readonly restrict buffer WeightQuads { uvec4 q[]; } wq;
+layout(binding=0,std430) readonly restrict buffer WeightPairs { uvec2 h[]; } wp;
+// EXPERIMENT: the slots' inputs through a writable view of binding 1 (vector loads) for tiles of up to 4 slots.
+layout(set=2,binding=1,std430) buffer InputsV { vec4 v[]; } bx;
+uint slot[TILE],xb[TILE],rg,ru,ri;
+// Block ib's scale from an IQ4_XS header, or from 4 f16 scales (Q4_0, IQ4_NL).
+float scale(uvec2 h,uint ib){
+    if(FMT==2){
+        uint ls=((h.y>>(4u*ib))&15u)|(((h.x>>(16u+2u*ib))&3u)<<4);
+        return unpackHalf2x16(h.x).x*float(int(ls)-32);
+    }
+    return unpackHalf2x16(ib<2?h.x>>(16u*ib):h.y>>(16u*(ib-2))).x;
+}
+void walk(const uint C){
+    uint blocks=p.k/32;
+    float g[TILE],u[TILE];
+    [[unroll]]for(uint t=0;t<C;t++){g[t]=0;u[t]=0;}
+    uvec4 g0,g1,g2,g3,u0,u1,u2,u3;
+    uvec2 hg,hu;
+    // Up to 4 slots the registers of the 8-slot walk leave room to load the next line of each row while this one is
+    // used (the last group reloads its own).
+    uvec4 ng0,ng1,ng2,ng3,nu0,nu1,nu2,nu3;
+    if(C<=4){uint a=p.stride/4+rg,c=p.stride/4+ru;
+        ng0=wq.q[a];ng1=wq.q[a+1];ng2=wq.q[a+2];ng3=wq.q[a+3];nu0=wq.q[c];nu1=wq.q[c+1];nu2=wq.q[c+2];nu3=wq.q[c+3];}
+    for(uint b=0;b<blocks;b++){
+        if((b&3u)==0){
+            if(C<=4){
+                g0=ng0;g1=ng1;g2=ng2;g3=ng3;u0=nu0;u1=nu1;u2=nu2;u3=nu3;
+                uint nx=min(b+4,blocks-4),a=p.stride/4+rg+nx,c=p.stride/4+ru+nx;
+                ng0=wq.q[a];ng1=wq.q[a+1];ng2=wq.q[a+2];ng3=wq.q[a+3];nu0=wq.q[c];nu1=wq.q[c+1];nu2=wq.q[c+2];nu3=wq.q[c+3];
+            }else{
