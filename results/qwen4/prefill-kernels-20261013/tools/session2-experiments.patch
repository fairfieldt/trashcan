+    }
+    [[unroll]]for(uint r=0;r<R;r++)if(row0+64*r<p.n)[[unroll]]for(uint t=0;t<T;t++)
+        if(tok0+t<nb)c_f.v[(part*nb+tok0+t)*p.n+row0+64*r]=acc[r][t];
+}
