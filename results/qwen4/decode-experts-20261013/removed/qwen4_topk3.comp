// Session 5 (removed): qwen4_topk with 8 keys per lane at compile time and compaction without branches (lanes
// not picked write to slots 64..127), plus the timing probes of the x build (p.flags 1/2/4/8: return after the
// loads, the maximum, the probabilities, the threshold). 28.7 against 31.6 us at 1 token, 28.8 against 29.9 at 3.
#version 460
#include "common.glsl"
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
// MoE router: softmax over p.n expert logits, the p.m best (ties to the lower id) renormalized over their sum
// (at least 2^-14, as ggml clamps it), then the shared expert as one more slot with weight sigmoid(logit p.n).
// One wave per token. a: logits [t][p.n + 1] (p.k > 1: [p.k][t][p.n + 1], the parts of qwen4_router_gemm, added in
// order and the sum kept in part 0), c: ids [t][p.m + 1] (u32), d: weights [t][p.m + 1].
// A single wave waits on every memory access, cross-lane step and instruction fetch on the D700, so the picks avoid
// p.m rounds of wave-wide maximum and minimum: the p.m-th largest lane maximum t0 (a radix select over one key per
// lane, counted with ballots) bounds the picks from below, the probabilities >= t0 (at least p.m, usually a few more)
// go to shared memory in id order and lanes rank them by (probability, id); more than 64 of them fall back to an
// exact radix select over all keys. The same probabilities, picks, order and sum as taking the maximum p.m times.
// Up to 512 experts and 64 picks.
layout(local_size_x=64) in;
shared uint sid[128],sk[128];
void main(){uint t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x;if(t>=batch())return;
uint row=t*(p.n+1),slots=p.m+1,K=p.m;const uint per=8;float v[8];float mx=-1e30;
[[unroll]]for(uint j=0;j<8;j++)v[j]=a_f.v[row+min(j,per-1)*64+l];
float gate=a_f.v[row+p.n];
if((p.flags&1u)!=0){float z=gate;[[unroll]]for(uint j=0;j<8;j++)z+=v[j];if(l==0)d_f.v[t*slots]=z;return;}
uint parts=max(p.k,1u),ps=batch()*(p.n+1);
for(uint s=1;s<parts;s++){[[unroll]]for(uint j=0;j<8;j++)v[j]+=a_f.v[s*ps+row+min(j,per-1)*64+l];gate+=a_f.v[s*ps+row+p.n];}
if(parts>1){[[unroll]]for(uint j=0;j<8;j++)if(j<per)a_f.v[row+j*64+l]=v[j];if(l==0)a_f.v[row+p.n]=gate;}
[[unroll]]for(uint j=0;j<8;j++){v[j]=j<per?v[j]:-1e30;mx=max(mx,v[j]);}
mx=subgroupMax(mx);float sum=0;
if((p.flags&2u)!=0){if(l==0)d_f.v[t*slots]=mx;return;}
[[unroll]]for(uint j=0;j<8;j++){v[j]=j<per?exp(v[j]-mx):-1.0;sum+=max(v[j],0.0);}
sum=subgroupAdd(sum);
[[unroll]]for(uint j=0;j<8;j++)if(j<per)v[j]/=sum;
if((p.flags&4u)!=0){if(l==0)d_f.v[t*slots]=v[0];return;}
uint u[8],mk=0;
[[unroll]]for(uint j=0;j<8;j++){u[j]=j<per?floatBitsToUint(v[j])+1u:0u;mk=max(mk,u[j]);}
uint thr=0;
for(int bit=31;bit>=0;bit--){uint cand=thr|(1u<<bit);if(subgroupBallotBitCount(subgroupBallot(mk>=cand))>=K)thr=cand;}
if((p.flags&8u)!=0){if(l==0)c_u.v[t*slots]=thr;return;}
uint cnt=0;
[[unroll]]for(uint j=0;j<8;j++)cnt+=subgroupBallotBitCount(subgroupBallot(u[j]>=thr));
uint budget=64;
if(cnt>64){thr=0;
    for(int bit=31;bit>=0;bit--){uint cand=thr|(1u<<bit),c=0;
        [[unroll]]for(uint j=0;j<8;j++)c+=subgroupBallotBitCount(subgroupBallot(u[j]>=cand));
        if(c>=K)thr=cand;}
    uint gt=0;
    [[unroll]]for(uint j=0;j<8;j++)gt+=subgroupBallotBitCount(subgroupBallot(u[j]>thr));
    budget=K-gt;}
uint before=0,pos=0;
[[unroll]]for(uint j=0;j<8;j++){uvec4 eq=subgroupBallot(u[j]==thr);
    bool s=u[j]>thr||(u[j]==thr&&before+subgroupBallotExclusiveBitCount(eq)<budget);
    before+=subgroupBallotBitCount(eq);
    uvec4 b=subgroupBallot(s);
    uint k=s?pos+subgroupBallotExclusiveBitCount(b):64+l;sid[k]=j*64+l;sk[k]=u[j];
    pos+=subgroupBallotBitCount(b);}
barrier();
uint me=l<pos?sk[l]:0u,id=l<pos?sid[l]:0u,r=0;
for(uint i=0;i<pos;i++){uint o=subgroupShuffle(me,i);r+=o>me||(o==me&&i<l)?1u:0u;}
if(l>=pos)r=64;
float val=uintBitsToFloat(me-1u),tot=0;
for(uint k=0;k<K;k++)tot+=subgroupShuffle(val,subgroupBallotFindLSB(subgroupBallot(r==k)));
tot=max(tot,6.103515625e-5);
if(r<K){c_u.v[t*slots+r]=id;d_f.v[t*slots+r]=val/tot;}
if(l==0){c_u.v[t*slots+p.m]=p.n;d_f.v[t*slots+p.m]=1.0/(1.0+exp(-gate));}}
