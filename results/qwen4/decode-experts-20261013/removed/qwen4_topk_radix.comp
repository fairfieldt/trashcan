#version 460
#include "common.glsl"
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
// MoE router: softmax over p.n expert logits, the p.m best (ties to the lower id) renormalized over their sum
// (at least 2^-14, as ggml clamps it), then the shared expert as one more slot with weight sigmoid(logit p.n).
// One wave per token. a: logits [t][p.n + 1] (p.k > 1: [p.k][t][p.n + 1]), c: ids [t][p.m + 1] (u32),
// d: weights [t][p.m + 1].
// On the D700 a single wave waits on every memory access, cross-lane step and instruction fetch (the caches are cold
// after each barrier), so the picks avoid reductions and the code stays small: a radix select over the
// probabilities' bits counts with ballots (scalar popcounts) to find the p.m-th largest, ties to the lower id take
// the remaining picks, and lanes 0 .. p.m - 1 rank the picks by (probability, id) with lane reads. The same
// probabilities, picks, order and sum as taking the maximum p.m times. Up to 512 experts and 64 picks.
layout(local_size_x=64) in;
shared uint sid[64];
shared float sv[64];
void main(){uint t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x;if(t>=batch())return;
uint row=t*(p.n+1),per=p.n/64,slots=p.m+1,K=p.m;float v[8];float mx=-1e30;
[[unroll]]for(uint j=0;j<8;j++)v[j]=a_f.v[row+min(j,per-1)*64+l];
float gate=a_f.v[row+p.n];
// Prefill logits come in p.k parts of the K range (qwen4_router_gemm): add them in order and keep the sum in part 0.
uint parts=max(p.k,1u),ps=batch()*(p.n+1);
for(uint s=1;s<parts;s++){[[unroll]]for(uint j=0;j<8;j++)v[j]+=a_f.v[s*ps+row+min(j,per-1)*64+l];gate+=a_f.v[s*ps+row+p.n];}
if(parts>1){[[unroll]]for(uint j=0;j<8;j++)if(j<per)a_f.v[row+j*64+l]=v[j];if(l==0)a_f.v[row+p.n]=gate;}
[[unroll]]for(uint j=0;j<8;j++){v[j]=j<per?v[j]:-1e30;mx=max(mx,v[j]);}
mx=subgroupMax(mx);float sum=0;
[[unroll]]for(uint j=0;j<8;j++){v[j]=j<per?exp(v[j]-mx):-1.0;sum+=max(v[j],0.0);}
sum=subgroupAdd(sum);
[[unroll]]for(uint j=0;j<8;j++)if(j<per)v[j]/=sum;
// Probabilities are >= 0, so their bits order as unsigned integers; + 1 keeps the padding (0) below every one.
uint u[8];
[[unroll]]for(uint j=0;j<8;j++)u[j]=j<per?floatBitsToUint(v[j])+1u:0u;
// thr: the K-th largest key (at least K keys >= thr, fewer than K above it).
uint thr=0;
for(int bit=31;bit>=0;bit--){uint cand=thr|(1u<<bit),cnt=0;
    [[unroll]]for(uint j=0;j<8;j++)cnt+=subgroupBallotBitCount(subgroupBallot(u[j]>=cand));
    if(cnt>=K)thr=cand;}
uint gt=0;
[[unroll]]for(uint j=0;j<8;j++)gt+=subgroupBallotBitCount(subgroupBallot(u[j]>thr));
// Keys equal to thr in id order (id = j * 64 + l) fill the K - gt remaining picks; the picks go to shared memory in
// id order.
uint before=0,pos=0;
[[unroll]]for(uint j=0;j<8;j++){uvec4 eq=subgroupBallot(u[j]==thr);
    bool s=u[j]>thr||(u[j]==thr&&before+subgroupBallotExclusiveBitCount(eq)<K-gt);
    before+=subgroupBallotBitCount(eq);
    uvec4 b=subgroupBallot(s);
    if(s){uint k=pos+subgroupBallotExclusiveBitCount(b);sid[k]=j*64+l;sv[k]=v[j];}
    pos+=subgroupBallotBitCount(b);}
barrier();
// Lane l < K holds pick l (id order); its slot r counts the picks with a larger probability or an equal one and a
// lower id.
float me=l<K?sv[l]:-1.0;
uint id=l<K?sid[l]:0u,r=l<K?0u:64u;
for(uint i=0;i<K;i++){float o=subgroupShuffle(me,i);r+=o>me||(o==me&&i<l)?1u:0u;}
// Their sum in slot order.
float tot=0;
for(uint k=0;k<K;k++)tot+=subgroupShuffle(me,subgroupBallotFindLSB(subgroupBallot(r==k)));
tot=max(tot,6.103515625e-5);
if(l<K){c_u.v[t*slots+r]=id;d_f.v[t*slots+r]=me/tot;}
if(l==0){c_u.v[t*slots+p.m]=p.n;d_f.v[t*slots+p.m]=1.0/(1.0+exp(-gate));}}
