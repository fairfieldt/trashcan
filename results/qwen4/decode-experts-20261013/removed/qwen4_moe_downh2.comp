#version 460
#include "common.glsl"
#include "qwen4_expert.glsl"
// qwen4_moe_downh with two rows per loop step (the next row's loads go to the other register set, no copies) and
// incremented load indices. R rows per workgroup (even).
#ifndef R
#define R 8
#endif
#define HB 40
#define NL 448
#define TP (NL / R)
layout(local_size_x=NL) in;
layout(binding=0,std430) readonly restrict buffer WeightU2 { uvec2 v[]; } ww2;
shared float red[R][NL + TP];
shared float red2[R][TP];
vec4 xa0,xa1,xb0,xb1;
float term(uvec2 q,uint sh,float wt){
    float d=dot(qlo(q.x),xa0)+dot(qlo(q.y),xa1)+dot(qhi(q.x),xb0)+dot(qhi(q.y),xb1);
    return d*(unpackHalf2x16(sh).x*wt);
}
void main(){
init_lut();
uint l=gl_LocalInvocationID.x,t=gl_WorkGroupID.y;
if(t>=batch())return;
bool on=l<p.m*HB;
uint s=min(l/HB,p.m-1),hb=l%HB,b=hb/2,h=hb%2,blocks=p.k/32;
uint e=d_u.v[t*p.m+s];
float wt=on?e_f.v[t*p.m+s]:0.0;
uint x4=(t*p.m+s)*(p.k/4)+b*8+2*h;
xa0=b_v4.v[x4];xa1=b_v4.v[x4+1];xb0=b_v4.v[x4+4];xb1=b_v4.v[x4+5];
uint r0=gl_WorkGroupID.x*R;
uint blk=(e*p.n+r0)*blocks+b,iq=p.stride/2+blk*2+h;
uvec2 q0=ww2.v[iq],q1;
uint s0=uint(wh.halves[blk]),s1;
[[dont_unroll]]for(uint j=0;j<R;j+=2){
    q1=ww2.v[iq+2*blocks];s1=uint(wh.halves[blk+blocks]);
    red[j][l]=term(q0,s0,wt);
    if(j+2<R){iq+=4*blocks;blk+=2*blocks;q0=ww2.v[iq];s0=uint(wh.halves[blk]);}
    red[j+1][l]=term(q1,s1,wt);
}
barrier();
uint j=l/TP,part=l%TP;
float a=0;
[[unroll]]for(uint i=0;i<R;i++)a+=red[j][part+TP*i];
red2[j][part]=a;
barrier();
if(l<R&&r0+l<p.n){float v=0;
    [[unroll]]for(uint i=0;i<TP;i++)v+=red2[l][i];
    c_f.v[t*p.n+r0+l]=v;}
}
