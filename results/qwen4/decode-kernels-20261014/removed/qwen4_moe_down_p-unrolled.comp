#version 460
#include "common.glsl"
#include "qwen4_expert.glsl"
// EXPERIMENT: qwen4_moe_down_w with 5 rows per wave (512 waves for d = 2560: one round at 4 waves per SIMD) and its
// 7 steps (up to 11 slots) unrolled without branches, so that the compiler can issue a step's loads while the step
// before is multiplied. The expert ids and routing weights are staged in LDS. Same per-lane sums in the same order
// (the same bits).
#define BLOCKS 20
#define R 5
#define STEPS 7
layout(local_size_x=256) in;
layout(binding=0,std430) readonly restrict buffer WeightU2 { uvec2 v[]; } ww2;
shared uint sid[16];
shared float swt[16];
void main(){
uint tid=gl_LocalInvocationID.x,t=gl_WorkGroupID.y;
bool live=t<batch();
if(FMT!=0&&tid<16)lut[tid]=kv[tid];
if(live&&tid<p.m){sid[tid]=d_u.v[t*p.m+tid];swt[tid]=e_f.v[t*p.m+tid];}
barrier();
if(!live)return;
uint lane=gl_SubgroupInvocationID,h=lane&1u,w=gl_SubgroupID;
uint first=gl_WorkGroupID.x*(4*R)+w*R,pairs=p.m*BLOCKS;
uint rb[R];[[unroll]]for(uint r=0;r<R;r++)rb[r]=min(first+r,p.n-1);
float acc[R];[[unroll]]for(uint r=0;r<R;r++)acc[r]=0;
// Step k: pair f = lane / 2 + 32 k, slot f / 20, block f % 20 (past the last pair: the last slot, no weight).
[[unroll]]for(uint k=0;k<STEPS;k++){
    uint f=(lane>>1)+32*k,j=min(f/BLOCKS,p.m-1),b=f%BLOCKS;
    uint e=sid[j];float cw=f<pairs?swt[j]:0.0;
    uint xo=(t*p.m+j)*(BLOCKS*8)+b*8+h*2;
    vec4 c0=b_v4.v[xo],c1=b_v4.v[xo+1],c2=b_v4.v[xo+4],c3=b_v4.v[xo+5];
    [[unroll]]for(uint r=0;r<R;r++){uint blk=(e*p.n+rb[r])*BLOCKS+b;uvec2 q=ww2.v[p.stride/2+blk*2+h];
        acc[r]=fma(dot(qlo(q.x),c0)+dot(qlo(q.y),c1)+dot(qhi(q.x),c2)+dot(qhi(q.y),c3),
            unpackHalf2x16(uint(wh.halves[blk])).x*cw,acc[r]);}
}
[[unroll]]for(uint r=0;r<R;r++){float v=subgroupAdd(acc[r]);if(lane==0&&first+r<p.n)c_f.v[t*p.n+first+r]=v;}
}
