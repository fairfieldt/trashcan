#version 460
#include "common.glsl"
// First half of a Q8_0 hyper-connection mixer for one token, with one step per wave: workgroup (g, s) takes rows
// 4 g .. 4 g + 3 over stream s, and its wave k the step qwen4_mix_down_skw's waves walk k-th (blocks s 80 + 16 k ..
// + 15, four lanes per block loading 8 weights each), so each wave waits for memory once. The lanes' dot products,
// block scales and sums of squares meet in shared memory, where wave 0 adds them up per lane in skw's step order
// (the same fma chains, then the same wave sums: the same bits), and writes the partials [s][m + 8] (sum of squares
// at m + 4). The last workgroup to finish (counted in extra, which it resets) applies the stream norms and writes
// qwen4_mix_down's output: bottleneck rows silu(row / 4), write rows 2 sigmoid(row / 4), the inverse norms.
// a: x [hc][n], b: y [n] (flags & 1: combine), c: partials, d: previous mixer out (write weights at m),
// e: gamma [hc][n], f: out [m + 8] (bottleneck | write | inv norms), extra: counter (u32 0).
// p.n = stream width (80 blocks: 5 steps of 16), p.k = hc * n, p.m = bottleneck rows, p.stride = word offset of the
// blocks, p.r0 = eps bits.
layout(set=2,binding=2,std430) coherent buffer Partials { float v[]; } cp;
layout(set=2,binding=7,std430) coherent buffer Counters { uint v[]; } cnt;
layout(binding=0,std430) readonly restrict buffer WeightU2 { uvec2 v[]; } ww2;
layout(local_size_x=320) in;
shared bool last;
shared float sdot[5][4][64],sscl[5][4][64],sss[5][64];
vec4 i8(uint w){return vec4(ivec4(w<<24,w<<16,w<<8,w)>>24);}
void main(){
uint lane=gl_SubgroupInvocationID,k=gl_SubgroupID,tid=gl_LocalInvocationID.x,blocks=p.k/32,sb=p.n/32,part=lane%4;
uint s=gl_WorkGroupID.y,rows=p.m+4,first=gl_WorkGroupID.x*4,P=p.m+8;
bool comb=(p.flags&1)!=0;
float ws=d_f.v[p.m+s];
uint b=s*sb+lane/4+16*k,i0=(b*32-s*p.n)/4+part*2,xo=(b*32)/4+part*2;
uvec2 q[4];uint d[4];
[[unroll]]for(uint r=0;r<4;r++){uint blk=min(first+r,rows-1)*blocks+b;q[r]=ww2.v[p.stride/2+blk*4+part];
    d[r]=uint(wh.halves[blk]);}
vec4 e0=e_v4.v[s*p.n/4+i0],e1=e_v4.v[s*p.n/4+i0+1],x0=a_v4.v[xo],x1=a_v4.v[xo+1];
vec4 c0=fma(vec4(ws),b_v4.v[i0],x0),c1=fma(vec4(ws),b_v4.v[i0+1],x1);
if(comb){x0=c0;x1=c1;}
sss[k][lane]=dot(x0,x0)+dot(x1,x1);
vec4 g0=x0*e0,g1=x1*e1;
[[unroll]]for(uint r=0;r<4;r++){sdot[k][r][lane]=dot(i8(q[r].x),g0)+dot(i8(q[r].y),g1);
    sscl[k][r][lane]=unpackHalf2x16(d[r]).x;}
barrier();
if(k==0){
    float acc[4],ss=0;
    [[unroll]]for(uint r=0;r<4;r++)acc[r]=0;
    [[unroll]]for(uint j=0;j<5;j++){ss+=sss[j][lane];
        [[unroll]]for(uint r=0;r<4;r++)acc[r]=fma(sdot[j][r][lane],sscl[j][r][lane],acc[r]);}
    uint o=s*P;
    [[unroll]]for(uint r=0;r<4;r++){float v=subgroupAdd(acc[r]);if(lane==0&&first+r<rows)cp.v[o+first+r]=v;}
    if(gl_WorkGroupID.x==0){float v=subgroupAdd(ss);if(lane==0)cp.v[o+rows]=v;}
}
memoryBarrierBuffer();
barrier();
if(tid==0)last=atomicAdd(cnt.v[0],1u)==gl_NumWorkGroups.x*4u-1u;
barrier();
if(!last)return;
memoryBarrierBuffer();
if(tid==0)cnt.v[0]=0;
float eps=uintBitsToFloat(p.r0);
// All partials of a row are loaded before they are summed.
float qs[4],a[2][4];
[[unroll]]for(uint s=0;s<4;s++){uint at=s*P;qs[s]=cp.v[at+p.m+4];
    [[unroll]]for(uint h=0;h<2;h++)a[h][s]=cp.v[at+min(tid+320*h,rows-1)];}
float inv[4];
[[unroll]]for(uint s=0;s<4;s++)inv[s]=inversesqrt(qs[s]/float(p.n)+eps);
[[unroll]]for(uint h=0;h<2;h++){uint j=tid+320*h;if(j<rows){float v=0;
    [[unroll]]for(uint s=0;s<4;s++)v+=inv[s]*a[h][s];
    float y=v*0.25;f_f.v[j]=j<p.m?y/(1.0+exp(-y)):2.0/(1.0+exp(-y));}}
if(tid<4)f_f.v[p.m+4+tid]=inv[tid];
}
