#version 460
// DIAGNOSTIC layout probe (timing only, wrong results): qwen4_moe_down_w with each wave reading a step's weights of
// its 4 rows as 2 KB contiguous instead of runs of 16 bytes per (slot, block) pair.
#include "common.glsl"
#include "qwen4_expert.glsl"
#define BLOCKS 20
layout(local_size_x=256) in;
layout(binding=0,std430) readonly restrict buffer WeightU2 { uvec2 v[]; } ww2;
shared uint sid[72];
shared float swt[72];
void main(){
uint tid=gl_LocalInvocationID.x,t=gl_WorkGroupID.y;
if(FMT!=0&&tid<16)lut[tid]=kv[tid];
if(tid<p.m){sid[tid]=d_u.v[t*p.m+tid];swt[tid]=e_f.v[t*p.m+tid];}
barrier();
uint lane=gl_SubgroupInvocationID,h=lane&1u,w=gl_SubgroupID;
if(t>=batch())return;
uint first=gl_WorkGroupID.x*16+w*4,pairs=p.m*BLOCKS;
uint f=lane>>1,j=f/BLOCKS,b=f%BLOCKS;
uint wq=p.stride/2+((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*4+w)*2048+lane;
vec4 acc=vec4(0);
for(uint i=0;i*32<pairs;i++){
    bool on=f<pairs;uint jj=min(j,p.m-1);
    uint e=sid[jj],blk=(e*p.n+first)*BLOCKS+b,xo=(t*p.m+jj)*(BLOCKS*8)+b*8+h*2;
    float cw=on?swt[jj]:0.0;
    vec4 c0=b_v4.v[xo],c1=b_v4.v[xo+1],c2=b_v4.v[xo+4],c3=b_v4.v[xo+5];
    [[unroll]]for(uint r=0;r<4;r++){uvec2 q=ww2.v[wq+i*256+r*64];
        acc[r]=fma(dot(qlo(q.x),c0)+dot(qlo(q.y),c1)+dot(qhi(q.x),c2)+dot(qhi(q.y),c3),
            unpackHalf2x16(uint(wh.halves[blk+r*BLOCKS])).x*cw,acc[r]);}
    f+=32;b+=12;j+=1;if(b>=BLOCKS){b-=BLOCKS;j++;}
}
acc=subgroupAdd(acc);
if(lane==0)[[unroll]]for(uint r=0;r<4;r++)if(first+r<p.n)c_f.v[t*p.n+first+r]=acc[r];
}
