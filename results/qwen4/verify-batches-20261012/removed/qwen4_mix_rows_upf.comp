#version 460
#include "common.glsl"
// EXPERIMENT (verify-batches): qwen4_mix_rows_up with a lane per whole row: wave s of 4 takes stream s, lane l row
// s * n + 64 g + l, loading all its 320 weights at once (20 x 16 bytes; a wave reads 64 consecutive rows, 20 KB),
// so no sums cross waves; the four streams' gates meet in LDS. Bindings and parameters as qwen4_mix_rows_up.
// SPEC: C (tokens, 1-4).
layout(local_size_x=256) in;
layout(constant_id=0) const uint SPEC=1;
const uint C=SPEC&7u;
layout(binding=0,std430) readonly restrict buffer WeightQuads { uvec4 q[]; } wq;
shared float gs[4][4][64];
vec4 i8(uint w){return vec4(ivec4(w<<24,w<<16,w<<8,w)>>24);}
void main(){
uint lane=gl_SubgroupInvocationID,sw=gl_SubgroupID,tid=gl_LocalInvocationID.x,nb=batch(),t0=gl_WorkGroupID.y*C;
if(t0>=nb)return;
uint P=p.m+8,blocks=p.m/32,i0=gl_WorkGroupID.x*64;
uint row=sw*p.n+min(i0+lane,p.n-1),blk0=row*blocks,a=p.stride/4+blk0*2;
uvec4 q[20];[[unroll]]for(uint j=0;j<20;j++)q[j]=wq.q[a+j];
uint dw[5];[[unroll]]for(uint j=0;j<5;j++)dw[j]=ww.words[blk0/2+j];
uint ez=min(tid/64,C-1),ei=min(i0+tid%64,p.n-1),et=min(t0+ez,nb-1);
float x[4],wp[4],inv[4],gm[4],y=f_f.v[et*p.n+ei];
[[unroll]]for(uint s=0;s<4;s++){x[s]=a_f.v[(et*4+s)*p.n+ei];wp[s]=d_f.v[et*P+p.m+s];inv[s]=b_f.v[et*P+p.m+4+s];
    gm[s]=e_f.v[s*p.n+ei];}
uint xo[4];[[unroll]]for(uint z=0;z<4;z++)xo[z]=(min(t0+z,nb-1)*P)/4;
float acc[4];[[unroll]]for(uint z=0;z<4;z++)acc[z]=0;
[[unroll]]for(uint b=0;b<10;b++){
    float d=unpackHalf2x16(dw[b/2]>>(16u*(b%2))).x;
    float s[4];[[unroll]]for(uint z=0;z<4;z++)s[z]=0;
    [[unroll]]for(uint j=0;j<8;j++){vec4 w=i8(q[b*2+j/4][j%4]);
        [[unroll]]for(uint z=0;z<C;z++){vec4 xv=b_v4.v[xo[z]+b*8+j];s[z]=fma(w.x,xv.x,s[z]);s[z]=fma(w.y,xv.y,s[z]);
            s[z]=fma(w.z,xv.z,s[z]);s[z]=fma(w.w,xv.w,s[z]);}}
    [[unroll]]for(uint z=0;z<C;z++)acc[z]=fma(s[z],d,acc[z]);
}
[[unroll]]for(uint z=0;z<C;z++)gs[sw][z][lane]=acc[z];
barrier();
if(tid<64*C&&t0+ez<nb&&i0+tid%64<p.n){uint e=tid%64;
    if((p.flags&1)!=0)[[unroll]]for(uint s=0;s<4;s++){x[s]=fma(wp[s],y,x[s]);a_f.v[(et*4+s)*p.n+ei]=x[s];}
    float u=0;
    [[unroll]]for(uint s=0;s<4;s++)u=fma(x[s]*inv[s]*gm[s],1.0/(1.0+exp(-gs[s][ez][e])),u);
    c_f.v[et*p.n+ei]=u*0.25;}
}
