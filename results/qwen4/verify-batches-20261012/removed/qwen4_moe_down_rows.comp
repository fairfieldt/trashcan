#version 460
#include "common.glsl"
#include "qwen4_expert.glsl"
// Down projections for decode and verification batches, a lane per output row: one workgroup per 64 rows of one
// token, wave j taking slot j (SLOTS waves); lane l walks row 64 * group + l of the slot's expert whole in 64-byte
// lines, decoding every weight once (the IQ4 table in LDS) against the slot's activations (the same for every lane:
// scalar loads), and the waves' weighted sums are added through LDS in slot order:
// y[t][i] = sum_j w[t][j] * W_e(j)[i] . act[t][j]. Q4_0 or IQ4_NL weights (formats 0 and 1 of qwen4_expert.glsl,
// f16 scales per block, lines 64-byte aligned); p.k a multiple of 128.
// b: act [t][slots][ff], c: y [t][n], d: ids [t][slots] (u32), e: weights [t][slots].
// p.n = d, p.m = slots (SLOTS), p.k = ff, p.stride = word offset of the blocks.
#define SLOTS 11
layout(local_size_x=SLOTS*64) in;
layout(binding=0,std430) readonly restrict buffer WeightQuads { uvec4 q[]; } wq;
layout(binding=0,std430) readonly restrict buffer WeightPairs { uvec2 h[]; } wp;
shared float red[SLOTS][64];
float lv(uint a,uint i){return lut[bitfieldExtract(a,int(8*i),8)>>2];}
void main(){
init_lut();
uint lane=gl_SubgroupInvocationID,j=gl_SubgroupID,t=gl_WorkGroupID.y;
if(t>=batch())return;
uint i=gl_WorkGroupID.x*64+lane,blocks=p.k/32,ts=t*SLOTS+j;
uint e=d_u.v[ts],row=e*p.n+min(i,p.n-1),xb=ts*(p.k/4);
float acc=0;
for(uint l=0;l<blocks/4;l++){
    uint blk=row*blocks+l*4,a=p.stride/4+blk;
    uvec4 q[4];[[unroll]]for(uint b=0;b<4;b++)q[b]=wq.q[a+b];
    uvec2 sh=wp.h[blk>>2];
    [[unroll]]for(uint b=0;b<4;b++){
        float s=unpackHalf2x16((b<2?sh.x:sh.y)>>(16u*(b%2))).x,ps=0;
        [[unroll]]for(uint w=0;w<4;w++){uint qq=q[b][w];
            vec4 x0=b_v4.v[xb+(l*4+b)*8+w],x1=b_v4.v[xb+(l*4+b)*8+w+4];
            if(FMT==0){ps+=dot(qlo(qq),x0)+dot(qhi(qq),x1);}
            else{uint al=(qq<<2)&0x3c3c3c3cu,ah=(qq>>2)&0x3c3c3c3cu;
                ps=fma(lv(al,0),x0.x,ps);ps=fma(lv(al,1),x0.y,ps);ps=fma(lv(al,2),x0.z,ps);ps=fma(lv(al,3),x0.w,ps);
                ps=fma(lv(ah,0),x1.x,ps);ps=fma(lv(ah,1),x1.y,ps);ps=fma(lv(ah,2),x1.z,ps);ps=fma(lv(ah,3),x1.w,ps);}
        }
        acc=fma(ps,s,acc);
    }
}
red[j][lane]=acc*e_f.v[ts];
barrier();
if(j==0&&i<p.n){float v=0;for(uint k=0;k<SLOTS;k++)v+=red[k][lane];c_f.v[t*p.n+i]=v;}
}
