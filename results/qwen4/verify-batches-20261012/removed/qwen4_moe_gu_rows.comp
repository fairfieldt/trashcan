#version 460
#include "common.glsl"
#include "qwen4_expert.glsl"
// Gate and up projections with SwiGLU for decode and verification batches, a lane per row: one workgroup per 32 rows
// of one (token, slot); lanes 0-31 of a wave take gate rows i..i+31 and lanes 32-63 the matching up rows, and wave w
// of the KS = p.k / 256 waves walks the rows' 256 weights from 256 w in whole 64-byte lines (two per row), decoding
// every weight once (the IQ4 table in LDS) against the token's inputs, which are the same for every lane (scalar
// loads). The waves' sums are added through LDS in wave order. Weights in qwen4_expert.glsl formats 0-2 (lines
// 64-byte aligned); expert e's rows start at e * 2 * ff: ff gate rows, then ff up rows, each p.k long.
// b: u [t][k], c: act [t][slots][ff], d: ids [t][slots] (u32). p.n = ff, p.m = slots, p.k = d (KS * 256),
// p.stride = word offset of the blocks.
#define KS 10
layout(local_size_x=KS*64) in;
layout(binding=0,std430) readonly restrict buffer WeightQuads { uvec4 q[]; } wq;
layout(binding=0,std430) readonly restrict buffer WeightPairs { uvec2 h[]; } wp;
shared float red[KS][64];
float lv(uint a,uint i){return lut[bitfieldExtract(a,int(8*i),8)>>2];}
void main(){
init_lut();
uint lane=gl_SubgroupInvocationID,wv=gl_SubgroupID,ts=gl_WorkGroupID.y,t=ts/p.m;
if(t>=batch())return;
uint e=d_u.v[ts],i=gl_WorkGroupID.x*32+lane%32,blocks=p.k/32;
uint row=e*2*p.n+(lane<32?0:p.n)+min(i,p.n-1),blk=row*blocks+wv*8,xb=t*(p.k/4)+wv*64;
uint a=p.stride/4+blk;
uvec4 q[8];[[unroll]]for(uint j=0;j<8;j++)q[j]=wq.q[a+j];
uvec2 hd=FMT==2?wp.h[blk>>3]:uvec2(0);
uvec4 sc=FMT!=2?uvec4(wp.h[blk>>2],wp.h[(blk>>2)+1]):uvec4(0);
float acc=0;
[[unroll]]for(uint b=0;b<8;b++){
    float s;
    if(FMT==2){uint ls=((hd.y>>(4u*b))&15u)|(((hd.x>>(16u+2u*b))&3u)<<4);s=unpackHalf2x16(hd.x).x*float(int(ls)-32);}
    else s=unpackHalf2x16(sc[b/2]>>(16u*(b%2))).x;
    float ps=0;
    [[unroll]]for(uint w=0;w<4;w++){uint qq=q[b][w];
        vec4 x0=b_v4.v[xb+b*8+w],x1=b_v4.v[xb+b*8+w+4];
        if(FMT==0){vec4 lo=qlo(qq),hi=qhi(qq);ps+=dot(lo,x0)+dot(hi,x1);}
        else{uint al=(qq<<2)&0x3c3c3c3cu,ah=(qq>>2)&0x3c3c3c3cu;
            ps=fma(lv(al,0),x0.x,ps);ps=fma(lv(al,1),x0.y,ps);ps=fma(lv(al,2),x0.z,ps);ps=fma(lv(al,3),x0.w,ps);
            ps=fma(lv(ah,0),x1.x,ps);ps=fma(lv(ah,1),x1.y,ps);ps=fma(lv(ah,2),x1.z,ps);ps=fma(lv(ah,3),x1.w,ps);}
    }
    acc=fma(ps,s,acc);
}
red[wv][lane]=acc;
barrier();
if(gl_LocalInvocationID.x<32&&i<p.n){float g=0,u=0;
    for(uint k=0;k<KS;k++){g+=red[k][lane];u+=red[k][lane+32];}
    c_f.v[ts*p.n+i]=g/(1.0+exp(-g))*u;}
}
