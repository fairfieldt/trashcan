#version 460
#include "common.glsl"
// Q8_0 matrix times up to COLS token columns (decode and small batches). Weights: all f16 block scales, then the
// 32-byte blocks from word p.stride (quant::repack_q8h), 8.5 bits per weight. One workgroup per 16 rows and
// COLS tokens; each wave owns 4 rows, lane l reads word l % 8 of blocks l / 8, l / 8 + 8, ...
// b: x [t][k], c: y [t][n]. p.n rows, p.k columns.
layout(local_size_x=256) in;
layout(constant_id=0) const uint COLS=1;
void main(){uint nb=batch(),lane=gl_SubgroupInvocationID,part=lane%8,blocks=p.k/32;
uint first=gl_WorkGroupID.x*16+gl_SubgroupID*4,t=gl_WorkGroupID.y*COLS;
if(t>=nb)return;
float s[4][4];[[unroll]]for(uint r=0;r<4;r++)[[unroll]]for(uint z=0;z<4;z++)s[r][z]=0;
uint col[4];[[unroll]]for(uint z=0;z<4;z++)col[z]=min(t+z,nb-1)*(p.k/4);
for(uint b=lane/8;b<blocks;b+=8){
    vec4 q[4];float d[4];
    [[unroll]]for(uint r=0;r<4;r++){uint row=min(first+r,p.n-1),blk=row*blocks+b,w=ww.words[p.stride+blk*8+part];
        q[r]=vec4(ivec4(w<<24,w<<16,w<<8,w)>>24);d[r]=unpackHalf2x16(uint(wh.halves[blk])).x;}
    [[unroll]]for(uint z=0;z<COLS;z++){vec4 x=b_v4.v[col[z]+b*8+part];
        [[unroll]]for(uint r=0;r<4;r++)s[r][z]=fma(dot(q[r],x),d[r],s[r][z]);}
}
[[unroll]]for(uint r=0;r<4;r++)[[unroll]]for(uint z=0;z<COLS;z++){float v=subgroupAdd(s[r][z]);
    if(lane==0&&first+r<p.n&&t+z<nb)c_f.v[(t+z)*p.n+first+r]=v;}}
