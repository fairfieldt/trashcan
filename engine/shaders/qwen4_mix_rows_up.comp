#version 460
#include "common.glsl"
// Second half of a hyper-connection mixer (Q8_0, bottleneck of 320) for C tokens, a lane per row, after
// qwen4_mix_prep and qwen4_mix_rows_down: one workgroup per 16 elements of every stream (64 rows of the up
// projection: lane l takes stream l / 16, element 16 g + l % 16); wave w of 5 takes line w of the rows (64 of the 320
// columns), decoding every weight once for the C tokens, whose bottleneck values are the same for every lane (scalar
// loads), and the sums go through LDS. Then the read gates give the sublayer input
// u_i = mean_s sigmoid(g_s,i) * x_s,i * inv_s * gamma_s,i (x already combined by qwen4_mix_prep).
// a: x [t][hc][n], b: mixer out [t][m + 8] (bottleneck at 0, inv norms at m + 4), c: u [t][n], e: gamma [hc][n].
// p.n = stream width, p.m = bottleneck (5 * 64), p.stride = word offset of the blocks.
layout(local_size_x=320) in;
layout(constant_id=0) const uint C=1;
layout(binding=0,std430) readonly restrict buffer WeightQuads { uvec4 q[]; } wq;
shared float red[5][4][64];
vec4 i8(uint w){return vec4(ivec4(w<<24,w<<16,w<<8,w)>>24);}
void main(){
uint lane=gl_SubgroupInvocationID,wv=gl_SubgroupID,tid=gl_LocalInvocationID.x,nb=batch(),t0=gl_WorkGroupID.y*C;
if(t0>=nb)return;
uint P=p.m+8,blocks=p.m/32,i0=gl_WorkGroupID.x*16;
uint row=(lane/16)*p.n+i0+lane%16;
uint blk=row*blocks+2*wv,a=p.stride/4+blk*2;
uvec4 q[4];q[0]=wq.q[a];q[1]=wq.q[a+1];q[2]=wq.q[a+2];q[3]=wq.q[a+3];
vec2 d=unpackHalf2x16(ww.words[blk/2]);
uint xo[4];[[unroll]]for(uint z=0;z<4;z++)xo[z]=(min(t0+z,nb-1)*P)/4+wv*16;
float acc[4];[[unroll]]for(uint z=0;z<4;z++)acc[z]=0;
[[unroll]]for(uint h=0;h<2;h++){
    float s[4];[[unroll]]for(uint z=0;z<4;z++)s[z]=0;
    [[unroll]]for(uint j=0;j<8;j++){vec4 w=i8(q[h*2+j/4][j%4]);
        [[unroll]]for(uint z=0;z<C;z++){vec4 x=b_v4.v[xo[z]+h*8+j];s[z]=fma(w.x,x.x,s[z]);s[z]=fma(w.y,x.y,s[z]);
            s[z]=fma(w.z,x.z,s[z]);s[z]=fma(w.w,x.w,s[z]);}}
    [[unroll]]for(uint z=0;z<C;z++)acc[z]=fma(s[z],d[h],acc[z]);
}
[[unroll]]for(uint z=0;z<C;z++)red[wv][z][lane]=acc[z];
barrier();
if(tid<16*C){uint z=tid/16,e=tid%16,t=t0+z,i=i0+e;
    if(t<nb){float x[4],inv[4],gm[4],g[4];
        [[unroll]]for(uint s=0;s<4;s++){x[s]=a_f.v[(t*4+s)*p.n+i];inv[s]=b_f.v[t*P+p.m+4+s];gm[s]=e_f.v[s*p.n+i];
            uint k=s*16+e;g[s]=red[0][z][k]+red[1][z][k]+red[2][z][k]+red[3][z][k]+red[4][z][k];}
        float u=0;
        [[unroll]]for(uint s=0;s<4;s++)u=fma(x[s]*inv[s]*gm[s],1.0/(1.0+exp(-g[s])),u);
        c_f.v[t*p.n+i]=u*0.25;}}
}
