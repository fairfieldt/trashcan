#version 460
#include "common.glsl"
// Second half of a Q8_0 hyper-connection mixer with a bottleneck of 320, for C = 1-4 tokens per workgroup, a lane per
// row: one workgroup per 16 elements of every stream (64 rows of the up projection: lane l takes stream l / 16,
// element 16 g + l % 16); wave w of 5 takes line w of the rows (64 of the 320 columns), decoding every weight once for
// the C tokens, whose bottleneck values are the same for every lane (scalar loads), so the workgroup reads 64 whole
// consecutive rows (20 KB) and the waves' sums meet in LDS. Then, as qwen4_mix_up, the read gates give the sublayer
// input u_i = mean_s sigmoid(g_s,i) * xn_s,i with xn = x * inv_s * gamma, after the pending combine
// x += w_prev * y (flags & 1, stored in place). The epilogue's inputs are loaded first, with the weights.
// (qwen4_mix_up reads the matrix once per token: 51 against 42 us for one token, 91 / 123 / 148 against
// 45-48 / 50-52 / 56-58 for 2 / 3 / 4: results/qwen4/verify-batches-20261012.)
// a: x [t][hc][n], b: mixer out [t][m + 8] (bottleneck at 0, inv norms at m + 4), c: u [t][n], d: previous mixer out
// (write weights at m), e: gamma [hc][n], f: y [t][n]. p.n = stream width, p.m = bottleneck (5 * 64),
// p.stride = word offset of the blocks. Workgroup y takes tokens C y ..
layout(local_size_x=320) in;
layout(constant_id=0) const uint C=1;
layout(binding=0,std430) readonly restrict buffer WeightQuads { uvec4 q[]; } wq;
shared float red[5][4][64];
vec4 i8(uint w){return vec4(ivec4(w<<24,w<<16,w<<8,w)>>24);}
void main(){
uint lane=gl_SubgroupInvocationID,wv=gl_SubgroupID,tid=gl_LocalInvocationID.x,nb=batch(),t0=gl_WorkGroupID.y*C;
if(t0>=nb)return;
uint P=p.m+8,blocks=p.m/32,i0=gl_WorkGroupID.x*16;
uint row=(lane/16)*p.n+i0+lane%16;
uint blk=row*blocks+2*wv,a=p.stride/4+blk*2;
uvec4 q[4];q[0]=wq.q[a];q[1]=wq.q[a+1];q[2]=wq.q[a+2];q[3]=wq.q[a+3];
uint dw=ww.words[blk/2];
// The epilogue thread's token and element (clamped, so every thread loads unconditionally).
uint ez=min(tid/16,C-1),ei=i0+tid%16,et=min(t0+ez,nb-1);
float x[4],wp[4],inv[4],gm[4],y=f_f.v[et*p.n+ei];
[[unroll]]for(uint s=0;s<4;s++){x[s]=a_f.v[(et*4+s)*p.n+ei];wp[s]=d_f.v[et*P+p.m+s];inv[s]=b_f.v[et*P+p.m+4+s];
    gm[s]=e_f.v[s*p.n+ei];}
uint xo[4];[[unroll]]for(uint z=0;z<4;z++)xo[z]=(min(t0+z,nb-1)*P)/4+wv*16;
vec2 d=unpackHalf2x16(dw);
float acc[4];[[unroll]]for(uint z=0;z<4;z++)acc[z]=0;
[[unroll]]for(uint h=0;h<2;h++){
    float s[4];[[unroll]]for(uint z=0;z<4;z++)s[z]=0;
    [[unroll]]for(uint j=0;j<8;j++){vec4 w=i8(q[h*2+j/4][j%4]);
        [[unroll]]for(uint z=0;z<C;z++){vec4 xv=b_v4.v[xo[z]+h*8+j];s[z]=fma(w.x,xv.x,s[z]);s[z]=fma(w.y,xv.y,s[z]);
            s[z]=fma(w.z,xv.z,s[z]);s[z]=fma(w.w,xv.w,s[z]);}}
    [[unroll]]for(uint z=0;z<C;z++)acc[z]=fma(s[z],d[h],acc[z]);
}
[[unroll]]for(uint z=0;z<C;z++)red[wv][z][lane]=acc[z];
barrier();
if(tid<16*C&&t0+ez<nb){uint e=tid%16;
    float g[4];
    [[unroll]]for(uint s=0;s<4;s++){uint k=s*16+e;g[s]=red[0][ez][k]+red[1][ez][k]+red[2][ez][k]+red[3][ez][k]+red[4][ez][k];}
    if((p.flags&1)!=0)[[unroll]]for(uint s=0;s<4;s++){x[s]=fma(wp[s],y,x[s]);a_f.v[(et*4+s)*p.n+ei]=x[s];}
    float u=0;
    [[unroll]]for(uint s=0;s<4;s++)u=fma(x[s]*inv[s]*gm[s],1.0/(1.0+exp(-g[s])),u);
    c_f.v[et*p.n+ei]=u*0.25;}
}
