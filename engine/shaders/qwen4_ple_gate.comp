#version 460
#include "common.glsl"
// N-gram (PLE) gates from the partial sums of qwen4_ple_sums, workgroup (g, t) writing elements 256 g.. of every
// stream. Per stream s: a = (RMS(key_s) * gk_s) . (RMS(x_s) * gq_s) / sqrt(n), g = sigmoid(sign(a) * sqrt(max(|a|,
// 1e-6))), gv_s = g * value, pn_s = RMS(gv_s) * gc_s (the convolution input).
// a: key [t][hc][n], b: value [t][n], c: x [t][hc][n], d: gamma [3][hc][n] (key, query, conv), e: gv [t][hc][n],
// f: pn [t][hc][n], extra: partial sums [t][groups][16]. p.n = stream width, p.heads = streams, p.r0 = eps bits.
layout(local_size_x=256) in;
shared float tot[13];
void main(){uint t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x,i=gl_WorkGroupID.x*256+l;if(t>=batch())return;
uint w=p.n*p.heads,base=t*w,groups=gl_NumWorkGroups.x;
if(l<13){float a=0;for(uint g=0;g<groups;g++)a+=extra_f.v[(t*groups+g)*16+l];tot[l]=a;}
barrier();
if(i>=p.n)return;
float eps=uintBitsToFloat(p.r0),n=float(p.n),vms=tot[12]/n,v=b_f.v[t*p.n+i];
[[unroll]]for(uint s=0;s<4;s++)if(s<p.heads){
    float a=tot[3*s+2]*inversesqrt(tot[3*s]/n+eps)*inversesqrt(tot[3*s+1]/n+eps)/sqrt(n);
    float g=1.0/(1.0+exp(-sign(a)*sqrt(max(abs(a),1e-6))));
    float inv=inversesqrt(g*g*vms+eps);
    float gv=g*v;
    e_f.v[base+s*p.n+i]=gv;f_f.v[base+s*p.n+i]=gv*inv*d_f.v[2*w+s*p.n+i];}}
