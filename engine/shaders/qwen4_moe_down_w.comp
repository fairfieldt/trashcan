#version 460
#include "common.glsl"
#include "qwen4_expert.glsl"
// qwen4_moe_down with wide loads (two lanes per 32-weight block, each loading half of its nibbles as one uvec2)
// and the (slot, block) pairs of a token flattened over the 32 lane pairs: y[t][i] = sum_j sum_b w[t][j] * scale
// * dot. One workgroup per 16 output rows and token; each wave owns 4 rows. Formats 0-2 of qwen4_expert.glsl.
// b: act [t][slots][ff], c: y [t][n], d: ids [t][slots] (u32), e: weights [t][slots].
// p.n = d, p.m = slots, p.k = ff, p.stride = word offset of the blocks.
layout(binding=0,std430) readonly restrict buffer WeightU2 { uvec2 v[]; } ww2;
layout(local_size_x=256) in;
void main(){
init_lut();
uint lane=gl_SubgroupInvocationID,h=lane%2,blocks=p.k/32,t=gl_WorkGroupID.y;
if(t>=batch())return;
uint first=gl_WorkGroupID.x*16+gl_SubgroupID*4;
vec4 acc=vec4(0);
uint j=0,b=lane/2;
while(b>=blocks){b-=blocks;j++;}
for(;j<p.m;){
    uint e=d_u.v[t*p.m+j],xo=(t*p.m+j)*(p.k/4)+b*8+h*2;
    float wt=e_f.v[t*p.m+j];
    vec4 x0=b_v4.v[xo],x1=b_v4.v[xo+1],x2=b_v4.v[xo+4],x3=b_v4.v[xo+5];
    [[unroll]]for(uint r=0;r<4;r++){
        uint blk=(e*p.n+first+r)*blocks+b;uvec2 q=ww2.v[p.stride/2+blk*2+h];
        acc[r]=fma(dot(qlo(q.x),x0)+dot(qlo(q.y),x1)+dot(qhi(q.x),x2)+dot(qhi(q.y),x3),bscale(blk)*wt,acc[r]);
    }
    b+=32;
    while(b>=blocks){b-=blocks;j++;}
}
acc=subgroupAdd(acc);
if(lane==0)[[unroll]]for(uint r=0;r<4;r++)if(first+r<p.n)c_f.v[t*p.n+first+r]=acc[r];
}
