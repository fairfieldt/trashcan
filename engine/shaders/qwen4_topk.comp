#version 460
#include "common.glsl"
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
// MoE router: softmax over the 512 expert logits, the p.m best (ties to the lower id) renormalized over their sum
// (at least 2^-14, as ggml clamps it), then the shared expert as one more slot with weight sigmoid(logit 512).
// One wave per token. a: logits [t][513] (p.k > 1: [p.k][t][513], the parts of qwen4_router_gemm, added in order and
// the sum kept in part 0), c: ids [t][p.m + 1] (u32), d: weights [t][p.m + 1].
// A single wave waits on every memory access, cross-lane step and instruction fetch on the D700, so the picks avoid
// p.m rounds of wave-wide maximum and minimum and the code stays short: the p.m-th largest lane maximum t0 (a radix
// select over one key per lane, counted with ballots, in a loop) bounds the picks from below, the probabilities >= t0
// (at least p.m, usually a few more) go to shared memory in id order (lanes not picked write past the 64 slots) and
// lanes rank them by (probability, id); more than 64 of them fall back to an exact radix select over all keys. The
// same probabilities, picks, order and sum as taking the maximum p.m times. Up to 64 picks.
layout(local_size_x=64) in;
shared uint sid[128],sk[128];
void main(){uint t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x;if(t>=batch())return;
uint row=t*513,slots=p.m+1,K=p.m;float v[8];float mx=-1e30;
[[unroll]]for(uint j=0;j<8;j++)v[j]=a_f.v[row+j*64+l];
float gate=a_f.v[row+512];
uint parts=max(p.k,1u),ps=batch()*513;
for(uint s=1;s<parts;s++){[[unroll]]for(uint j=0;j<8;j++)v[j]+=a_f.v[s*ps+row+j*64+l];gate+=a_f.v[s*ps+row+512];}
if(parts>1){[[unroll]]for(uint j=0;j<8;j++)a_f.v[row+j*64+l]=v[j];if(l==0)a_f.v[row+512]=gate;}
[[unroll]]for(uint j=0;j<8;j++)mx=max(mx,v[j]);
mx=subgroupMax(mx);float sum=0;
[[unroll]]for(uint j=0;j<8;j++){v[j]=exp(v[j]-mx);sum+=v[j];}
sum=subgroupAdd(sum);
[[unroll]]for(uint j=0;j<8;j++)v[j]/=sum;
uint u[8],mk=0;
[[unroll]]for(uint j=0;j<8;j++){u[j]=floatBitsToUint(v[j])+1u;mk=max(mk,u[j]);}
uint thr=0;
[[dont_unroll]]for(int bit=31;bit>=0;bit--){uint cand=thr|(1u<<bit);if(subgroupBallotBitCount(subgroupBallot(mk>=cand))>=K)thr=cand;}
uint cnt=0;
[[unroll]]for(uint j=0;j<8;j++)cnt+=subgroupBallotBitCount(subgroupBallot(u[j]>=thr));
uint budget=64;
if(cnt>64){thr=0;
    for(int bit=31;bit>=0;bit--){uint cand=thr|(1u<<bit),c=0;
        [[unroll]]for(uint j=0;j<8;j++)c+=subgroupBallotBitCount(subgroupBallot(u[j]>=cand));
        if(c>=K)thr=cand;}
    uint gt=0;
    [[unroll]]for(uint j=0;j<8;j++)gt+=subgroupBallotBitCount(subgroupBallot(u[j]>thr));
    budget=K-gt;}
uint before=0,pos=0;
[[unroll]]for(uint j=0;j<8;j++){uvec4 eq=subgroupBallot(u[j]==thr);
    uint ex=before+subgroupBallotExclusiveBitCount(eq);
    bool s=(uint(u[j]>thr)|(uint(u[j]==thr)&uint(ex<budget)))!=0u;
    before+=subgroupBallotBitCount(eq);
    uvec4 b=subgroupBallot(s);
    uint kb=pos+subgroupBallotExclusiveBitCount(b),k=s?kb:64+l;sid[k]=j*64+l;sk[k]=u[j];
    pos+=subgroupBallotBitCount(b);}
barrier();
uint me=l<pos?sk[l]:0u,id=l<pos?sid[l]:0u,r=0;
for(uint i=0;i<pos;i++){uint o=subgroupShuffle(me,i);r+=o>me||(o==me&&i<l)?1u:0u;}
if(l>=pos)r=64;
float val=uintBitsToFloat(me-1u),tot=0;
for(uint k=0;k<K;k++)tot+=subgroupShuffle(val,subgroupBallotFindLSB(subgroupBallot(r==k)));
tot=max(tot,6.103515625e-5);
if(r<K){c_u.v[t*slots+r]=id;d_f.v[t*slots+r]=val/tot;}
if(l==0){c_u.v[t*slots+p.m]=512;d_f.v[t*slots+p.m]=1.0/(1.0+exp(-gate));}}
