#version 460
#include "common.glsl"
// Inkling expert matrices over a prefill batch, one chunk of up to 32 pairs of one expert (inkling_moe_group) per
// workgroup row y: a 64-row tile (workgroup x) times every pair of the chunk. Lane = row, wave w = pairs 8w..8w+7;
// each 32-weight block of a row is decoded once into registers and multiplied with the 8 pairs' inputs, which the
// workgroup stages in LDS block by block (every lane of a wave reads the same element: a broadcast).
// MODE (specialization constant / 16): 0 gate/up with SITU: rows are (gate row r, up row r) pairs of the expert's
// slice (expert e's rows from e * 2 * p.n: p.n gate rows, then p.n up rows, p.k weights each); act[pair][r] =
// situ(gate . x * s[e], up . x * s[e]) into c, x [t][p.k] in b (row of pair = pair / p.m). 1 down: rows of the expert
// (from e * p.n, p.k weights each); y_pair[pair][row] = w[pair] * s[e] * (row . act[pair]) into c, act [pair][p.k]
// in b, weights [pair] in e. FMT (specialization constant % 16): 4 NVFP4, 5 Q8_0, as inkling_moe_gu.
// d: groups (chunk count, chunks of (expert, first, pairs), list from word p.offset), extra: per-expert scales.
// SITU: beta p.r0, linear beta p.r1 (float bits).
layout(constant_id=0) const uint SPEC=4;
const uint FMT=SPEC%16,MODE=SPEC/16;
#define PAIRS 32
layout(local_size_x=256) in;
shared float NV[16];
shared vec4 xs[PAIRS][8];
const float NVC[16]=float[16](0.,1.,2.,3.,4.,6.,8.,12.,0.,-1.,-2.,-3.,-4.,-6.,-8.,-12.);
// The 32 weights of block B (row-major blocks) as 8 vec4 in weight order.
void decode(uint B,out vec4 v[8]){
    if(FMT==4){
        uvec4 q=uvec4(ww.words[p.stride+B*4],ww.words[p.stride+B*4+1],ww.words[p.stride+B*4+2],ww.words[p.stride+B*4+3]);
        float slo=unpackHalf2x16(uint(wh.halves[2*B])).x,shi=unpackHalf2x16(uint(wh.halves[2*B+1])).x;
        [[unroll]]for(uint w=0;w<4;w++){uint x=q[w];
            v[w]=vec4(NV[x&15u],NV[(x>>8)&15u],NV[(x>>16)&15u],NV[(x>>24)&15u])*slo;
            v[4+w]=vec4(NV[(x>>4)&15u],NV[(x>>12)&15u],NV[(x>>20)&15u],NV[(x>>28)&15u])*shi;}
    }else{
        float sc=unpackHalf2x16(uint(wh.halves[B])).x;
        [[unroll]]for(uint w=0;w<8;w++){uint x=ww.words[p.stride+B*8+w];v[w]=vec4(ivec4(x<<24,x<<16,x<<8,x)>>24)*sc;}
    }
}
void main(){
if(gl_LocalInvocationID.x<16)NV[gl_LocalInvocationID.x]=NVC[gl_LocalInvocationID.x];
uint tid=gl_LocalInvocationID.x,lane=gl_SubgroupInvocationID,wv=gl_SubgroupID,ch=gl_WorkGroupID.y;
barrier();
if(ch>=d_u.v[0])return;
uint e=d_u.v[1+3*ch],first=d_u.v[2+3*ch],cnt=d_u.v[3+3*ch];
uint rows=MODE==0?p.n:p.n,blocks=p.k/32;
uint r=gl_WorkGroupID.x*64+lane,rc=min(r,rows-1);
bool live=8*wv<cnt;
float g[8],u[8];
[[unroll]]for(uint z=0;z<8;z++){g[z]=0;u[z]=0;}
// The staging thread's pair and row of the input.
uint sp=tid/8,sj=tid%8;
uint spair=d_u.v[p.offset+first+min(sp,cnt-1)];
uint srow=MODE==0?(spair/p.m):spair;
for(uint b=0;b<blocks;b++){
    xs[sp][sj]=sp<cnt?b_v4.v[srow*(p.k/4)+b*8+sj]:vec4(0);
    barrier();
    if(live){
        vec4 w0[8],w1[8];
        if(MODE==0){decode((e*2*p.n+rc)*blocks+b,w0);decode((e*2*p.n+p.n+rc)*blocks+b,w1);}
        else decode((e*p.n+rc)*blocks+b,w0);
        [[unroll]]for(uint z=0;z<8;z++){
            uint pz=8*wv+z;
            float sg=0,su=0;
            [[unroll]]for(uint j=0;j<8;j++){vec4 x=xs[pz][j];sg+=dot(w0[j],x);if(MODE==0)su+=dot(w1[j],x);}
            g[z]+=sg;if(MODE==0)u[z]+=su;
        }
    }
    barrier();
}
if(!live||r>=rows)return;
float s=extra_f.v[e],beta=uintBitsToFloat(p.r0),lin=uintBitsToFloat(p.r1);
[[unroll]]for(uint z=0;z<8;z++){
    uint pz=8*wv+z;
    if(pz>=cnt)break;
    uint pair=d_u.v[p.offset+first+pz];
    if(MODE==0){float gs=g[z]*s,us=u[z]*s;c_f.v[pair*p.n+r]=beta*tanh(gs/beta)/(1.0+exp(-gs))*lin*tanh(us/lin);}
    else c_f.v[pair*p.n+r]=g[z]*e_f.v[pair]*s;
}
}
