#version 460
#include "common.glsl"
// Hyper-connection mixer input: per token and stream, xn = RMS(x_s) * gamma_s. With flags & 1 the previous
// sublayer is combined first: x_s += w_s * y (w from the previous mixer's write weights).
// One workgroup per stream and token (the streams' norms are independent); each thread keeps its 10 values in
// registers between the combine and the norm. a: x [t][hc][n] (read/write), b: y [t][n], c: xn [t][hc][n],
// d: gamma [hc][n], e: write weights at e[t * p.m + p.offset + s] (p.m 0: hc). p.n = width of one stream (2560, at
// most 2560), p.heads = streams (4), p.r0 = eps bits.
layout(local_size_x=256) in;
shared float part[4];
void main(){uint s=gl_WorkGroupID.x,t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x;if(t>=batch())return;
uint base=(t*p.heads+s)*p.n;float ss=0,x[10];
float ws=(p.flags&1)!=0?e_fc.v[t*(p.m==0?p.heads:p.m)+p.offset+s]:0;
[[unroll]]for(uint j=0;j<10;j++){uint i=l+256*j;if(i<p.n){x[j]=a_f.v[base+i];
    if((p.flags&1)!=0){x[j]=fma(ws,b_f.v[t*p.n+i],x[j]);a_f.v[base+i]=x[j];}ss=fma(x[j],x[j],ss);}}
float v=subgroupAdd(ss);if(gl_SubgroupInvocationID==0)part[gl_SubgroupID]=v;
barrier();
float inv=inversesqrt((part[0]+part[1]+part[2]+part[3])/float(p.n)+uintBitsToFloat(p.r0));
[[unroll]]for(uint j=0;j<10;j++){uint i=l+256*j;if(i<p.n)c_f.v[base+i]=x[j]*inv*d_f.v[s*p.n+i];}}
