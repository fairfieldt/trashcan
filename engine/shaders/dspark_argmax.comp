#version 460
#include "common.glsl"
// Inkling DSpark: the first maximum of this rank's softcapped logits cap tanh((base + bias) / cap) over its p.n
// vocabulary rows (rows at or beyond p.k, the padding, are skipped; ids from p.offset): base row p.m of b ([rows][p.n]),
// bias c ([p.n]); writes (value, id as float bits) into a. One workgroup.
layout(local_size_x=256) in;
shared float bv[256];
shared uint bi[256];
void main(){
uint tid=gl_LocalInvocationID.x;
float cap=uintBitsToFloat(p.r0),best=-1e30;uint id=0xffffffffu;
for(uint i=tid;i<p.n;i+=256){
    if(p.offset+i>=p.k)break;
    float v=cap*tanh((b_f.v[p.m*p.n+i]+c_f.v[i])/cap);
    if(v>best){best=v;id=i;}
}
bv[tid]=best;bi[tid]=id;
barrier();
for(uint s=128;s>0;s>>=1){
    if(tid<s){float o=bv[tid+s];uint oi=bi[tid+s];
        if(o>bv[tid]||(o==bv[tid]&&oi<bi[tid])){bv[tid]=o;bi[tid]=oi;}}
    barrier();
}
if(tid==0){a_f.v[0]=bv[0];a_u.v[1]=bi[0]+p.offset;}
}
