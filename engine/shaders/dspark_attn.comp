#version 460
#include "common.glsl"
#extension GL_KHR_shader_subgroup_clustered : require
// One workgroup scores all eight block queries of one head against its range of keys.
// The cache is packed f16, followed logically by the eight non-causal f32 block rows.
layout(local_size_x=256) in;
// The same LDS tile holds transposed keys and then values. The extra column avoids
// bank conflicts on the transpose. Keep values in registers until scoring finishes.
shared vec4 data[32][33];
shared float probabilities[8][32];

void main() {
    uint tid = gl_LocalInvocationID.x, t = tid / 32u, lane = tid % 32u;
    uint part = gl_WorkGroupID.x, h = gl_WorkGroupID.y, g = h / (p.heads / p.kvheads);
    uint first = p.window > 0u && p.offset >= p.window ? p.offset + 1u - p.window : 0u;
    uint end = p.offset + 8u, width = (end - first + p.m - 1u) / p.m;
    uint start = first + part * width, stop = min(start + width, end);
    uint qbase = (t * p.heads + h) * 32u;
    float maximum = -1e30, sum = 0.0;
    vec4 weighted = vec4(0.0);
    for (uint tile = start; tile < stop; tile += 32u) {
        vec4 vrow[4];
        [[unroll]] for (uint step = 0u; step < 4u; step++) {
            uint i = tid + step * 256u;
            uint j = i / 32u, c = i % 32u, pos = min(tile + j, stop - 1u);
            vec4 k, v;
            if (pos < p.offset) {
                uint base = ((pos % p.cap * p.kvheads + g) * 32u + c) * 2u;
                k = vec4(unpackHalf2x16(e_u.v[base]), unpackHalf2x16(e_u.v[base + 1u]));
                v = vec4(unpackHalf2x16(f_u.v[base]), unpackHalf2x16(f_u.v[base + 1u]));
            } else {
                uint base = ((pos - p.offset) * p.kvheads + g) * 32u + c;
                k = c_v4.v[base]; v = d_v4.v[base];
            }
            data[c][j] = k; vrow[step] = v;
        }
        barrier();
        float s = 0.0;
        [[unroll]] for (uint c = 0u; c < 32u; c++) s += dot(b_v4.v[qbase + c], data[c][lane]);
        uint pos = tile + lane;
        bool valid = pos < stop && (p.window == 0u || pos >= p.offset || pos + p.window > p.offset + t);
        s = valid ? s * inversesqrt(128.0) : -1e30;
        float m = max(maximum, subgroupClusteredMax(s, 32));
        float w = valid ? exp(s - m) : 0.0;
        float scale = exp(maximum - m);
        barrier();
        [[unroll]] for (uint step = 0u; step < 4u; step++)
            data[t + step * 8u][lane] = vrow[step];
        probabilities[t][lane] = w;
        sum = sum * scale + subgroupClusteredAdd(w, 32);
        maximum = m;
        weighted *= scale;
        barrier();
        [[unroll]] for (uint j = 0u; j < 32u; j++)
            weighted = fma(vec4(probabilities[t][j]), data[j][lane], weighted);
        barrier();
    }
    uint row = t * p.heads + h;
    if (p.m == 1u) {
        a_v4.v[row * 32u + lane] = weighted / sum;
    } else {
        uint base = (row * p.m + part) * 33u;
        a_v4.v[base + lane] = weighted;
        if (lane == 0u) a_v4.v[base + 32u] = vec4(maximum, sum, 0.0, 0.0);
    }
}
