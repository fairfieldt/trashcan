#version 460
#include "common.glsl"
// Q8_0 matrix times a batch (prefill): 64 x 64 outputs per 256-thread workgroup, 4 x 4 accumulators per thread,
// K step 32 (one block), as gemm.comp does for Q4_0. Weights as in qwen4_q8_mv.
// b: x [t][k], c: y [t][n]. p.n rows, p.k columns. With p.m > 0 the K range is split in p.m equal parts (multiples of
// 32): workgroup x covers row tile x % tiles of part x / tiles and writes its partial sums to c [part][t][n].
// MIX 1 (qwen4_q8_gemm_mix): the up projection of a hyper-connection mixer (p.n = 4 streams of p.n / 4 rows) and its
// sublayer input. Tile x holds elements 16 x .. 16 x + 15 of every stream, so each thread ends with the 4 read gates
// g_s of one element and stores u = mean_s xn_s * sigmoid(g_s) (as qwen4_hc_mix) instead of the gates.
// d: xn [t][4][p.n / 4], c: u [t][p.n / 4].
layout(constant_id=0) const uint MIX=0;
layout(local_size_x=256) in;
shared vec4 tile_w[64][9],tile_x[64][9];
void main(){uint nb=batch(),lane=gl_LocalInvocationID.x,group=lane/16;
uint rr=(group%4)*4+(lane%4),tt=(group/4)*4+((lane%16)/4);
uint tiles=(p.n+63)/64,part=gl_WorkGroupID.x/tiles,kc=p.m==0?p.k:p.k/p.m;
uint row0=(gl_WorkGroupID.x%tiles)*64,tok0=gl_WorkGroupID.y*64,blocks=p.k/32,out0=part*nb*p.n;
vec4 a0=vec4(0),a1=vec4(0),a2=vec4(0),a3=vec4(0);
uint r=lane/4,q=lane%4,row=MIX==1?(r/16)*(p.n/4)+gl_WorkGroupID.x*16+r%16:row0+r;
for(uint kb=part*kc;kb<(part+1)*kc;kb+=32){
vec4 lo=vec4(0),hi=vec4(0);
if(row<p.n){uint blk=row*blocks+kb/32;float d=unpackHalf2x16(uint(wh.halves[blk])).x;
uint w0=ww.words[p.stride+blk*8+2*q],w1=ww.words[p.stride+blk*8+2*q+1];
lo=vec4(ivec4(w0<<24,w0<<16,w0<<8,w0)>>24)*d;hi=vec4(ivec4(w1<<24,w1<<16,w1<<8,w1)>>24)*d;}
tile_w[r][2*q]=lo;tile_w[r][2*q+1]=hi;
for(uint i=lane;i<512;i+=256){uint xr=i/8,xj=i%8;vec4 x=vec4(0);if(tok0+xr<nb)x=b_v4.v[(tok0+xr)*(p.k/4)+kb/4+xj];tile_x[xr][xj]=x;}barrier();
[[unroll]]for(uint j=0;j<8;j++){
vec4 b0=tile_x[tt][j],b1=tile_x[tt+16][j],b2=tile_x[tt+32][j],b3=tile_x[tt+48][j];
vec4 w0=tile_w[rr][j],w1=tile_w[rr+16][j],w2=tile_w[rr+32][j],w3=tile_w[rr+48][j];
[[unroll]]for(uint v=0;v<4;v++){vec4 x=vec4(b0[v],b1[v],b2[v],b3[v]);
a0=fma(vec4(w0[v]),x,a0);a1=fma(vec4(w1[v]),x,a1);a2=fma(vec4(w2[v]),x,a2);a3=fma(vec4(w3[v]),x,a3);}
}barrier();}
if(MIX==1){uint dd=p.n/4,i=gl_WorkGroupID.x*16+rr;
for(uint t=0;t<4;t++){uint col=tok0+tt+t*16;if(col<nb){uint base=col*p.n+i;float u=0;
u=fma(d_f.v[base],1.0/(1.0+exp(-a0[t])),u);u=fma(d_f.v[base+dd],1.0/(1.0+exp(-a1[t])),u);
u=fma(d_f.v[base+2*dd],1.0/(1.0+exp(-a2[t])),u);u=fma(d_f.v[base+3*dd],1.0/(1.0+exp(-a3[t])),u);
c_f.v[col*dd+i]=u/4.0;}}
return;}
for(uint t=0;t<4;t++){uint col=tok0+tt+t*16;if(col<nb){
if(row0+rr<p.n)c_f.v[out0+col*p.n+row0+rr]=a0[t];
if(row0+rr+16<p.n)c_f.v[out0+col*p.n+row0+rr+16]=a1[t];
if(row0+rr+32<p.n)c_f.v[out0+col*p.n+row0+rr+32]=a2[t];
if(row0+rr+48<p.n)c_f.v[out0+col*p.n+row0+rr+48]=a3[t];
}}}
