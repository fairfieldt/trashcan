#version 460
#include "common.glsl"
// Group a batch's (token, slot) pairs by expert for the tiled expert kernels: count the pairs of each of p.n experts,
// list each expert's pairs together (pair = t * p.m + k; the order within an expert does not matter: every pair is
// computed on its own and inkling_moe_sum adds each token's slots in slot order) and cut the lists into chunks of at
// most CHUNK pairs. One workgroup. b: ids [t][p.m] (u32). a: u32 [0] = chunks, then chunks [3 each: expert, first
// list index, pairs], then from word p.offset the list.
#define CHUNK 32
layout(local_size_x=256) in;
shared uint cnt[256],off[256],fill[256];
shared uint nch;
void main(){
uint tid=gl_LocalInvocationID.x,pairs=batch()*p.m;
if(tid<p.n){cnt[tid]=0;fill[tid]=0;}
barrier();
for(uint i=tid;i<pairs;i+=256)atomicAdd(cnt[b_u.v[i]],1);
barrier();
if(tid==0){
    uint at=0,ch=0;
    for(uint e=0;e<p.n;e++){
        off[e]=at;
        for(uint s=0;s<cnt[e];s+=CHUNK){a_u.v[1+3*ch]=e;a_u.v[2+3*ch]=at+s;a_u.v[3+3*ch]=min(CHUNK,cnt[e]-s);ch++;}
        at+=cnt[e];
    }
    nch=ch;a_u.v[0]=ch;
}
barrier();
for(uint i=tid;i<pairs;i+=256){uint e=b_u.v[i];uint k=atomicAdd(fill[e],1);a_u.v[p.offset+off[e]+k]=i;}
}
