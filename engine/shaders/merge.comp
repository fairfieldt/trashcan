#version 460
#include "common.glsl"
layout(local_size_x=256) in;
shared float vals[4];
shared uint ids[4],lists[4],chosen;
void main(){
uint lane=gl_LocalInvocationID.x,t=gl_WorkGroupID.y;
if(t>=batch())return;
// topk emits at most 128 sorted lists. Keep only each list's current head
// in registers, advancing the winning list instead of rescanning all k ranks.
uint cursor=lane*p.k,end=cursor+p.k;
float value=-1e30;uint token=0xffffffffu;
if(cursor<p.n){value=a_f.v[(t*p.n+cursor)*2];token=a_u.v[(t*p.n+cursor)*2+1];}
for(uint rank=0;rank<p.k;rank++){
    float wave_best=subgroupMax(value);
    uint wave_id=subgroupMin(value==wave_best?token:0xffffffffu);
    uint wave_list=subgroupMin(value==wave_best&&token==wave_id?lane:0xffffffffu);
    if(gl_SubgroupInvocationID==0){vals[gl_SubgroupID]=wave_best;ids[gl_SubgroupID]=wave_id;lists[gl_SubgroupID]=wave_list;}
    barrier();
    if(lane==0){
        uint wave=0;
        for(uint i=1;i<4;i++)if(vals[i]>vals[wave]||(vals[i]==vals[wave]&&ids[i]<ids[wave]))wave=i;
        c_f.v[(t*p.k+rank)*2]=vals[wave];
        c_u.v[(t*p.k+rank)*2+1]=ids[wave];
        chosen=lists[wave];
    }
    barrier();
    if(lane==chosen){
        cursor++;
        if(cursor<end){value=a_f.v[(t*p.n+cursor)*2];token=a_u.v[(t*p.n+cursor)*2+1];}
        else {value=-1e30;token=0xffffffffu;}
    }
}}
