}
[[unroll]]for(uint r=0;r<ROWS;r++){vec4 v=subgroupAdd(sums[r]);if(lane==0&&first+r<p.n)[[unroll]]for(uint z=0;z<4;z++)if(t+z<nb)c_f.v[(t+z)*p.n+first+r]=v[z];}}

