#version 460
#include "common.glsl"
// Sum a token's weighted expert outputs in slot order: y[t][i] = sum_j ys[t * slots + j][i].
// a: ys [t * slots][n], c: y [t][n]. p.n = d, p.m = slots.
layout(local_size_x=256) in;
void main(){uint i=gl_GlobalInvocationID.x,t=gl_WorkGroupID.y;if(i>=p.n||t>=batch())return;
float s=0;for(uint j=0;j<p.m;j++)s+=a_f.v[(t*p.m+j)*p.n+i];c_f.v[t*p.n+i]=s;}
