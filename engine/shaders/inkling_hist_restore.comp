#version 460
#include "common.glsl"
// Roll a slot's K and V convolution histories back to after the first p.n rows of a verification batch: the history
// becomes the last three pre-convolution inputs before that point, from the batch's saved rows (c: K rows [8][C],
// then V rows from float 8 C) or from the history saved before the batch (b: [2][3][C]). a: the history. p.k = C.
layout(local_size_x=256) in;
void main(){
uint i=gl_GlobalInvocationID.x,C=p.k,n=p.n;
if(i>=2*C)return;
uint kv=i/C,ch=i%C;
[[unroll]]for(uint s=0;s<3;s++){
    int src=int(n)-3+int(s);
    a_f.v[(kv*3+s)*C+ch]=src>=0?c_f.v[kv*8*C+uint(src)*C+ch]:b_f.v[(kv*3+uint(int(s)+int(n)))*C+ch];
}
}
