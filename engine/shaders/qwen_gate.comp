#version 460
#include "common.glsl"
// Attention output gate: o[t][h][j] *= sigmoid(g), where g is the second half of query head h's projection.
// a: o (in place), b: query projection [t][head][q | gate]. p.n = heads * dim, p.dim.
layout(local_size_x=256) in;
void main(){uint i=gl_GlobalInvocationID.x,t=gl_WorkGroupID.y;if(i>=p.n||t>=batch())return;
uint h=i/p.dim,j=i%p.dim;float g=b_f.v[t*2*p.n+h*2*p.dim+p.dim+j];a_f.v[t*p.n+i]*=1.0/(1.0+exp(-g));}
