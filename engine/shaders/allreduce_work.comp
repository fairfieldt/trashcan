#version 460
#include "common.glsl"
// All-reduce benchmark: stream p.n vec4s of a from vec4 p.offset, like a memory-bound projection, and write one
// sum per wave to c so the loads stay.
layout(local_size_x=256) in;
void main(){vec4 acc=vec4(0.0);
for(uint i=gl_GlobalInvocationID.x;i<p.n;i+=gl_NumWorkGroups.x*256u)acc+=a_v4.v[p.offset+i];
float t=subgroupAdd(acc.x+acc.y+acc.z+acc.w);
if(gl_SubgroupInvocationID==0u)c_f.v[gl_WorkGroupID.x*4u+gl_SubgroupID]=t;}
