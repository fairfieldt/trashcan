#version 460
#define ROWS 2
#define WAVES 4
#include "common.glsl"
// qwen_gdn (the Gated DeltaNet recurrence) for decode and small batches: lane l holds key dims 2l and 2l + 1, so the
// state, q and k move as one vec2 per lane, and each wave owns ROWS = 2 state rows (decode 52 -> 46 us per layer on
// the D700 against one row and two lanes' dims l, l + 64). Same arithmetic per row; only the reduction's lane order
// differs from qwen_gdn. Bindings and parameters as qwen_gdn.
layout(set=2,binding=0,std430) buffer Binding_a_v2 { vec2 v[]; } a_v2;
layout(set=2,binding=2,std430) buffer Binding_c_v2 { vec2 v[]; } c_v2;
layout(set=2,binding=5,std430) buffer Binding_f_v2 { vec2 v[]; } f_v2;
layout(local_size_x=WAVES*64) in;
void main(){
uint lane=gl_SubgroupInvocationID,per_head=p.dim/(WAVES*ROWS);
uint vh=gl_WorkGroupID.x/per_head,row0=(gl_WorkGroupID.x%per_head)*(WAVES*ROWS)+gl_SubgroupID*ROWS;
uint kh=vh%p.kvheads,kd=p.kvheads*p.dim;
bool fresh=position()==0;
vec2 s[ROWS];
[[unroll]]for(uint r=0;r<ROWS;r++){uint at=((vh*p.dim+row0+r)*p.dim)/2+lane;s[r]=fresh?vec2(0):c_v2.v[at];}
float dt=e_fc.v[vh],A=e_fc.v[p.heads+vh],eps=uintBitsToFloat(p.r0),scale=inversesqrt(float(p.dim));
uint nb=batch();
for(uint t=0;t<nb;t++){
    uint base=t*p.n;
    vec2 q=a_v2.v[(base+kh*p.dim)/2+lane],k=a_v2.v[(base+kd+kh*p.dim)/2+lane];
    q*=inversesqrt(subgroupAdd(dot(q,q))+eps)*scale;
    k*=inversesqrt(subgroupAdd(dot(k,k))+eps);
    float x=b_fc.v[t*2*p.heads+vh]+dt;
    float decay=exp((x>20.0?x:log(1.0+exp(x)))*A);
    float beta=1.0/(1.0+exp(-b_fc.v[t*2*p.heads+p.heads+vh]));
    float v[ROWS];[[unroll]]for(uint r=0;r<ROWS;r++)v[r]=a_f.v[base+2*kd+vh*p.dim+row0+r];
    float o[ROWS];
    [[unroll]]for(uint r=0;r<ROWS;r++){
        s[r]*=decay;
        float delta=(v[r]-subgroupAdd(dot(s[r],k)))*beta;
        s[r]+=k*delta;
        o[r]=subgroupAdd(dot(s[r],q));
    }
    if(lane==0)[[unroll]]for(uint r=0;r<ROWS;r++)d_f.v[(t*p.heads+vh)*p.dim+row0+r]=o[r];
    if(p.f!=0&&t+1<nb){uint snap=t*p.heads*p.dim*p.dim;
    [[unroll]]for(uint r=0;r<ROWS;r++)f_v2.v[(snap+(vh*p.dim+row0+r)*p.dim)/2+lane]=s[r];}
}
[[unroll]]for(uint r=0;r<ROWS;r++)c_v2.v[((vh*p.dim+row0+r)*p.dim)/2+lane]=s[r];
}
