#version 460
#include "common.glsl"
// Qwen GQA: p.k is the query/KV head ratio (including six), padding each tile to 64 rows.
// p.r1 is the first query in a bounded query score slab. All LDS
// producer/consumer phases use workgroup barriers; no wave scheduling assumptions.
// O = P V: 64 output dims x 64 query rows per workgroup, 32 keys per step.
// c: V cache f16; e: P f32 rows; f: reciprocal denominators; d: output [token][head][dim].
layout(local_size_x=256) in;
shared vec4 tile_v[64][9],tile_p[64][9];
void main(){
uint nb=min(batch()-p.r1,p.m==0u?64u:p.m),lane=gl_LocalInvocationID.x,group=lane/16;
uint rr=(group%4)*4+(lane%4),tt=(group/4)*4+((lane%16)/4);
uint hq=p.k,tq=1u<<findMSB(64u/hq),qt=(nb+tq-1)/tq;
uint kh=gl_WorkGroupID.y/qt,t0=(gl_WorkGroupID.y%qt)*tq;
uint d0=gl_WorkGroupID.x*64;
uint pos=position()+p.r1+t0;
uint kstart=p.window>0&&pos+1>p.window?pos+1-p.window:0;
uint last=position()+p.r1+min(t0+tq,nb)-1;
uint span=(last-kstart+32)&~31u;
// Each thread reads eight consecutive dims of one key and two vec4 of one probability row.
uint vk=lane/8,vd=(lane%8)*8;
uint slot0=(kstart+vk)%p.cap;
uint prow[2];bool pvalid[2];
[[unroll]]for(uint s=0;s<2;s++){uint i=lane+s*256,c=i/8,tok=t0+(c/hq);pvalid[s]=c<tq*hq && tok<nb;
prow[s]=((tok*p.heads+kh*hq+(c%hq))*p.n)/4+i%8;}
vec4 a0=vec4(0),a1=vec4(0),a2=vec4(0),a3=vec4(0);
for(uint kb=0;kb<span;kb+=32){
vec4 lo=vec4(0),hi=vec4(0);
if(kstart+kb+vk<=last){uint slot=slot0+kb;if(slot>=p.cap)slot-=p.cap;
uint w=((slot*p.kvheads+kh)*p.dim+d0+vd)/2;
lo=vec4(unpackHalf2x16(c_u.v[w]),unpackHalf2x16(c_u.v[w+1]));hi=vec4(unpackHalf2x16(c_u.v[w+2]),unpackHalf2x16(c_u.v[w+3]));}
[[unroll]]for(uint z=0;z<4;z++){tile_v[vd+z][vk/4][vk%4]=lo[z];tile_v[vd+4+z][vk/4][vk%4]=hi[z];}
[[unroll]]for(uint s=0;s<2;s++){uint i=lane+s*256;vec4 x=vec4(0);if(pvalid[s])x=e_v4.v[prow[s]+kb/4];tile_p[i/8][i%8]=x;}
barrier();
[[unroll]]for(uint jj=0;jj<8;jj++){
vec4 b0=tile_p[tt][jj],b1=tile_p[tt+16][jj],b2=tile_p[tt+32][jj],b3=tile_p[tt+48][jj];
vec4 w0=tile_v[rr][jj],w1=tile_v[rr+16][jj],w2=tile_v[rr+32][jj],w3=tile_v[rr+48][jj];
[[unroll]]for(uint v=0;v<4;v++){vec4 x=vec4(b0[v],b1[v],b2[v],b3[v]);
a0=fma(vec4(w0[v]),x,a0);a1=fma(vec4(w1[v]),x,a1);a2=fma(vec4(w2[v]),x,a2);a3=fma(vec4(w3[v]),x,a3);}
}barrier();}
for(uint t=0;t<4;t++){uint c=tt+t*16,tok=t0+(c/hq);if(c<tq*hq && tok<nb){
uint row=tok*p.heads+kh*hq+(c%hq);float inv=f_f.v[row];
uint base=((p.r1+tok)*p.heads+kh*hq+(c%hq))*p.dim+d0+rr;
d_f.v[base]=a0[t]*inv;d_f.v[base+16]=a1[t]*inv;d_f.v[base+32]=a2[t]*inv;d_f.v[base+48]=a3[t]*inv;
}}}
