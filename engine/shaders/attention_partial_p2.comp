#version 460
#include "common.glsl"
// attention_partial with keys walked two at a time: both keys' K rows are loaded and both scores reduced before
// either online-softmax update, and both V rows are loaded before the first is applied, so each key's loads and
// reduction overlap the other's. The updates themselves run in key order with attention_partial's expressions,
// so the partial sums are the same bits.
layout(local_size_x=64) in;
layout(constant_id=0) const uint parts=32;
void main(){
uint chunk=gl_WorkGroupID.x%parts,head=gl_WorkGroupID.x/parts;
uint t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x;
if(t>=batch())return;
uint pos=position()+t,start=p.window>0 && pos+1>p.window ? pos+1-p.window:0;
uint end=params_u.v[2]!=0 ? min(pos,params_u.v[2]-1):pos;
uint step=(end-start+parts)/parts;uint lo=start+chunk*step;end=min(end,lo+step-1);start=lo;
uint kh=head/(p.heads/p.kvheads),qbase=t*p.heads*p.dim+head*p.dim;
float acc[8],q[8];[[unroll]] for(uint j=0;j<8;j++){acc[j]=0;q[j]=j*64+l<p.dim?a_f.v[qbase+j*64+l]:0;}
float maxs=-1e30,den=0;
uint key=start;
for(;key+1<=end;key+=2){
    uint kb0=(key%p.cap)*p.kvheads*p.dim+kh*p.dim,kb1=((key+1)%p.cap)*p.kvheads*p.dim+kh*p.dim;
    float k0[8],k1[8];
    [[unroll]] for(uint j=0;j<p.dim/64;j++){k0[j]=half_b(kb0+j*64+l);k1[j]=half_b(kb1+j*64+l);}
    float dot0=0,dot1=0;
    [[unroll]] for(uint j=0;j<p.dim/64;j++){dot0=fma(q[j],k0[j],dot0);dot1=fma(q[j],k1[j],dot1);}
    float score0=subgroupAdd(dot0),score1=subgroupAdd(dot1);
    float v0[8],v1[8];
    [[unroll]] for(uint j=0;j<p.dim/64;j++){v0[j]=half_c(kb0+j*64+l);v1[j]=half_c(kb1+j*64+l);}
    float nm=max(maxs,score0),rescale=exp(maxs-nm),w=exp(score0-nm);
    den=den*rescale+w;
    [[unroll]] for(uint j=0;j<p.dim/64;j++)acc[j]=fma(w,v0[j],acc[j]*rescale);
    maxs=nm;
    nm=max(maxs,score1);rescale=exp(maxs-nm);w=exp(score1-nm);
    den=den*rescale+w;
    [[unroll]] for(uint j=0;j<p.dim/64;j++)acc[j]=fma(w,v1[j],acc[j]*rescale);
    maxs=nm;
}
if(key<=end){
    uint kb=(key%p.cap)*p.kvheads*p.dim+kh*p.dim;
    float dot=0;
    [[unroll]] for(uint j=0;j<p.dim/64;j++)dot=fma(q[j],half_b(kb+j*64+l),dot);
    float score=subgroupAdd(dot),nm=max(maxs,score),rescale=exp(maxs-nm),w=exp(score-nm);
    den=den*rescale+w;
    [[unroll]] for(uint j=0;j<p.dim/64;j++)acc[j]=fma(w,half_c(kb+j*64+l),acc[j]*rescale);
    maxs=nm;
}
uint base=((t*p.heads+head)*parts+chunk)*(p.dim+2);
[[unroll]] for(uint j=0;j<p.dim/64;j++)e_f.v[base+2+j*64+l]=acc[j];
if(l==0){e_f.v[base]=maxs;e_f.v[base+1]=den;}
}
