#version 460
#include "common.glsl"
// Gate and up projections of the routed and shared experts with SwiGLU, for small batches. One workgroup per
// 16 rows of one (token, slot); each wave computes 4 gate and the matching 4 up rows.
// Weights: Q4_0 repacked (all f32 scales, then 16-byte blocks); expert e's rows start at e * 2 * ff: ff gate rows,
// then ff up rows, each p.k long. b: u [t][k], c: act [t][slots][ff], d: ids [t][slots] (u32).
// p.n = ff, p.m = slots, p.k = d, p.stride = scale count.
layout(local_size_x=256) in;
void main(){
uint lane=gl_SubgroupInvocationID,part=lane%4,blocks=p.k/32,ts=gl_WorkGroupID.y,t=ts/p.m;
if(t>=batch())return;
uint e=d_u.v[ts],first=gl_WorkGroupID.x*16+gl_SubgroupID*4,xb=t*(p.k/4);
vec4 g=vec4(0),u=vec4(0);
for(uint b=lane/4;b<blocks;b+=16){
    vec4 x0=b_v4.v[xb+b*8+part],x1=b_v4.v[xb+b*8+part+4];
    float bias=8.0*dot(x0+x1,vec4(1));
    [[unroll]]for(uint r=0;r<4;r++){
        uint bg=(e*2*p.n+first+r)*blocks+b,bu=bg+p.n*blocks;
        uint qg=ww.words[p.stride+bg*4+part],qu=ww.words[p.stride+bu*4+part];
        g[r]=fma(dot(unpackUnorm4x8(qg&0x0f0f0f0fu)*255.0,x0)+dot(unpackUnorm4x8((qg>>4)&0x0f0f0f0fu)*255.0,x1)-bias,
                 uintBitsToFloat(ww.words[bg]),g[r]);
        u[r]=fma(dot(unpackUnorm4x8(qu&0x0f0f0f0fu)*255.0,x0)+dot(unpackUnorm4x8((qu>>4)&0x0f0f0f0fu)*255.0,x1)-bias,
                 uintBitsToFloat(ww.words[bu]),u[r]);
    }
}
g=subgroupAdd(g);u=subgroupAdd(u);
if(lane==0)[[unroll]]for(uint r=0;r<4;r++)if(first+r<p.n){float a=g[r];c_f.v[ts*p.n+first+r]=a/(1.0+exp(-a))*u[r];}
}
