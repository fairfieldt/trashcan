#version 460
#include "common.glsl"
// Qwen GQA: p.k is the query/KV head ratio (including six), padding each tile to 64 rows.
// p.r1 is the first query in a bounded 64-token score slab. All LDS
// producer/consumer phases use workgroup barriers; no wave scheduling assumptions.
// Row softmax over materialized scores. Masked and padding entries become zero;
// the reciprocal denominator is applied by attn_values.
layout(local_size_x=64) in;
void main(){
uint head=gl_WorkGroupID.x,t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x,nb=min(batch()-p.r1,64u);
if(t>=nb)return;
uint tq=1u<<findMSB(64u/p.k),t0=t&~(tq-1);
uint pos0=position()+p.r1+t0,kstart=p.window>0&&pos0+1>p.window?pos0+1-p.window:0;
uint pos=position()+p.r1+t,start=p.window>0&&pos+1>p.window?pos+1-p.window:0;
uint last=position()+p.r1+min(t0+tq,nb)-1;
uint lo=start-kstart,hi=pos-kstart,span=(last-kstart+32)&~31u;
uint base=(t*p.heads+head)*p.n;
float m=-1e30;
for(uint i=lo+l;i<=hi;i+=64)m=max(m,e_f.v[base+i]);
m=subgroupMax(m);
float sum=0;
for(uint i=l;i<span;i+=64){float w=0;if(i>=lo&&i<=hi){w=exp(e_f.v[base+i]-m);sum+=w;}e_f.v[base+i]=w;}
float s=subgroupAdd(sum);
if(l==0)f_f.v[t*p.heads+head]=1.0/s;
}
