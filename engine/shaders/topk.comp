#version 460
#include "common.glsl"
layout(local_size_x=256) in;
shared float candidates[1024],vals[4];
shared uint ids[4];
void main(){
uint l=gl_LocalInvocationID.x,t=gl_WorkGroupID.y,chunk=gl_WorkGroupID.x;
if(t>=batch())return;
uint start=chunk*1024;
for(uint j=l;j<1024;j+=256){
    float v=start+j<p.n?a_f.v[t*p.n+start+j]:-1e30;
    uint id=start+j+p.offset;
    candidates[j]=((p.flags&2)!=0&&(id==p.r0||id==p.r1))?-1e30:((p.flags&1)!=0?30*tanh(v/30):v);
}
barrier();
for(uint r=0;r<p.k;r++){
    float best=-1e30;uint id=0xffffffffu;
    for(uint j=l;j<1024;j+=256){
        float v=candidates[j];
        if(v>best||(v==best&&j<id)){best=v;id=j;}
    }
    float wave_best=subgroupMax(best);
    uint wave_id=subgroupMin(best==wave_best?id:0xffffffffu);
    if(gl_SubgroupInvocationID==0){vals[gl_SubgroupID]=wave_best;ids[gl_SubgroupID]=wave_id;}
    barrier();
    if(l==0){
        float v=vals[0];uint at=ids[0];
        for(uint wave=1;wave<4;wave++)if(vals[wave]>v||(vals[wave]==v&&ids[wave]<at)){v=vals[wave];at=ids[wave];}
        c_f.v[(t*p.m+chunk*p.k+r)*2]=v;
        c_u.v[(t*p.m+chunk*p.k+r)*2+1]=start+at+p.offset;
        candidates[at]=-1e30;
    }
    barrier();
}}
