#version 460
#include "common.glsl"
// QSA indexer: when token t completes a block of p.kind positions, pool it: the mean of the block's raw keys,
// RMS-normed with a learned weight and rotated (NeoX, first p.k dims) to the block's first position.
// One wave per token. a: raw key ring [offset][dim], b: norm weight [dim], c: pooled keys [cap / kind][dim].
// p.dim (<= 128), p.k = rotated dims (<= 64), p.kind = block size, p.cap, p.offset = ring rows, p.r0 = rope base
// bits, p.window = eps.
layout(local_size_x=64) in;
shared float sh[128];
void main(){uint t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x;if(t>=batch())return;
uint p1=position()+t+1;if(p1%p.kind!=0)return;
uint b=p1/p.kind-1;float m[2];
[[unroll]]for(uint h=0;h<2;h++){uint j=l+h*64;m[h]=0;
    if(j<p.dim)for(uint i=0;i<p.kind;i++)m[h]+=a_f.v[((b*p.kind+i)%p.offset)*p.dim+j];
    m[h]/=float(p.kind);}
float inv=inversesqrt(subgroupAdd(m[0]*m[0]+m[1]*m[1])/float(p.dim)+uintBitsToFloat(p.window));
[[unroll]]for(uint h=0;h<2;h++){uint j=l+h*64;if(j<p.dim)m[h]*=inv*b_f.v[j];sh[l+h*64]=m[h];}
barrier();
float pos=float(b*p.kind);uint half_rot=p.k/2;
if(l<p.k){uint i=l%half_rot;float th=pos*pow(uintBitsToFloat(p.r0),-2.0*float(i)/float(p.k));
    float co=cos(th),si=sin(th),partner=sh[l<half_rot?l+half_rot:l-half_rot];
    m[0]=l<half_rot?m[0]*co-partner*si:partner*si+m[0]*co;}
uint dst=(b%(p.cap/p.kind))*p.dim;
[[unroll]]for(uint h=0;h<2;h++){uint j=l+h*64;if(j<p.dim)c_f.v[dst+j]=m[h];}}
