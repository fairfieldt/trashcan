#version 460
#include "common.glsl"
// The block logits and Markov correction use the same linear vocabulary head.
// Assemble its input from the output-normalized block row and the biased correction.
layout(local_size_x=256) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.k) a_f.v[i] = b_f.v[p.m * p.k + i] + (a_f.v[i] + uintBitsToFloat(ww.words[i]));
}
