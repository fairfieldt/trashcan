#version 460
#include "common.glsl"
// Sublayer input of a hyper-connection mixer: u = mean over streams of xn_s * sigmoid(gate_s).
// a: xn [t][hc][n], b: gate [t][hc][n], c: u [t][n]. p.n = stream width, p.heads = streams.
layout(local_size_x=256) in;
void main(){uint i=gl_GlobalInvocationID.x,t=gl_WorkGroupID.y;if(i>=p.n||t>=batch())return;
uint base=t*p.n*p.heads;float u=0;
for(uint s=0;s<p.heads;s++){float g=b_f.v[base+s*p.n+i];u=fma(a_f.v[base+s*p.n+i],1.0/(1.0+exp(-g)),u);}
c_f.v[t*p.n+i]=u/float(p.heads);}
