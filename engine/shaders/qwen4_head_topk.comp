#version 460
#include "common.glsl"
// LM head candidates, step 1: the 64 best logits of each chunk of 1024 (higher score first, ties to the lower id), sorted,
// with their scores' bits: the candidates `topk` gives (k = 64, no flags), from a bitonic sort in shared memory (55
// steps) instead of 64 rounds of workgroup reductions. a: logits [t][p.n]; c: (score, id) pairs [t][p.m], chunk after
// chunk. Positions past p.n score -1e30, as in `topk`; NaN ranks below every number and -0 equals +0.
layout(local_size_x=256) in;
shared uint key[1024], at[1024];

// Larger is better, in the order of the scores.
uint order(float v) {
    if (isnan(v)) return 0u;
    uint b = v == 0.0 ? 0u : floatBitsToUint(v);
    return (b & 0x80000000u) != 0u ? ~b : b | 0x80000000u;
}

void main() {
    uint l = gl_LocalInvocationID.x, t = gl_WorkGroupID.y, chunk = gl_WorkGroupID.x;
    if (t >= batch()) return;
    uint start = chunk * 1024;
    for (uint j = l; j < 1024; j += 256) {
        key[j] = order(start + j < p.n ? a_f.v[t * p.n + start + j] : -1e30);
        at[j] = j;
    }
    barrier();
    for (uint size = 2; size <= 1024; size <<= 1) {
        for (uint stride = size >> 1; stride > 0; stride >>= 1) {
            for (uint q = l; q < 512; q += 256) {
                // Pair (i, i + stride); blocks with bit `size` clear sort best first.
                uint i = 2 * q - (q & (stride - 1)), j = i + stride;
                uint ki = key[i], kj = key[j], ai = at[i], aj = at[j];
                bool j_better = kj > ki || (kj == ki && aj < ai);
                if (j_better == ((i & size) == 0)) {
                    key[i] = kj; key[j] = ki; at[i] = aj; at[j] = ai;
                }
            }
            barrier();
        }
    }
    if (l < 64) {
        uint j = at[l], o = (t * p.m + chunk * 64 + l) * 2;
        c_f.v[o] = start + j < p.n ? a_f.v[t * p.n + start + j] : -1e30;
        c_u.v[o + 1] = start + j + p.offset;
    }
}
