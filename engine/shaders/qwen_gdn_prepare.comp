#version 460
#include "common.glsl"
#include "qwen_gdn_math.glsl"
// Prefill-only preparation, one wave per head and token. Normalize Q/K once per key head
// and evaluate decay/beta once per value head instead of repeating both for every state row wave.
// a: convolved [t][q | k | v], in place; b: [dt bias | A]; c: [t][alpha | beta], in place.
// V and the recurrent state are untouched. The following recurrence dispatch reads these stores.
layout(local_size_x=256) in;
void main(){
uint head=gl_WorkGroupID.x*4+gl_SubgroupID,t=gl_WorkGroupID.y,lane=gl_SubgroupInvocationID;
if(head<p.kvheads){
    uint base=t*p.n+head*p.dim,kd=p.kvheads*p.dim;
    vec2 q=vec2(a_f.v[base+lane],a_f.v[base+lane+64]);
    vec2 k=vec2(a_f.v[base+kd+lane],a_f.v[base+kd+lane+64]);
    gdn_normalize(q,k,uintBitsToFloat(p.r0),inversesqrt(float(p.dim)));
    a_f.v[base+lane]=q.x;a_f.v[base+lane+64]=q.y;
    a_f.v[base+kd+lane]=k.x;a_f.v[base+kd+lane+64]=k.y;
}
if(head<p.heads&&lane==0){
    uint at=t*2*p.heads+head;
    vec2 gates=gdn_gates(c_f.v[at],c_f.v[at+p.heads],b_f.v[head],b_f.v[p.heads+head]);
    c_f.v[at]=gates.x;c_f.v[at+p.heads]=gates.y;
}
}
