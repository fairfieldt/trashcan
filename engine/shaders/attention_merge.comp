#version 460
#include "common.glsl"
// Load partition headers together, then assign one output element to each lane.
// Every output keeps the serial kernel's maximum, denominator and FMA order.
layout(local_size_x=512) in;
layout(constant_id=0) const uint parts=32;
shared float hm[128],hd[128];
void main(){uint head=gl_WorkGroupID.x,t=gl_WorkGroupID.y,l=gl_LocalInvocationID.x;
uint base=(t*p.heads+head)*parts*(p.dim+2);
if(l<parts){hm[l]=e_f.v[base+l*(p.dim+2)];hd[l]=e_f.v[base+l*(p.dim+2)+1];}
barrier();
if(l>=p.dim)return;
float mx=-1e30;for(uint c=0;c<parts;c++)mx=max(mx,hm[c]);
float den=0,acc=0;
for(uint c=0;c<parts;c++){float w=exp(hm[c]-mx);den+=w*hd[c];
acc=fma(w,e_f.v[base+c*(p.dim+2)+2+l],acc);}
d_f.v[(t*p.heads+head)*p.dim+l]=acc/den;}
