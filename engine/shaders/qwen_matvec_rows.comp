#version 460
#include "common.glsl"
// matvecq4 with ROWS rows per subgroup instead of 4, for short rows (docs/tp8-optimization.md M1: the 5120 x 768
// out-projections of a TP8 rank walk only 24 blocks, two half-empty steps per wave, at about 95 GB/s). Each row keeps
// matvecq4's lane-to-block mapping, zero-point bias, FMA chain and subgroup reduction, so it equals matvecq4 bit for
// bit; a subgroup shares each step's activation loads and its final reductions across more rows. Written for any
// subgroup size: S/4 blocks per step, ROWS * subgroups rows per workgroup (64 with S = 64 and ROWS = 16).
// Weights in set 0 (p.stride: word offset of the packed nibbles), x in b, y in c; p.n rows, p.k row length.
layout(constant_id=0) const uint ROWS=16;
layout(local_size_x=256) in;
void main() {
    uint lane=gl_SubgroupInvocationID,S=gl_SubgroupSize;
    uint first=gl_WorkGroupID.x*(ROWS*gl_NumSubgroups)+gl_SubgroupID*ROWS,part=lane%4,blocks=p.k/32;
    float sums[ROWS];
    [[unroll]] for(uint r=0;r<ROWS;r++) sums[r]=0;
    for(uint b=lane/4;b<blocks;b+=S/4) {
        vec4 x0=b_v4.v[b*8+part],x1=b_v4.v[b*8+part+4];
        float bias=8.0*dot(x0+x1,vec4(1));
        [[unroll]] for(uint r=0;r<ROWS;r++) {
            uint row=min(first+r,p.n-1),block=row*blocks+b;
            float scale=uintBitsToFloat(ww.words[block]);
            uint qs=ww.words[p.stride+block*4+part];
            vec4 lo=unpackUnorm4x8(qs&0x0f0f0f0fu)*255.0;
            vec4 hi=unpackUnorm4x8((qs>>4)&0x0f0f0f0fu)*255.0;
            sums[r]=fma(dot(lo,x0)+dot(hi,x1)-bias,scale,sums[r]);
        }
    }
    [[unroll]] for(uint r=0;r<ROWS;r++) {
        float sum=subgroupAdd(sums[r]);
        if(lane==0&&first+r<p.n)c_f.v[first+r]=sum;
    }
}
