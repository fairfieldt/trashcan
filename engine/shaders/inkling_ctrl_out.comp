#version 460
#include "common.glsl"
// Inkling loop controller, second half: u_j[t][i] = u - tanh(W_forget_j[i] . z) * u + tanh(W_gain_j[i] . z) * m, in
// place in a. Workgroup per 64 elements x (group of 8 tokens, controller j): wave w holds the rank rows 16 w ..
// 16 w + 15 of its 64 elements in registers and sums them for each token; wave 0 adds the four and writes.
// Weights (set 0): gains [ctrl][p.n][d] f32 (rank-major), then forgets from word p.stride, controller p.offset + j.
// a: u [j][t][d] (updated), c: m [j][t][d], d: z [t][p.m][p.n]. p.k = d, p.n = 64.
#define TOK 8
layout(local_size_x=256) in;
shared float gs[TOK][4][64],fs[TOK][4][64];
void main(){
uint lane=gl_SubgroupInvocationID,wv=gl_SubgroupID,nb=batch(),D=p.k;
uint j=gl_WorkGroupID.y%p.m,t0=(gl_WorkGroupID.y/p.m)*TOK,i=gl_WorkGroupID.x*64+lane;
if(t0>=nb)return;
uint wo=(p.offset+j)*p.n*D+i;
float wg[16],wf[16];
[[unroll]]for(uint k=0;k<16;k++){uint r=wv*16+k;wg[k]=uintBitsToFloat(ww.words[wo+r*D]);wf[k]=uintBitsToFloat(ww.words[p.stride+wo+r*D]);}
for(uint z=0;z<TOK;z++){
    uint t=t0+z;
    if(t>=nb)break;
    uint zb=(t*p.m+j)*p.n+wv*16;
    float g=0,f=0;
    [[unroll]]for(uint k=0;k<16;k++){float zz=d_f.v[zb+k];g=fma(wg[k],zz,g);f=fma(wf[k],zz,f);}
    gs[z][wv][lane]=g;fs[z][wv][lane]=f;
}
barrier();
if(wv==0){
    for(uint z=0;z<TOK;z++){
        uint t=t0+z;
        if(t>=nb)break;
        float g=(gs[z][0][lane]+gs[z][1][lane])+(gs[z][2][lane]+gs[z][3][lane]);
        float f=(fs[z][0][lane]+fs[z][1][lane])+(fs[z][2][lane]+fs[z][3][lane]);
        uint at=(j*nb+t)*D+i;
        float u=a_f.v[at];
        a_f.v[at]=(u-tanh(f)*u)+tanh(g)*c_f.v[at];
    }
}
}
