#version 460
#include "common.glsl"
// RMS norm with a weight of each row: a[j][t] = b[j][t] / rms * w[p.offset + j] (w[p.offset] for every j with p.flags
// 1), eps p.r0 bits, rows of p.k = 2304 (9 values per thread, read once, so a and b may be the same rows).
// Workgroup x = t, y = j. Weights (set 0): norm vectors [..][p.k].
layout(local_size_x=256) in;
shared float red[4];
void main(){
uint t=gl_WorkGroupID.x,j=gl_WorkGroupID.y,nb=batch(),D=p.k,tid=gl_LocalInvocationID.x;
if(t>=nb)return;
uint base=(j*nb+t)*D;
uint wo=(p.offset+((p.flags&1)!=0?0:j))*D;
float s=0,v[9],w[9];
[[unroll]]for(uint k=0;k<9;k++){uint i=tid+256*k;v[k]=b_f.v[base+i];w[k]=uintBitsToFloat(ww.words[wo+i]);}
[[unroll]]for(uint k=0;k<9;k++)s=fma(v[k],v[k],s);
s=subgroupAdd(s);if(gl_SubgroupInvocationID==0)red[gl_SubgroupID]=s;barrier();
float inv=inversesqrt(((red[0]+red[1])+(red[2]+red[3]))/float(D)+uintBitsToFloat(p.r0));
[[unroll]]for(uint k=0;k<9;k++)a_f.v[base+tid+256*k]=v[k]*inv*w[k];
}
