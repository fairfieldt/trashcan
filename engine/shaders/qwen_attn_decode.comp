#version 460
#include "common.glsl"
// Split-K decode attention for every query head of one KV head at once (docs/tp8-optimization.md A1). One
// workgroup of one subgroup per (KV head, partition, column): the subgroup keeps the G query heads that read the
// KV head in registers, DIM / LANES contiguous dims per lane, and walks its partition's keys KB at a time. All K
// and V loads of a batch are issued first, then G * KB independent subgroup reductions, then one online-softmax
// update per head, so a key costs a fraction of a memory round trip instead of two. The head dimension and the
// lane count are compile-time, so the per-lane arrays stay in registers; the kernel runs on any subgroup size.
// a: queries [t][head][DIM] f32 (normed, rotated and pre-scaled), b: K cache f16 [slot][kvhead][DIM], c: V cache
// (same layout), e: partials [t][head][partition][DIM + 4] as (max, denominator, 0, 0, sums), vec4 aligned.
// p.heads = local query heads (G per KV head, in KV head order), p.kvheads, p.cap = cache slots, p.window (0: no
// sliding window), p.m = partitions; params[2] (when nonzero) limits the visible keys as in `attention_partial`.
layout(constant_id=0) const uint G=3;
layout(constant_id=1) const uint LANES=64;
layout(local_size_x_id=1) in;
#define DIM 256
#define KB 8
const uint DPL=DIM/LANES;
const uint V4=DPL/4;
void main(){
    uint parts=p.m,chunk=gl_WorkGroupID.x%parts,kvh=gl_WorkGroupID.x/parts,t=gl_WorkGroupID.y,l=gl_SubgroupInvocationID;
    if(t>=batch())return;
    uint pos=position()+t,start=p.window>0 && pos+1>p.window ? pos+1-p.window:0;
    uint end=params_u.v[2]!=0 ? min(pos,params_u.v[2]-1):pos;
    uint step=(end-start+parts)/parts;
    uint lo=start+chunk*step,hi=min(end,lo+step-1);
    vec4 q[G][V4],acc[G][V4];
    float mx[G],den[G];
    [[unroll]]for(uint h=0;h<G;h++){
        uint qb=((t*p.heads+kvh*G+h)*DIM+l*DPL)/4;
        [[unroll]]for(uint i=0;i<V4;i++){q[h][i]=a_v4.v[qb+i];acc[h][i]=vec4(0);}
        mx[h]=-1e30;den[h]=0;
    }
    for(uint key0=lo;key0<=hi;key0+=KB){
        uint cnt=min(KB,hi-key0+1);
        vec4 kk[KB][V4],vv[KB][V4];
        [[unroll]]for(uint j=0;j<KB;j++){
            if(j<cnt){
                uint row=((((key0+j)%p.cap)*p.kvheads+kvh)*DIM+l*DPL)/4;
                [[unroll]]for(uint i=0;i<V4;i++){
                    uvec2 kw=b_u2.v[row+i],vw=c_u2.v[row+i];
                    kk[j][i]=vec4(unpackHalf2x16(kw.x),unpackHalf2x16(kw.y));
                    vv[j][i]=vec4(unpackHalf2x16(vw.x),unpackHalf2x16(vw.y));
                }
            }
        }
        float sc[G][KB];
        [[unroll]]for(uint j=0;j<KB;j++){
            if(j<cnt){
                [[unroll]]for(uint h=0;h<G;h++){
                    float d=dot(q[h][0],kk[j][0]);
                    [[unroll]]for(uint i=1;i<V4;i++)d+=dot(q[h][i],kk[j][i]);
                    sc[h][j]=subgroupAdd(d);
                }
            }
        }
        [[unroll]]for(uint h=0;h<G;h++){
            float m=mx[h];
            [[unroll]]for(uint j=0;j<KB;j++)if(j<cnt)m=max(m,sc[h][j]);
            float rescale=exp(mx[h]-m);
            den[h]*=rescale;
            [[unroll]]for(uint i=0;i<V4;i++)acc[h][i]*=rescale;
            [[unroll]]for(uint j=0;j<KB;j++){
                if(j<cnt){
                    float w=exp(sc[h][j]-m);
                    den[h]+=w;
                    [[unroll]]for(uint i=0;i<V4;i++)acc[h][i]=fma(vec4(w),vv[j][i],acc[h][i]);
                }
            }
            mx[h]=m;
        }
    }
    [[unroll]]for(uint h=0;h<G;h++){
        uint base=((t*p.heads+kvh*G+h)*parts+chunk)*(DIM+4);
        [[unroll]]for(uint i=0;i<V4;i++)e_v4.v[(base+4)/4+l*V4+i]=acc[h][i];
        if(l==0){e_f.v[base]=mx[h];e_f.v[base+1]=den[h];e_f.v[base+2]=0;e_f.v[base+3]=0;}
    }
}
