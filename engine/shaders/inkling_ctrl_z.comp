#version 460
#include "common.glsl"
// Inkling loop controller, first half: z[t][j][r] = W_down_j[r] . [rms(u_j[t]); rms(m_j[t])] for the p.m (1 or 3)
// controllers j of a sublayer (rms: no weight, eps 1e-6). Workgroup per (row r of p.n = 64) x (t * p.m + j): its 256
// threads take 9 elements of u and 9 of m each (p.k = d = 2304), issuing every load first, and add through LDS.
// Weights (set 0): W_down [ctrl][p.n][2 * d] f32, controller p.offset + j. b: u [j][t][d], c: m [j][t][d],
// d: z [t][p.m][p.n].
layout(local_size_x=256) in;
shared float red[4][4];
void main(){
uint tid=gl_LocalInvocationID.x,lane=gl_SubgroupInvocationID,wv=gl_SubgroupID,r=gl_WorkGroupID.x,tj=gl_WorkGroupID.y,nb=batch();
uint t=tj/p.m,j=tj%p.m,D=p.k;
if(t>=nb)return;
uint ub=(j*nb+t)*D,wo=((p.offset+j)*p.n+r)*2*D;
float u[9],m[9],wu[9],wm[9];
[[unroll]]for(uint k=0;k<9;k++){uint i=tid+256*k;u[k]=b_f.v[ub+i];m[k]=c_f.v[ub+i];
    wu[k]=uintBitsToFloat(ww.words[wo+i]);wm[k]=uintBitsToFloat(ww.words[wo+D+i]);}
float su=0,sm=0,du=0,dm=0;
[[unroll]]for(uint k=0;k<9;k++){su=fma(u[k],u[k],su);sm=fma(m[k],m[k],sm);du=fma(wu[k],u[k],du);dm=fma(wm[k],m[k],dm);}
su=subgroupAdd(su);sm=subgroupAdd(sm);du=subgroupAdd(du);dm=subgroupAdd(dm);
if(lane==0){red[0][wv]=su;red[1][wv]=sm;red[2][wv]=du;red[3][wv]=dm;}
barrier();
if(tid==0){
    float SU=(red[0][0]+red[0][1])+(red[0][2]+red[0][3]),SM=(red[1][0]+red[1][1])+(red[1][2]+red[1][3]);
    float DU=(red[2][0]+red[2][1])+(red[2][2]+red[2][3]),DM=(red[3][0]+red[3][1])+(red[3][2]+red[3][3]);
    d_f.v[(t*p.m+j)*p.n+r]=DU*inversesqrt(SU/float(D)+1e-6)+DM*inversesqrt(SM/float(D)+1e-6);
}
}
