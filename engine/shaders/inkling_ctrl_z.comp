#version 460
#include "common.glsl"
// Inkling loop controller, first half: z[t][j][r] = W_down_j[r] . [rms(u_j[t]); rms(m_j[t])] for the p.m (1 or 3)
// controllers j of a sublayer (rms: no weight, eps 1e-6). Workgroup per (row r of p.n = 64) x (group of 8 tokens,
// controller j): its 256 threads hold 9 weights of each half of the row in registers and take 9 elements of u and m of
// each token, adding through LDS. Weights (set 0): W_down [ctrl][p.n][2 * d] f32, controller p.offset + j.
// b: u [p.cap][t][d] (one set for all controllers with p.cap 1), c: m [j][t][d], d: z [t][p.m][p.n]. p.k = d = 2304.
#define TOK 8
layout(local_size_x=256) in;
shared float red[TOK][4][4];
void main(){
uint tid=gl_LocalInvocationID.x,lane=gl_SubgroupInvocationID,wv=gl_SubgroupID,r=gl_WorkGroupID.x,nb=batch();
uint j=gl_WorkGroupID.y%p.m,t0=(gl_WorkGroupID.y/p.m)*TOK,D=p.k;
if(t0>=nb)return;
uint wo=((p.offset+j)*p.n+r)*2*D;
float wu[9],wm[9];
[[unroll]]for(uint k=0;k<9;k++){uint i=tid+256*k;wu[k]=uintBitsToFloat(ww.words[wo+i]);wm[k]=uintBitsToFloat(ww.words[wo+D+i]);}
for(uint z=0;z<TOK;z++){
    uint t=t0+z;
    if(t>=nb)break;
    uint ub=(min(j,p.cap-1)*nb+t)*D,mb=(j*nb+t)*D;
    float su=0,sm=0,du=0,dm=0;
    [[unroll]]for(uint k=0;k<9;k++){uint i=tid+256*k;float u=b_f.v[ub+i],m=c_f.v[mb+i];
        su=fma(u,u,su);sm=fma(m,m,sm);du=fma(wu[k],u,du);dm=fma(wm[k],m,dm);}
    su=subgroupAdd(su);sm=subgroupAdd(sm);du=subgroupAdd(du);dm=subgroupAdd(dm);
    if(lane==0){red[z][0][wv]=su;red[z][1][wv]=sm;red[z][2][wv]=du;red[z][3][wv]=dm;}
}
barrier();
if(tid<TOK&&t0+tid<nb){
    uint z=tid;
    float SU=(red[z][0][0]+red[z][0][1])+(red[z][0][2]+red[z][0][3]),SM=(red[z][1][0]+red[z][1][1])+(red[z][1][2]+red[z][1][3]);
    float DU=(red[z][2][0]+red[z][2][1])+(red[z][2][2]+red[z][2][3]),DM=(red[z][3][0]+red[z][3][1])+(red[z][3][2]+red[z][3][3]);
    d_f.v[((t0+z)*p.m+j)*p.n+r]=DU*inversesqrt(SU/float(D)+1e-6)+DM*inversesqrt(SM/float(D)+1e-6);
}
}
