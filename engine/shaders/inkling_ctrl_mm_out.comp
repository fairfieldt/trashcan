#version 460
#include "common.glsl"
// Inkling loop controller for prefill batches, second half: u'_j[t][i] = u - tanh(W_forget_j[i] . z) * u +
// tanh(W_gain_j[i] . z) * m. Workgroup (x: 64 elements, y: COLS tokens of controller j): a lane owns element i and
// walks its 64 gain and 64 forget weights four ranks at a time, adding them into the COLS tokens' sums; z is the
// same for every lane (scalar loads, 4 KB per workgroup). Holding the 128 weights in registers for 32 tokens took
// 140 registers, which leaves one wave per SIMD: 18.4 ms per 256 tokens against 9.3 this way (44 registers), with
// the same sums in the same order.
// Weights (set 0): gains [ctrl][p.n][D] f32 (rank-major, so the lanes of a wave load neighbouring weights), then
// forgets from word p.stride, controller p.offset + j.
// a: u' [j][t][D], b: the sublayer's inputs: u rows [p.cap][t][D] (one set for all controllers with p.cap 1), then
// m rows [p.m][t][D]; d: z [t][p.m][p.n]. p.k = D, p.n = 64.
#define COLS 16
layout(local_size_x=64) in;
layout(set=2,binding=3,std430) readonly restrict buffer ZRows { vec4 v[]; } zrow;
#define DOT4(A_,W_,X_) A_=fma(W_.x,X_.x,A_);A_=fma(W_.y,X_.y,A_);A_=fma(W_.z,X_.z,A_);A_=fma(W_.w,X_.w,A_);
void main(){
uint nb=batch(),D=p.k,groups=(nb+COLS-1)/COLS,j=gl_WorkGroupID.y/groups,t0=(gl_WorkGroupID.y%groups)*COLS;
uint i=gl_WorkGroupID.x*64+gl_LocalInvocationID.x;
if(t0>=nb)return;
uint wo=(p.offset+j)*p.n*D+i,us=min(j,p.cap-1),ms=p.cap+j;
uint zb[COLS];float g[COLS],f[COLS];
[[unroll]]for(uint t=0;t<COLS;t++){zb[t]=((min(t0+t,nb-1)*p.m+j)*p.n)/4;g[t]=0;f[t]=0;}
for(uint r=0;r<16;r++){
    vec4 wg,wf;
    [[unroll]]for(uint x=0;x<4;x++){
        wg[x]=uintBitsToFloat(ww.words[wo+(4*r+x)*D]);wf[x]=uintBitsToFloat(ww.words[p.stride+wo+(4*r+x)*D]);}
    [[unroll]]for(uint t=0;t<COLS;t++){vec4 z=zrow.v[zb[t]+r];
        DOT4(g[t],wg,z) DOT4(f[t],wf,z)}
}
[[unroll]]for(uint t=0;t<COLS;t++){uint tt=t0+t;
    if(tt<nb){float u=b_f.v[(us*nb+tt)*D+i],m=b_f.v[(ms*nb+tt)*D+i];
        a_f.v[(j*nb+tt)*D+i]=(u-tanh(f[t])*u)+tanh(g[t])*m;}}
}
