#version 460
#include "common.glsl"
// First half of a hyper-connection mixer (Q8_0) for C tokens, a lane per row, after qwen4_mix_prep: workgroup
// (g, tg * CH + c) takes rows 64 g.. (the m bottleneck rows and the 4 write rows of the fused matrix) over chunk c of
// the residual (1280 values, half a stream), its 4 waves 5 lines each; every weight is decoded once for the C
// tokens, whose inputs gamma_s * x_s are the same for every lane (scalar loads). The waves' sums go through LDS to
// the partials [t][c][m + 8]; the last workgroup of the token group to finish (counted in extra, which it resets)
// applies the stream norms, row = sum_s inv_s * (W_s . (gamma_s * x_s)), and writes qwen4_mix_down's output:
// bottleneck rows silu(row / 4), write rows 2 sigmoid(row / 4), the inverse norms.
// b: g [t][hc][n], c: partials, d: sums of squares [t][hc * n / 256] (qwen4_mix_prep), f: out [t][m + 8],
// extra: counters (u32 per token group). p.n = stream width, p.k = hc * n, p.m = bottleneck rows,
// p.stride = word offset of the blocks, p.r0 = eps bits.
#define CHUNK 1280
layout(local_size_x=256) in;
layout(constant_id=0) const uint C=1;
layout(binding=0,std430) readonly restrict buffer WeightQuads { uvec4 q[]; } wq;
layout(set=2,binding=2,std430) coherent buffer Partials { float v[]; } cp;
layout(set=2,binding=7,std430) coherent buffer Counters { uint v[]; } cnt;
shared float red[4][4][64];
shared bool last;
vec4 i8(uint w){return vec4(ivec4(w<<24,w<<16,w<<8,w)>>24);}
void main(){
uint lane=gl_SubgroupInvocationID,wv=gl_SubgroupID,tid=gl_LocalInvocationID.x,nb=batch();
uint CH=p.k/CHUNK,tg=gl_WorkGroupID.y/CH,c=gl_WorkGroupID.y%CH,t0=tg*C;
if(t0>=nb)return;
uint rows=p.m+4,P=p.m+8,row=gl_WorkGroupID.x*64+lane,r=min(row,rows-1),blocks=p.k/32;
const uint lines=CHUNK/64/4;
uint l0=c*(CHUNK/64)+wv*lines;
uint xo[4];[[unroll]]for(uint z=0;z<4;z++)xo[z]=min(t0+z,nb-1)*(p.k/4)+l0*16;
float acc[4];[[unroll]]for(uint z=0;z<4;z++)acc[z]=0;
for(uint li=0;li<lines;li++){
    uint blk=r*blocks+2*(l0+li),a=p.stride/4+blk*2;
    uvec4 q[4];q[0]=wq.q[a];q[1]=wq.q[a+1];q[2]=wq.q[a+2];q[3]=wq.q[a+3];
    vec2 d=unpackHalf2x16(ww.words[blk/2]);
    [[unroll]]for(uint h=0;h<2;h++){
        float s[4];[[unroll]]for(uint z=0;z<4;z++)s[z]=0;
        [[unroll]]for(uint j=0;j<8;j++){vec4 w=i8(q[h*2+j/4][j%4]);
            [[unroll]]for(uint z=0;z<C;z++){vec4 x=b_v4.v[xo[z]+li*16+h*8+j];s[z]=fma(w.x,x.x,s[z]);s[z]=fma(w.y,x.y,s[z]);
                s[z]=fma(w.z,x.z,s[z]);s[z]=fma(w.w,x.w,s[z]);}}
        [[unroll]]for(uint z=0;z<C;z++)acc[z]=fma(s[z],d[h],acc[z]);
    }
}
[[unroll]]for(uint z=0;z<C;z++)red[wv][z][lane]=acc[z];
barrier();
if(wv==0&&row<rows)[[unroll]]for(uint z=0;z<C;z++)if(t0+z<nb)
    cp.v[((t0+z)*CH+c)*P+row]=(red[0][z][lane]+red[1][z][lane])+(red[2][z][lane]+red[3][z][lane]);
memoryBarrierBuffer();
barrier();
if(tid==0)last=atomicAdd(cnt.v[tg],1u)==gl_NumWorkGroups.x*CH-1u;
barrier();
if(!last)return;
memoryBarrierBuffer();
if(tid==0)cnt.v[tg]=0;
float eps=uintBitsToFloat(p.r0);
uint SQ=p.k/256,per=SQ/4,cps=CH/4;
for(uint z=0;z<C;z++)if(t0+z<nb){uint t=t0+z,base=t*CH*P,o=t*P;
    float inv[4];
    [[unroll]]for(uint s=0;s<4;s++){float qs=0;for(uint i=0;i<per;i++)qs+=d_f.v[t*SQ+s*per+i];
        inv[s]=inversesqrt(qs/float(p.n)+eps);}
    for(uint j=tid;j<rows;j+=256){float v=0;
        [[unroll]]for(uint s=0;s<4;s++){float as=0;for(uint i=0;i<cps;i++)as+=cp.v[base+(s*cps+i)*P+j];v+=inv[s]*as;}
        float y=v*0.25;f_f.v[o+j]=j<p.m?y/(1.0+exp(-y)):2.0/(1.0+exp(-y));}
    if(tid<4)f_f.v[o+p.m+4+tid]=inv[tid];}
}
