#version 450
// Ping-pong between two roles through a shared flag buffer. Role 0 writes round k, then waits for role 1 to echo
// k back; role 1 waits for k, then echoes it. Each round is two one-way hops. The spin is bounded so a flag that
// never becomes visible fails cleanly instead of hanging the GPU.
// Dispatch 1 workgroup per GPU for cross-GPU (role from push constant), or 2 workgroups on one GPU for loopback.
//
// MODE 0: coherent volatile loads and stores
// MODE 1: Vulkan memory model device-scope atomic load (acquire) and store (release)
// MODE 2: read-modify-write atomics (atomicAdd(x, 0) to read, atomicExchange to write)
// MODE 3: Vulkan memory model, buffer declared nontemporal volatile coherent (asks for SLC on every access)

#if MODE == 1 || MODE == 3
#pragma use_vulkan_memory_model
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_nontemporal_keyword : require
#endif

layout(local_size_x = 64) in;

#if MODE == 0
layout(std430, binding = 0) coherent volatile buffer Flags { uint v[]; } flags;
#elif MODE == 3
layout(std430, binding = 0) nontemporal volatile coherent buffer Flags { uint v[]; } flags;
#else
layout(std430, binding = 0) buffer Flags { uint v[]; } flags;
#endif
layout(std430, binding = 1) buffer Result { uint r[]; } result;

layout(push_constant) uniform PC {
    uint role_base;
    uint rounds;
    uint max_spin;
    uint stride;    // flag slots are this many uints apart, to keep them on separate cache lines
} pc;

uint read_flag(uint i) {
#if MODE == 0 || MODE == 3
    return flags.v[i];
#elif MODE == 1
    return atomicLoad(flags.v[i], gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsAcquire | gl_SemanticsMakeVisible);
#else
    return atomicAdd(flags.v[i], 0);
#endif
}

void write_flag(uint i, uint k) {
#if MODE == 0 || MODE == 3
    flags.v[i] = k;
    memoryBarrierBuffer();
#elif MODE == 1
    atomicStore(flags.v[i], k, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease | gl_SemanticsMakeAvailable);
#else
    atomicExchange(flags.v[i], k);
#endif
}

void main() {
    if (gl_LocalInvocationIndex != 0) {
        return;
    }
    const uint role = pc.role_base + gl_WorkGroupID.x;
    const uint mine = role * pc.stride;
    const uint peer = (1 - role) * pc.stride;

    uint failed_round = 0;
    uint spins = 0;
    for (uint k = 1; k <= pc.rounds; k++) {
        if (role == 0) {
            write_flag(mine, k);
        }
        uint s = 0;
        while (read_flag(peer) < k) {
            s++;
            if (s >= pc.max_spin) {
                break;
            }
        }
        if (s >= pc.max_spin) {
            failed_round = k;
            break;
        }
        spins += s;
        if (role == 1) {
            write_flag(mine, k);
        }
    }
    result.r[role * 4 + 0] = failed_round;
    result.r[role * 4 + 1] = spins;
}
