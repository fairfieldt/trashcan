#version 450
// Write-only store pattern for the host-write test: element i goes to dst[i * stride], grid-stride loop.
// WIDE 0 stores one uint per lane, WIDE 1 one uvec4. With stride 1 each wave writes a contiguous run (256 B or 1 KiB);
// stride 16 (uint) or 4 (uvec4) puts one store in each 64-byte line, so every line is only partly written.

layout(local_size_x = 64) in;

#if WIDE
layout(std430, binding = 0) writeonly buffer Dst { uvec4 v[]; } dst;
#else
layout(std430, binding = 0) writeonly buffer Dst { uint v[]; } dst;
#endif

layout(push_constant) uniform PC {
    uint n;       // elements to store
    uint stride;  // in elements
    uint value;
} pc;

void main() {
    const uint total = gl_NumWorkGroups.x * 64;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += total) {
#if WIDE
        dst.v[i * pc.stride] = uvec4(pc.value + i);
#else
        dst.v[i * pc.stride] = pc.value + i;
#endif
    }
}
