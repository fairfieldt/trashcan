#version 450
// dst[i] = src[i], 16 bytes per invocation
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer S { uvec4 src[]; };
layout(binding = 1) writeonly buffer D { uvec4 dst[]; };
layout(push_constant) uniform P { uint n; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < n)
        dst[i] = src[i];
}
