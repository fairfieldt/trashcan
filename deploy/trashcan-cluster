class Run:
    def __init__(self, cfg, recipe, procs, a, attached):
        self.cfg, self.recipe, self.procs, self.a, self.attached = cfg, recipe, procs, a, attached
        self.id = time.strftime("%Y%m%d-%H%M%S") + f"-{recipe}"
        self.dir = f"{cfg.run_dir}/{self.id}"
        self.wrap = parse_wraps(a.wrap)
        self.stopping = False

    def save(self):
        self.cfg.state.mkdir(parents=True, exist_ok=True)
        rec = {"id": self.id, "recipe": self.recipe, "dir": self.dir, "wrap": self.a.wrap,
               "procs": [p.as_dict(self.dir) for p in self.procs], "started": time.time()}
        (self.cfg.state / "run.json").write_text(json.dumps(rec, indent=1) + "\n")

    def prefix(self, node):
        return self.wrap.get(node.name, self.wrap.get("*", []))

    def command(self, p):
        """The node command: write the engine's pid, then exec it with its output in the run's log."""
        cfg = self.cfg
        binary = p.node.path(cfg.remote(cfg.binary))
        argv = [p.node.path(x) for x in p.argv]
        inner = f"echo $$ > {self.dir}/{p.role}.pid; exec {shlex.quote(binary)} {shlex.join(argv)}"
        cmd = ["bash", "-c", inner]
        if str(cfg.cpu_latency_us) == "0":
            # Holds a 0 us CPU latency request for the process's lifetime only (busy-polls idle cores; docs/qwen.md).
            cmd = ["sudo", "-n", "python3", f"{cfg.workspace}/scripts/latency-run.py", *cmd]
        cmd = [*self.prefix(p.node), *cmd]
        env = " ".join(self.a.env or [])
        body = f"cd {cfg.workspace} && mkdir -p {self.dir} && exec env {env} {shlex.join(cmd)} >> {self.dir}/{p.role}.log 2>&1"
        if self.attached:
            return body
        # setsid -f: a new session, so the process outlives this SSH connection, and ssh returns at once.
        return f"mkdir -p {self.dir} && setsid -f bash -c {shlex.quote(body)} > /dev/null 2>&1 < /dev/null"

    def start(self, p):
        say(f"start {p.role} on {p.node.name}")
        if self.attached:
            p.ssh = subprocess.Popen(ssh_argv(p.node, self.command(p)), stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        else:
            ssh(p.node, self.command(p))

    def state(self, p):
        """(alive, listening) from the node."""
        q = (f"pid=$(cat {self.dir}/{p.role}.pid 2>/dev/null); "
             f"if [ -n \"$pid\" ] && kill -0 $pid 2>/dev/null; then echo alive; else echo dead; fi; "
             f"ss -ltnH 'sport = :{p.port}' | grep -q . && echo listening || echo closed")
        r = ssh(p.node, q, check=False, timeout=30)
        out = r.stdout.split()
        return (out[:1] == ["alive"]), (out[1:2] == ["listening"])

    def health(self, p):
        q = f"python3 -c \"import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:{p.port}/health', timeout=3).status)\""
        r = ssh(p.node, q, check=False, timeout=30)
        return r.stdout.strip() == "200"

    def tail(self, p, n=15):
        r = ssh(p.node, f"tail -n {n} {self.dir}/{p.role}.log 2>/dev/null", check=False, timeout=30)
        return r.stdout.rstrip()

    def wait_ready(self):
        """Start every process in order and wait for it: a node until its port listens, the driver until /health
        answers. Any process that ends first fails the run."""
        r = self.cfg.recipes[self.recipe]
        for p in self.procs:
            self.start(p)
            deadline = time.time() + (r.get("load_deadline_s", 300) if p.role == "driver" else r.get("listen_deadline_s", 60))
            t0 = time.time()
            while True:
                if self.stopping:
                    return False
                alive, listening = self.state(p)
                if p.ssh is not None and p.ssh.poll() is not None and not alive:
                    alive = False
                if not alive and time.time() - t0 > 3:
                    say(f"{p.role} on {p.node.name} ended before it was ready:\n{self.tail(p)}")
                    return False
                for q in self.procs[: self.procs.index(p)]:
                    if not self.state(q)[0]:
                        say(f"{q.role} on {q.node.name} ended:\n{self.tail(q)}")
                        return False
                if p.role != "driver" and listening:
                    say(f"{p.role} on {p.node.name} listening on {p.port} after {time.time() - t0:.0f} s")
                    break
                if p.role == "driver" and listening and self.health(p):
                    say(f"driver on {p.node.name} ready on 127.0.0.1:{p.port} after {time.time() - t0:.0f} s")
                    break
                if time.time() > deadline:
                    say(f"{p.role} on {p.node.name} not ready after {deadline - t0:.0f} s:\n{self.tail(p)}")
                    return False
                time.sleep(1)
        return True

    def stop(self):
        self.stopping = True
        return stop_recorded(self.cfg, {"dir": self.dir, "procs": [p.as_dict(self.dir) for p in self.procs],
                                        "wrap": self.a.wrap})


def parse_wraps(items):
    out = {}
    for w in items or []:
        host, _, prefix = w.partition("=")
        out[host] = shlex.split(prefix)
    return out


def stop_recorded(cfg, rec):
    """Stop a run's processes (driver first, then all nodes at once: SIGTERM, then SIGKILL), restore the GPUs' DPM
    level and copy the logs here. Returns True when everything stopped."""
    procs = rec["procs"]
    wraps = parse_wraps(rec.get("wrap"))
    binary = cfg.remote(cfg.binary)

    def signal_and_wait(p, sig, wait):
        n = cfg.by_name[p["node"]]
        q = (f"pid=$(cat {p['pidfile']} 2>/dev/null) || exit 0; "
             f"grep -qa {shlex.quote(os.path.basename(binary))} /proc/$pid/cmdline 2>/dev/null || exit 0; "
             f"kill -{sig} $pid 2>/dev/null; for i in $(seq {wait * 5}); do kill -0 $pid 2>/dev/null || exit 0; sleep 0.2; done; exit 1")
        return ssh(n, q, check=False, timeout=wait + 30).returncode == 0

    ok = True
    for group in ([p for p in procs if p["role"] == "driver"], [p for p in procs if p["role"] != "driver"]):
        if not group:
            continue
        done = {}
        for sig, wait in (("TERM", 30), ("KILL", 10)):
            left = [p for p in group if not done.get(p["role"])]
            if not left:
                break
            r = parallel_items(left, lambda p: signal_and_wait(p, sig, wait))
            for p in left:
                done[p["role"]] = r[p["role"]] is True
                if done[p["role"]]:
                    say(f"stopped {p['role']} on {p['node']}" + (" (SIGKILL)" if sig == "KILL" else ""))
        for p in group:
            if not done.get(p["role"]):
                say(f"{p['role']} on {p['node']} still running after SIGKILL")
                ok = False
    # Restore: the engine raises its GPUs to the high DPM level while it works and returns them to auto when idle;
    # a process that was killed leaves them high (35 W more per idle D700).
    hosts = sorted({p["node"] for p in procs})
    restore = ("for f in /sys/class/drm/card[0-9]*/device/power_dpm_force_performance_level; do "
               "[ -e \"$f\" ] || continue; [ \"$(cat $f)\" = auto ] || { echo auto | sudo -n tee $f > /dev/null && echo \"$f: restored auto\"; }; done; "
               "pgrep -af 'latency-run.py' | grep -v pgrep || true")
    res = parallel([cfg.by_name[h] for h in hosts],
                   lambda n: ssh(n, shlex.join([*wraps.get(n.name, wraps.get("*", [])), "bash", "-c", restore]), check=False).stdout.strip())
    for h, v in res.items():
        if v:
            say(f"{h}: {v}")
    # Logs to the local state directory.
    local = cfg.state / "logs" / os.path.basename(rec["dir"])
    local.mkdir(parents=True, exist_ok=True)
    for p in procs:
        r = ssh(cfg.by_name[p["node"]], f"cat {p['log']} 2>/dev/null", check=False)
        (local / f"{p['role']}-{p['node']}.log").write_text(r.stdout)
    say(f"logs in {local}")
    return ok


def parallel_items(items, fn):
    out = {}

    def run(p):
        try:
            out[p["role"]] = fn(p)
        except Exception as e:  # noqa: BLE001
            out[p["role"]] = e
    ts = [threading.Thread(target=run, args=(p,)) for p in items]
    for t in ts:
        t.start()
    for t in ts:
        t.join()
    return out


def smoke_request(run):
    """One greedy request to the driver; the recipe's smoke check must appear in the answer."""
    r = run.cfg.recipes[run.recipe]
    d = run.procs[-1]
    body = {"input": r.get("smoke_prompt", "What is the capital of France? Answer with one word."),
            "temperature": 0, "max_output_tokens": r.get("smoke_tokens", 64), "reasoning": {"effort": "none"},
            "store": False}
    code = ("import json, sys, time, urllib.error, urllib.request\n"
            f"req = urllib.request.Request('http://127.0.0.1:{d.port}/v1/responses', data=sys.stdin.buffer.read(), "
            "headers={'Content-Type': 'application/json'})\n"
            "t = time.time()\n"
            "try:\n    r = json.load(urllib.request.urlopen(req, timeout=600))\n"
            "except urllib.error.HTTPError as e:\n    sys.exit(f'HTTP {e.code}: {e.read().decode()[:600]}')\n"
            "t = time.time() - t\n"
            "text = ''.join(c.get('text', '') for o in r.get('output', []) if o.get('type') == 'message' for c in o.get('content', []))\n"
            "print(json.dumps({'status': r.get('status'), 'text': text, 'seconds': round(t, 2), 'usage': r.get('usage')}))\n")
    res = ssh(d.node, f"python3 -c {shlex.quote(code)}", check=False, timeout=900, input=json.dumps(body))
    if res.returncode != 0:
        say(f"smoke request failed: {res.stderr.strip()[-500:]}")
        return False
    out = json.loads(res.stdout)
    want = r.get("smoke_expect", "Paris")
    ok = out["status"] == "completed" and want.lower() in out["text"].lower()
    say(f"smoke: status {out['status']}, {out['seconds']} s, usage {out['usage']}, answer {out['text'][:200]!r}: "
        f"{'PASS' if ok else 'FAIL'} (want {want!r})")
    vram = ssh(d.node, "for d in /sys/bus/pci/drivers/amdgpu/0000:*; do echo \"$(basename $d) $(( $(cat $d/mem_info_vram_used) >> 20 )) MiB\"; done",
               check=False).stdout.split("\n")
    say(f"driver VRAM in use: {', '.join(v for v in vram if v)}")
    return ok


def launch(cfg, a, mode):
    ok, procs, nodes = preflight(cfg, a.recipe, a, quiet=True)
    if not ok:
        return 1
    run = Run(cfg, a.recipe, procs, a, attached=(mode != "up"))
    if (cfg.state / "run.json").exists() and mode == "up":
        die(f"a run is recorded in {cfg.state / 'run.json'}: `down` first")
    run.save()
    say(f"run {run.id}: logs on the nodes in {run.dir}")

    def stopped(signum, _frame):
        if run.stopping:
            return
        say(f"signal {signum}: stopping every process")
        run.stop()
        (cfg.state / "run.json").unlink(missing_ok=True)
        os._exit(128 + signum)

    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, stopped)
    t0 = time.time()
    ready = run.wait_ready()
    if not ready:
        say("start failed: stopping every process")
        run.stop()
        (cfg.state / "run.json").unlink(missing_ok=True)
        return 1
    say(f"{a.recipe} ready after {time.time() - t0:.0f} s")
    if mode == "smoke":
        good = smoke_request(run)
        stopped_ok = run.stop()
        (cfg.state / "run.json").unlink(missing_ok=True)
        return 0 if good and stopped_ok else 1
    if mode == "up":
        say(f"running; `trashcan-cluster down` stops it. Server: 127.0.0.1:{cfg.ports['serve']} on {nodes[0].name} "
            "(forward it with ssh -L, or add --host to the recipe)")
        return 0
    say("running; Ctrl-C stops every process")
    while True:
        time.sleep(5)
        for p in run.procs:
            if not run.state(p)[0]:
                say(f"{p.role} on {p.node.name} ended:\n{run.tail(p)}\nstopping every process")
                run.stop()
                (cfg.state / "run.json").unlink(missing_ok=True)
                return 1


def cmd_down(cfg, a):
    f = cfg.state / "run.json"
    if not f.exists():
        say("no run recorded")
        return 0
    rec = json.loads(f.read_text())
    if a.wrap:
        rec["wrap"] = a.wrap
    ok = stop_recorded(cfg, rec)
    f.unlink()
    return 0 if ok else 1


def cmd_status(cfg, a):
    f = cfg.state / "run.json"
    if not f.exists():
        say("no run recorded")
        return 0
    rec = json.loads(f.read_text())
    say(f"run {rec['id']} ({rec['recipe']}), started {time.ctime(rec['started'])}")
    for p in rec["procs"]:
        r = ssh(cfg.by_name[p["node"]], f"pid=$(cat {p['pidfile']} 2>/dev/null) && kill -0 $pid 2>/dev/null && echo running || echo stopped",
                check=False)
        say(f"  {p['role']:9s} {p['node']:10s} port {p['port']}: {r.stdout.strip()}")
    return 0


def cmd_install(cfg, a):
    """Copy the node installer to each node and run it there (preview unless --apply)."""
    repo = HERE.parent
    parts = ["nodes/macpro/install.sh", "nodes/macpro/root", "scripts/fancurve.sh", "scripts/fancurve.service"]
    if (repo / "lights").is_dir():
        parts += ["lights", "kernel/patches-7.3"]   # lights/install.sh can build the driver from the patches
    nodes = select_nodes(cfg, a.nodes, len(a.nodes.split(","))) if a.nodes else cfg.nodes
    reg = cfg.state / "nodes.tsv"
    if a.registry and not reg.exists():
        die(f"no {reg}: run `registry` first")
    rc = 0
    for n in nodes:
        dest = ".cache/trashcan-node-install"
        ssh(n, f"rm -rf ~/{dest} && mkdir -p ~/{dest}")
        subprocess.run(["rsync", "-aR", "-e", "ssh " + " ".join(SSH_OPTS), *parts, f"{n.ssh}:{dest}/"], cwd=repo, check=True)
        args = (["--apply"] if a.apply else []) + (["--uninstall"] if a.uninstall else []) + \
            (["--skip", a.skip] if a.skip else [])
        if a.lights is not None:
            largs = a.lights
            if a.lights_bin:
                subprocess.run(["rsync", "-a", "-e", "ssh " + " ".join(SSH_OPTS), a.lights_bin, f"{n.ssh}:{dest}/portlights"], check=True)
                largs = f"--bin {dest}/portlights {largs}".strip()
            args += ["--lights"] + (["--lights-args", largs] if largs else [])
        if a.registry:
            subprocess.run(["rsync", "-a", "-e", "ssh " + " ".join(SSH_OPTS), str(reg), f"{n.ssh}:{dest}/nodes.tsv"], check=True)
            args += ["--registry", f"{dest}/nodes.tsv"]
        r = subprocess.run(ssh_argv(n, f"cd ~ && sudo -n bash {dest}/nodes/macpro/install.sh {shlex.join(args)}"))
        rc |= r.returncode
    return rc


def cmd_hash(cfg, a):
    n = cfg.by_name.get(a.node) or Node({"name": a.node, "index": 1})
    info = probe(cfg, n, a.paths, True, binary=False)
    for path in a.paths:
        f = info["files"][path]
        say(f"{f.get('sha256', '-')}  {f.get('size', '-')}  {path}")
    return 0


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-c", "--config", default=os.environ.get("TRASHCAN_CLUSTER", "cluster.toml"),
                   help="inventory file (default $TRASHCAN_CLUSTER or ./cluster.toml)")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("check")
    s = sub.add_parser("registry")
    s.add_argument("--push", action="store_true", help="compare with every node's /etc/tblink/nodes.tsv")
    s.add_argument("--apply", action="store_true", help="with --push: install where it differs")
    s = sub.add_parser("links")
    s.add_argument("--nodes")
    s = sub.add_parser("links-reload-all")
    s.add_argument("--yes", action="store_true")
    s.add_argument("--nodes")
    for name in ("preflight", "run", "smoke", "up"):
        s = sub.add_parser(name)
        s.add_argument("recipe")
        s.add_argument("--nodes", help="node names in role order (default: the first ones in the inventory)")
        s.add_argument("--mtp", action=argparse.BooleanOptionalAction, default=None, help="speculative decoding")
        s.add_argument("--tcp-fallback", action="store_true", help="use Ethernet where a Thunderbolt cable is missing")
        s.add_argument("--wrap", action="append", metavar="NODE=PREFIX",
                       help="run node commands under PREFIX (e.g. a scheduler), * for every node")
        s.add_argument("--env", action="append", metavar="K=V", help="environment for every engine process")
    s = sub.add_parser("install")
    s.add_argument("--nodes")
    s.add_argument("--apply", action="store_true")
    s.add_argument("--uninstall", action="store_true")
    s.add_argument("--skip", help="components to leave out, e.g. panic,ssh")
    s.add_argument("--registry", action="store_true", help="also install the generated tblink registry")
    s.add_argument("--lights", nargs="?", const="", metavar="ARGS",
                   help="also install the port lights (lights/install.sh ARGS, e.g. --build-module); docs/lights.md")
