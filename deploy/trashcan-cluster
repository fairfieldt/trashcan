#!/usr/bin/env python3
"""Set up, check, start and stop trashcan on one to six Mac Pros. See docs/deploy.md.

Runs on your workstation (Python 3.11+, ssh) against the nodes in an inventory file (deploy/cluster.example.toml).
Nothing here needs a particular build host, scheduler or network beyond SSH to every node.

  trashcan-cluster [-c INVENTORY] check                   inventory, recipes and manifest are consistent
  trashcan-cluster registry [--push [--apply]]            tblink node registry generated from the nodes
  trashcan-cluster install [--apply|--uninstall] [--nodes] node services (nodes/macpro/install.sh), preview first
  trashcan-cluster links                                  live Thunderbolt links against the cable map
  trashcan-cluster links-reload-all --yes                 reload Thunderbolt on every node at once (untested)
  trashcan-cluster preflight RECIPE [--nodes A,B,..]      read-only checks for a recipe (hashes artifacts once)
  trashcan-cluster run RECIPE                             start, wait until ready, stop on Ctrl-C or any failure
  trashcan-cluster smoke RECIPE                           start, send one request, check the answer, stop
  trashcan-cluster up RECIPE / down / status              start detached, stop, show the recorded run
  trashcan-cluster hash NODE PATH...                      sha256 of files on a node (for the manifest)

Recipes are in deploy/recipes.toml, pinned artifacts in deploy/manifest.toml.
"""
import argparse
import itertools
import json
import os
import shlex
import signal
import subprocess
import sys
import threading
import time
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
PROBE = HERE / "node-probe.py"
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=4"]


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def say(msg):
    print(msg, flush=True)


# ---------------------------------------------------------------------------------------------------------- config

class Node:
    def __init__(self, d):
        self.name = d["name"]
        self.ssh = d.get("ssh", self.name)
        self.index = int(d["index"])
        self.lan = d.get("lan", self.ssh)       # address other nodes use over Ethernet (TCP fallback only)
        self.hostname = d.get("hostname")       # filled from the node when needed
        self.home = None                         # filled by the probe

    def path(self, p):
        """p with a leading ~ replaced by the node's home directory (paths are quoted in commands)."""
        return self.home + p[1:] if self.home and (p == "~" or p.startswith("~/")) else p

    def __repr__(self):
        return self.name


class Config:
    def __init__(self, path):
        self.path = Path(path).resolve()
        with open(self.path, "rb") as f:
            raw = tomllib.load(f)
        c = raw.get("cluster", {})
        self.workspace = c.get("workspace", "~/trashcan")
        self.binary = c.get("binary", "target/release/trashcan")
        self.models = c.get("models", "~/models")
        self.run_dir = c.get("run_dir", "~/.local/state/trashcan-cluster")
        self.state = (self.path.parent / c.get("state", "cluster-state")).resolve()
        self.cpu_latency_us = c.get("cpu_latency_us", "none")
        self.ports = {"qwen4_node": 7071, "tp_node": 7072, "serve": 8000, **raw.get("ports", {})}
        self.nodes = [Node(n) for n in raw.get("node", [])]
        self.by_name = {n.name: n for n in self.nodes}
        self.cables = []
        for cab in raw.get("cable", []):
            a, b = cab["ends"]
            self.cables.append((parse_end(a), parse_end(b)))
        self.manifest = load_toml(self.path.parent / c["manifest"]) if "manifest" in c else load_toml(HERE / "manifest.toml")
        self.recipes = load_toml(self.path.parent / c["recipes"]) if "recipes" in c else load_toml(HERE / "recipes.toml")
        self.recipes = self.recipes.get("recipe", {})

    def remote(self, rel):
        """A path on the nodes: absolute, ~/..., or relative to the workspace."""
        if rel.startswith("/") or rel.startswith("~"):
            return rel
        return f"{self.workspace}/{rel}"

    def model_path(self, key):
        m = self.manifest["models"][key]
        p = m["path"]
        return p if p.startswith("/") or p.startswith("~") else f"{self.models}/{p}"


def parse_end(s):
    name, bus = s.rsplit(":", 1)
    return name, int(bus)


def load_toml(p):
    with open(p, "rb") as f:
        return tomllib.load(f)


def cmd_check(cfg, a):
    problems = []
    seen = set()
    for n in cfg.nodes:
        if n.index < 1 or n.index > 15:
            problems.append(f"node {n.name}: index must be 1..15 (tblink addresses use 16 * index)")
        if n.index in seen:
            problems.append(f"node {n.name}: index {n.index} used twice")
        seen.add(n.index)
    for (an, ab), (bn, bb) in cfg.cables:
        for name, bus in ((an, ab), (bn, bb)):
            if name not in cfg.by_name:
                problems.append(f"cable end {name}:{bus}: no such node")
            if bus not in (0, 1, 2):
                problems.append(f"cable end {name}:{bus}: bus must be 0, 1 or 2")
    used = {}
    for end in [e for c in cfg.cables for e in c]:
        if end in used:
            problems.append(f"cable end {end[0]}:{end[1]} used by two cables")
        used[end] = True
    for key, r in cfg.recipes.items():
        for m in r.get("models", []) + r.get("mtp_models", []):
            if m not in cfg.manifest.get("models", {}):
                problems.append(f"recipe {key}: model {m} not in the manifest")
        if r["macs"] > len(cfg.nodes):
            say(f"note: recipe {key} needs {r['macs']} nodes, the inventory has {len(cfg.nodes)}")
    for key, m in cfg.manifest.get("models", {}).items():
        if not m.get("sha256"):
            problems.append(f"manifest: model {key} has no sha256")
    for p in problems:
        print(f"problem: {p}")
    say(f"{len(cfg.nodes)} nodes, {len(cfg.cables)} cables, {len(cfg.recipes)} recipes, "
        f"{len(cfg.manifest.get('models', {}))} models: {'OK' if not problems else f'{len(problems)} problems'}")
    return 1 if problems else 0


# ------------------------------------------------------------------------------------------------------------ ssh

def ssh_argv(node, command):
    return ["ssh", *SSH_OPTS, node.ssh, command]


def ssh(node, command, check=True, timeout=120, input=None):
    r = subprocess.run(ssh_argv(node, command), capture_output=True, text=True, timeout=timeout, input=input)
    if check and r.returncode != 0:
        raise RuntimeError(f"{node.name}: `{command[:80]}` exited {r.returncode}: {r.stderr.strip()[-400:]}")
    return r


def parallel(nodes, fn):
    """fn(node) on every node at once; returns {name: result or exception}."""
    out = {}

    def run(n):
        try:
            out[n.name] = fn(n)
        except Exception as e:  # noqa: BLE001 - reported per node
            out[n.name] = e

    threads = [threading.Thread(target=run, args=(n,)) for n in nodes]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return out


def probe(cfg, node, files=(), hash_files=False, ports=(), binary=True):
    req = {"files": list(files), "hash": hash_files, "ports": list(ports),
           "binary": cfg.remote(cfg.binary) if binary else None, "workspace": cfg.workspace,
           "run_dir": cfg.run_dir}
    r = subprocess.run(["ssh", *SSH_OPTS, node.ssh, "python3", "-", shlex.quote(json.dumps(req))],
                       input=PROBE.read_text(), capture_output=True, text=True, timeout=3600)
    if r.returncode != 0:
        raise RuntimeError(f"{node.name}: probe failed: {r.stderr.strip()[-600:]}")
    info = json.loads(r.stdout)
    node.hostname = info["hostname"]
    node.home = info["home"]
    return info


# ------------------------------------------------------------------------------------------------------- registry

NHIS = ["0000:16:00.0", "0000:5d:00.0", "0000:a4:00.0"]  # Apple bus 0 (bottom row), 1 (left column), 2 (right column)


def cmd_registry(cfg, a):
    """Read every node's Thunderbolt controller UUIDs and write the tblink registry (index, hostname, bus 0-2 UUIDs)."""
    read = ("for n in " + " ".join(NHIS) + "; do d=$(ls -d /sys/bus/pci/devices/$n/domain* 2>/dev/null | head -1); "
            "cat /sys/bus/thunderbolt/devices/${d##*domain}-0/unique_id 2>/dev/null || echo -; done; hostname")
    res = parallel(cfg.nodes, lambda n: ssh(n, read).stdout.split())
    lines = ["# trashcan nodes for tblink, generated by deploy/trashcan-cluster registry from the nodes themselves.",
             "# index, hostname, and the UUID of each Thunderbolt controller by Apple bus (0 = NHI 16:00.0, bottom row;",
             "# 1 = 5d:00.0, left column; 2 = a4:00.0, right column). Indexes come from the inventory and never change."]
    bad = False
    for n in sorted(cfg.nodes, key=lambda n: n.index):
        v = res[n.name]
        if isinstance(v, Exception) or len(v) != 4 or "-" in v[:3]:
            print(f"{n.name}: cannot read three controller UUIDs: {v}", file=sys.stderr)
            bad = True
            continue
        lines.append("\t".join([str(n.index), v[3], *v[:3]]))
    if bad:
        return 1
    text = "\n".join(lines) + "\n"
    cfg.state.mkdir(parents=True, exist_ok=True)
    out = cfg.state / "nodes.tsv"
    out.write_text(text)
    say(f"wrote {out}")
    if not a.push:
        return 0
    # Compare with every node's installed table; install only with --apply.
    current = parallel(cfg.nodes, lambda n: ssh(n, "cat /etc/tblink/nodes.tsv 2>/dev/null", check=False).stdout)
    changed = []
    for n in cfg.nodes:
        if _rows(current[n.name]) == _rows(text):
            say(f"{n.name}: /etc/tblink/nodes.tsv already has these nodes")
        else:
            changed.append(n)
            say(f"{n.name}: /etc/tblink/nodes.tsv differs:" + "".join(
                f"\n    - {r}" for r in sorted(_rows(current[n.name]) - _rows(text))) + "".join(
                f"\n    + {r}" for r in sorted(_rows(text) - _rows(current[n.name]))))
    if changed and a.apply:
        res = parallel(changed, lambda n: ssh(n, "sudo -n install -D -m 0644 /dev/stdin /etc/tblink/nodes.tsv", input=text))
        for name, v in res.items():
            say(f"{name}: {'installed' if not isinstance(v, Exception) else v}")
        say("tblink picks the table up within 5 s; links are not reset")
    elif changed:
        say("preview only: rerun with --apply to install")
    return 0


def _rows(text):
    return {"\t".join(line.split()) for line in text.splitlines() if line.strip() and not line.startswith("#")}


# ---------------------------------------------------------------------------------------------------------- links

def read_links(cfg, nodes):
    """{node name: [link dict]} from `tblink links`, and every node's hostname."""
    def one(n):
        r = ssh(n, "hostname; /usr/local/sbin/tblink links 2>/dev/null || sudo -n /usr/local/sbin/tblink links", check=False)
        lines = r.stdout.splitlines()
        n.hostname = lines[0].strip()
        hdr = lines[1].split("\t") if len(lines) > 1 else []
        return [dict(zip(hdr, line.split("\t"))) for line in lines[2:] if line.strip()]
    res = parallel(nodes, one)
    for name, v in res.items():
        if isinstance(v, Exception):
            die(f"{name}: {v}")
    return res


def cable_report(cfg, nodes, links):
    """Compare the live links with the cable map; returns (ok, lines, live) where live[(a, b)] lists (a bus, b bus, link)."""
    by_host = {n.hostname: n.name for n in nodes}
    live = {}
    lines = []
    for n in nodes:
        for l in links[n.name]:
            peer = by_host.get(l.get("peer"))
            if peer is None:
                continue
            live.setdefault((n.name, peer), []).append((int(l["local_bus"]), int(l["peer_bus"]), l))
    names = {n.name for n in nodes}
    ok = True
    expected = set()
    for (an, ab), (bn, bb) in cfg.cables:
        if an not in names or bn not in names:
            continue
        expected.add((an, ab))
        expected.add((bn, bb))
        hit = [l for (lb, pb, l) in live.get((an, bn), []) if lb == ab and pb == bb]
        if not hit:
            lines.append(f"MISSING  {an}:{ab} - {bn}:{bb}: no link seen")
            ok = False
            continue
        l = hit[0]
        state, lanes, stream = l.get("state"), l.get("lanes"), l.get("stream", "-")
        flag = "OK      " if state == "up" and lanes == "2" and stream != "-" else "DEGRADED" if state == "up" else "DOWN    "
        if state != "up":
            ok = False
        lines.append(f"{flag} {an}:{ab} - {bn}:{bb}: {state}, {lanes} lane(s), stream {stream}")
    for (a_, b_), ls in sorted(live.items()):
        for lb, pb, l in ls:
            if (a_, lb) not in expected and a_ < b_:
                lines.append(f"EXTRA    {a_}:{lb} - {b_}:{pb}: {l.get('state')} (not in the cable map)")
    return ok, lines, live


def cmd_links(cfg, a):
    nodes = select_nodes(cfg, a.nodes, len(a.nodes.split(","))) if a.nodes else cfg.nodes
    links = read_links(cfg, nodes)
    for n in nodes:
        for l in links[n.name]:
            if l.get("state") in ("firmware", "no_carrier", "no_interface"):
                say(f"{n.name}: {l.get('xdomain')} bus {l.get('local_bus')} -> {l.get('peer')}: {l.get('state')}")
    ok, lines, _ = cable_report(cfg, nodes, links)
    for line in lines:
        say(line)
    if not ok:
        say("some cables are not up: see docs/deploy.md#thunderbolt-link-recovery")
    return 0 if ok else 1


def cmd_reload_all(cfg, a):
    """`tblink reload` on every node at the same moment. UNTESTED as a recovery procedure (docs/deploy.md)."""
    if not a.yes:
        die("this reloads the Thunderbolt modules on every node at once and drops every link for a few seconds; "
            "rerun with --yes when no engine runs anywhere")
    nodes = select_nodes(cfg, a.nodes, len(a.nodes.split(","))) if a.nodes else cfg.nodes
    busy = parallel(nodes, lambda n: ssh(n, ENGINE_PGREP, check=False).stdout.strip())
    if any(v for v in busy.values() if not isinstance(v, Exception)):
        die("an engine process is running: " + "; ".join(f"{k}: {v}" for k, v in busy.items() if v))
    barrier = time.time() + 5
    cmd = f"sleep $(python3 -c 'import time; print(max(0, {barrier} - time.time()))'); sudo -n /usr/local/sbin/tblink reload"
    res = parallel(nodes, lambda n: ssh(n, cmd, check=False))
    for name, r in res.items():
        say(f"{name}: {'reloaded' if not isinstance(r, Exception) and r.returncode == 0 else 'FAILED ' + str(getattr(r, 'stderr', r)).strip()}")
    say("waiting 30 s for the links to come back")
    time.sleep(30)
    return cmd_links(cfg, a)


# -------------------------------------------------------------------------------------------------------- recipes

ENGINE_PGREP = r"pgrep -af '(^|/)trashcan[^ /]* (serve|server|chat|bench|validate|qwen|qwen4|qwen-[a-z-]+) ' || true"


def select_nodes(cfg, names, count):
    if names:
        sel = []
        for name in names.split(","):
            if name not in cfg.by_name:
                die(f"no node {name} in {cfg.path}")
            sel.append(cfg.by_name[name])
    else:
        sel = cfg.nodes[:count]
    if len(sel) != count:
        die(f"need {count} nodes, got {len(sel)}")
    return sel


class Proc:
    """One engine process on a node."""

    def __init__(self, role, node, argv, port, kind):
        self.role, self.node, self.argv, self.port, self.kind = role, node, argv, port, kind
        self.ssh = None  # attached ssh process

    def as_dict(self, run):
        return {"role": self.role, "node": self.node.name, "port": self.port, "kind": self.kind,
                "pidfile": f"{run}/{self.role}.pid", "log": f"{run}/{self.role}.log", "argv": self.argv}


def addr(host, bus, port):
    return f"{host}.tb{bus}:{port}"


def plan(cfg, recipe, nodes, a):
    """The processes for a recipe on these nodes, in start order (nodes first, the driver last)."""
    r = cfg.recipes[recipe]
    models = {k: cfg.model_path(k) for k in r.get("models", []) + r.get("mtp_models", [])}
    mtp = a.mtp if a.mtp is not None else r.get("mtp_default", False)

    def fmt(args):
        out = []
        for x in args:
            for k, v in models.items():
                x = x.replace("{" + k + "}", v)
            out.append(x.replace("{serve_port}", str(cfg.ports["serve"])))
        return out

    driver_args = fmt(r["driver"] + (r.get("driver_mtp", []) if mtp else []))
    node_extra = fmt(r.get("node_mtp", [])) if mtp else []
    kind = r["kind"]
    procs = []
    if kind == "single":
        pass
    elif kind in ("tp2", "tp4"):
        links = read_links(cfg, nodes)
        ok, lines, live = cable_report(cfg, nodes, links)
        port = cfg.ports["tp_node"]
        if kind == "tp2":
            d, n1 = nodes
            lanes = [addr(n1.hostname, lb, port) for lb, pb, l in sorted(live.get((d.name, n1.name), []), key=lambda t: t[0])
                     if l.get("state") == "up"]
            if not lanes:
                if not a.tcp_fallback:
                    die(f"no Thunderbolt link up between {d.name} and {n1.name}; fix the cable or pass --tcp-fallback")
                lanes = [f"{n1.lan}:{port}"]
                say(f"TCP fallback: {d.name} -> {n1.name} over {n1.lan}")
            procs.append(Proc("node1", n1, fmt(r["node"]) + node_extra + ["--listen", f"0.0.0.0:{port}"], port, "tp"))
            driver_args += ["--tp-connect", ",".join(lanes)]
        else:
            order, cabled = tp4_order(nodes, live, a.tcp_fallback)
            m = {i: n for i, n in enumerate(order)}

            def lanes(i, j):
                ls = [addr(m[j].hostname, lb, port) for lb, pb, l in sorted(live.get((m[i].name, m[j].name), []), key=lambda t: t[0])
                      if l.get("state") == "up"]
                return ls or [f"{m[j].lan}:{port}"]
            for i in (3, 2, 1):
                peers = []
                for j in sorted(cabled[i]):
                    peers += ["--peer", f"{j}={','.join(lanes(i, j))}" if j > i else str(j)]
                procs.append(Proc(f"machine{i}", m[i], fmt(r["node"]) + node_extra +
                                  ["--listen", f"0.0.0.0:{port}", "--machine", str(i), *peers], port, "tp"))
            for j in sorted(cabled[0]):
                driver_args += ["--tp-peer", f"{j}={','.join(lanes(0, j))}"]
            nodes[:] = order
    elif kind == "chain":
        links = read_links(cfg, nodes)
        ok, lines, live = cable_report(cfg, nodes, links)
        order = chain_order(nodes, live)
        port = cfg.ports["qwen4_node"]
        addrs = []
        for prev, n in zip(order, order[1:]):
            ls = [l for l in live.get((prev.name, n.name), []) if l[2].get("state") == "up"]
            if ls:
                addrs.append(addr(n.hostname, sorted(ls, key=lambda t: t[0])[0][0], port))
            elif a.tcp_fallback:
                addrs.append(f"{n.lan}:{port}")
                say(f"TCP fallback: {prev.name} -> {n.name} over {n.lan}")
            else:
                die(f"no Thunderbolt link up between {prev.name} and {n.name}")
        for i, n in reversed(list(enumerate(order))[1:]):
            procs.append(Proc(f"stage{i}", n, fmt(r["node"]) + ["--listen", f"0.0.0.0:{port}"], port, "chain"))
        driver_args += ["--nodes", ",".join(addrs)]
        nodes[:] = order
    else:
        die(f"recipe {recipe}: unknown kind {kind}")
    procs.append(Proc("driver", nodes[0], driver_args, cfg.ports["serve"], "serve"))
    return procs


def tp4_order(nodes, live, tcp_fallback):
    """Machine numbers 0-3 (nodes[0] stays machine 0) so that the cables 0-1, 0-2, 1-3 and 2-3 exist (the ring), or
    all six (full mesh). Returns (order, {machine: set of cabled machines})."""
    def up(x, y):
        return any(l.get("state") == "up" for _, _, l in live.get((x.name, y.name), []))
    ring = [(0, 1), (0, 2), (1, 3), (2, 3)]
    d, rest = nodes[0], nodes[1:]
    if all(up(x, y) for x, y in itertools.combinations(nodes, 2)):
        order = nodes
        pairs = list(itertools.combinations(range(4), 2))
    else:
        order = None
        for perm in itertools.permutations(rest):
            o = [d, *perm]
            if all(up(o[i], o[j]) for i, j in ring):
                order = o
                break
        if order is None:
            if not tcp_fallback:
                die("these four nodes have no Thunderbolt ring 0-1, 0-2, 1-3, 2-3 (see `links`); recable or pass --tcp-fallback")
            # The order given, Ethernet where a ring cable is missing.
            order = nodes
            for i, j in ring:
                if not up(order[i], order[j]):
                    say(f"TCP fallback: machine {i} ({order[i].name}) - machine {j} ({order[j].name}) over Ethernet")
        pairs = ring
    cabled = {i: set() for i in range(4)}
    for i, j in pairs:
        cabled[i].add(j)
        cabled[j].add(i)
    return order, cabled


def chain_order(nodes, live):
    """The pipeline order: the nodes as given if every neighbour pair is cabled, else the ring followed from the
    driver."""
    def up(x, y):
        return any(l.get("state") == "up" for _, _, l in live.get((x.name, y.name), []))
    if all(up(x, y) for x, y in zip(nodes, nodes[1:])):
        return list(nodes)
    order, prev = [nodes[0]], None
    names = {n.name: n for n in nodes}
    while len(order) < len(nodes):
        here = order[-1]
        nxt = sorted([(lb, p) for (x, p), ls in live.items() if x == here.name and p in names and names[p] not in order
                      for lb, _, l in ls if l.get("state") == "up"])
        if not nxt:
            return list(nodes)  # broken ring: keep the given order; the caller reports the missing link
        order.append(names[nxt[0][1]])
    return order


# ------------------------------------------------------------------------------------------------------ preflight

def required_files(cfg, recipe, procs, mtp):
    r = cfg.recipes[recipe]
    per = {}
    for p in procs:
        keys = list(r.get("models", []))
        if mtp and (p.role == "driver" or r.get("node_mtp")):
            keys += r.get("mtp_models", [])
        for k in keys:
            per.setdefault(p.node.name, {})[k] = cfg.model_path(k)
    return per


def preflight(cfg, recipe, a, quiet=False):
    """Every check before a launch. Returns (ok, procs, nodes)."""
    if recipe not in cfg.recipes:
        die(f"no recipe {recipe}; recipes: {', '.join(cfg.recipes)}")
    r = cfg.recipes[recipe]
    nodes = select_nodes(cfg, a.nodes, r["macs"])
    procs = plan(cfg, recipe, nodes, a)
    mtp = a.mtp if a.mtp is not None else r.get("mtp_default", False)
    files = required_files(cfg, recipe, procs, mtp)
    ports = {}
    for p in procs:
        ports.setdefault(p.node.name, []).append(p.port)
    say(f"preflight {recipe} on {', '.join(n.name for n in nodes)} (model files are hashed once per node and cached; "
        "the first time takes minutes)")
    infos = parallel(nodes, lambda n: probe(cfg, n, files.get(n.name, {}).values(), True, ports.get(n.name, [])))
    man = cfg.manifest
    problems, warnings = [], []
    accepted = man["kernel"].get("accepted", {})
    bin_hashes = {}
    for n in nodes:
        i = infos[n.name]
        if isinstance(i, Exception):
            problems.append(str(i))
            continue
        pre = f"{n.name}:"
        # kernel
        rel = i["kernel"]
        ks = accepted.get(rel)
        if ks is None:
            pid = i.get("kernel_patchset")
            match = [k for k, v in man["kernel"].get("patchsets", {}).items() if v.get("id") == pid]
            if match:
                ks = {"patchset": match[0], "status": man["kernel"]["patchsets"][match[0]].get("status", "")}
        if ks is None:
            problems.append(f"{pre} kernel {rel} is not a kernel built from kernel/ (see docs/kernel.md)")
        elif ks.get("status") != "qualified":
            warnings.append(f"{pre} kernel {rel} ({ks.get('patchset')}) is {ks.get('status') or 'not qualified'}")
        if i.get("boot_config_sha256") and i["boot_config_sha256"] != man["kernel"]["config_sha256_normalized"]:
            warnings.append(f"{pre} /boot/config-{rel} differs from kernel/configs (ignoring LOCALVERSION)")
        for p in ("amdgpu.si_support=1", "radeon.si_support=0"):
            if p not in i["cmdline"].split():
                problems.append(f"{pre} kernel command line lacks {p}")
        if not i["p2pdma"]:
            problems.append(f"{pre} kernel without CONFIG_PCI_P2PDMA")
        # GPUs
        gpus = i["gpus"]
        vb = sorted(g["vbios"] for g in gpus)
        if len(gpus) != 2:
            problems.append(f"{pre} {len(gpus)} amdgpu GPUs (want 2)")
        elif vb != sorted(man["hardware"]["vbios"]):
            problems.append(f"{pre} VBIOS {vb} (want {sorted(man['hardware']['vbios'])}: each card its own; see docs/hardware.md)")
        for g in gpus:
            if g["vram_total_mib"] < man["hardware"]["vram_mib_min"]:
                problems.append(f"{pre} GPU {g['pci']} has {g['vram_total_mib']} MiB VRAM")
            if g["vram_used_mib"] > 512:
                problems.append(f"{pre} GPU {g['pci']} has {g['vram_used_mib']} MiB VRAM in use: something else runs on it")
            if g["dpm"] != "auto":
                warnings.append(f"{pre} GPU {g['pci']} DPM level is {g['dpm']} (a stopped engine left it; the launcher "
                                "restores auto when it stops)")
        if not i["in_render"]:
            problems.append(f"{pre} {i['user']} is not in the render group (nodes/macpro/install.sh)")
        # Mesa
        want = man["mesa"]["version"]
        if i["mesa"] != want:
            msg = f"{pre} Mesa {i['mesa']}, the qualified version is {want}"
            (problems if r.get("mesa_strict") else warnings).append(
                msg + (": Flash-Next relies on its barrier behaviour (docs/qwen4.md); rerun the ISA audit first"
                       if r.get("mesa_strict") else ""))
        # services
        for s in ("fancurve", "tblink"):
            if i["services"].get(s) != "active":
                (problems if s == "fancurve" else warnings).append(f"{pre} {s}.service is {i['services'].get(s)}")
        if not i["configfs"]:
            warnings.append(f"{pre} configfs not mounted: no USB4STREAM, links run over TCP")
        # engine processes and ports
        if i["engines"]:
            problems.append(f"{pre} an engine process is running: {i['engines'][0]}")
        for port in i["busy_ports"]:
            problems.append(f"{pre} port {port} is in use")
        # binary
        b = i.get("binary")
        if not b or not b.get("sha256"):
            problems.append(f"{pre} no engine binary at {cfg.remote(cfg.binary)}")
        else:
            bin_hashes[n.name] = b["sha256"]
        # models
        for key, path in files.get(n.name, {}).items():
            f = i["files"].get(path)
            m = man["models"][key]
            if not f or not f.get("exists"):
                problems.append(f"{pre} missing {path} ({key})")
            elif f["size"] != m["size"]:
                problems.append(f"{pre} {path}: {f['size']} bytes, want {m['size']}")
            elif f.get("sha256") != m["sha256"]:
                problems.append(f"{pre} {path}: sha256 {f.get('sha256', '?')[:16]}..., want {m['sha256'][:16]}...")
    if len(set(bin_hashes.values())) > 1:
        problems.append("engine binaries differ between nodes: " + ", ".join(f"{k} {v[:12]}" for k, v in bin_hashes.items()))
    pin = man.get("engine", {}).get("binary_sha256")
    if pin and bin_hashes and set(bin_hashes.values()) != {pin}:
        problems.append(f"engine binary is not the pinned {pin[:12]} ({sorted(set(v[:12] for v in bin_hashes.values()))})")
    # links
    if r["kind"] != "single":
        links = read_links(cfg, nodes)
        ok, lines, live = cable_report(cfg, nodes, links)
        for line in lines:
            if not line.startswith("OK"):
                warnings.append("link " + line)
    if not quiet or problems or warnings:
        for n in nodes:
            i = infos[n.name]
            if isinstance(i, Exception):
                continue
            g = ", ".join(f"{x['pci']} {x['vbios']} {x['vram_total_mib']} MiB" for x in i["gpus"])
            say(f"  {n.name} ({i['hostname']}): {i['kernel']}, Mesa {i['mesa']}, {g}, engine "
                f"{(i.get('binary') or {}).get('sha256', '-')[:12]}")
        for p in procs:
            say(f"  {p.role:9s} on {p.node.name}: trashcan {shlex.join(p.argv)}")
        for w in warnings:
            say(f"warning: {w}")
        for p in problems:
            say(f"PROBLEM: {p}")
    say(f"preflight {recipe}: {'OK' if not problems else 'FAILED'} ({len(problems)} problems, {len(warnings)} warnings)")
    return not problems, procs, nodes


def cmd_preflight(cfg, a):
    ok, _, _ = preflight(cfg, a.recipe, a)
    return 0 if ok else 1


